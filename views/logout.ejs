<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Đăng xuất - EduManager</title>
    <!-- Tailwind CSS & Lucide Icons -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <script src="/public/lucide-safe.js"></script>
    <link rel="stylesheet" href="/public/style.css">
</head>

<body class="min-h-screen bg-[#f5f5f7] flex items-center justify-center p-6 antialiased selection:bg-[#0071e3] selection:text-white">
    <div class="glass-card w-full max-w-sm rounded-[36px] p-8 border border-black/[0.06] text-center space-y-4 shadow-[0_12px_40px_rgba(0,0,0,0.04)]">
        <div class="w-14 h-14 bg-[#0071e3]/10 rounded-full flex items-center justify-center mx-auto text-[#0071e3]">
            <i data-lucide="loader-2" class="w-6 h-6 animate-spin"></i>
        </div>
        <p id="logout-state" class="text-xs font-medium text-[#86868b]">Đang thực hiện đăng xuất...</p>
    </div>

    <script type="module">
        import { logout } from "/public/clientAuth.js";

        if (window.lucide) window.lucide.createIcons();

        const logoutStateText = document.getElementById("logout-state");
        await logout();

        logoutStateText.innerText = "Đã đăng xuất thành công!";

        setTimeout(() => {
            window.location.href = "/";
        }, 600);
    </script>
</body>

</html>