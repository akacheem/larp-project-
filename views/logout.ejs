<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Logout Page</title>
</head>

<body>
    <p id="logout-state">Logging out...</p>
    <script type="module">
        import { logout } from "/public/clientAuth.js";

        const logoutSateText = document.getElementById("logout-state");
        await logout();

        logoutSateText.innerText = "Logged out!";

        setTimeout(() => {
            window.location.href = "/";
        }, 500);
    </script>
</body>

</html>