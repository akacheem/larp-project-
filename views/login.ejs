<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Đăng nhập - EduManager</title>
    <!-- Tailwind CSS & Icons -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/public/style.css">
</head>

<body class="min-h-screen flex items-center justify-center p-6">
    <div class="glass-card w-full max-w-md rounded-2xl p-8 border border-slate-800 space-y-6 shadow-2xl">
        <!-- Logo & Title -->
        <div class="text-center space-y-2">
            <div class="w-12 h-12 rounded-xl gradient-bg flex items-center justify-center text-white mx-auto shadow-lg shadow-sky-500/20 text-xl font-bold">
                <i class="fa-solid fa-right-to-bracket"></i>
            </div>
            <h2 class="text-2xl font-bold gradient-text">Đăng nhập EduManager</h2>
            <p class="text-xs text-slate-400">Nhập thông tin tài khoản của bạn để tiếp tục</p>
        </div>

        <!-- Form -->
        <form class="space-y-4" onsubmit="return false;">
            <div>
                <label for="email" class="block text-xs font-semibold text-slate-300 mb-1.5">Địa chỉ Email</label>
                <div class="relative">
                    <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-slate-500 text-sm">
                        <i class="fa-solid fa-envelope"></i>
                    </span>
                    <input type="email" id="email" name="email" required placeholder="yourname@example.com" class="w-full pl-10 pr-4 py-2.5 bg-slate-900 border border-slate-700 rounded-xl text-slate-200 text-sm focus:outline-none focus:border-sky-500 transition">
                </div>
            </div>

            <div>
                <label for="password" class="block text-xs font-semibold text-slate-300 mb-1.5">Mật khẩu</label>
                <div class="relative">
                    <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-slate-500 text-sm">
                        <i class="fa-solid fa-lock"></i>
                    </span>
                    <input type="password" id="password" name="password" required minlength="8" placeholder="Tối thiểu 8 ký tự" class="w-full pl-10 pr-4 py-2.5 bg-slate-900 border border-slate-700 rounded-xl text-slate-200 text-sm focus:outline-none focus:border-sky-500 transition">
                </div>
            </div>

            <!-- Status Text Message -->
            <div class="text-center pt-1">
                <span id="status-text" class="text-xs font-semibold text-amber-400"></span>
            </div>

            <button id="submit-btn" type="submit" class="w-full py-3 gradient-bg hover:opacity-90 text-white font-semibold rounded-xl text-sm transition shadow-lg shadow-sky-600/30 flex items-center justify-center space-x-2">
                <span>Đăng nhập</span>
                <i class="fa-solid fa-arrow-right"></i>
            </button>
        </form>

        <!-- Footer link -->
        <div class="text-center pt-4 border-t border-slate-800 text-xs text-slate-400">
            Chưa có tài khoản?
            <a href="/signup" class="text-sky-400 hover:text-sky-300 font-semibold ml-1 transition">Đăng ký ngay</a>
        </div>
    </div>

    <script src="/public/login.js" type="module"></script>
</body>

</html>