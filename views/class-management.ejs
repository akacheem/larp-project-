                                    <span class="text-[#15803d] font-medium bg-[#34c759]/10 px-1.5 py-0.2 rounded-full border border-[#34c759]/20 truncate max-w-[45%] text-[10px]">{{ d.newValue }}</span>
                                </div>
                            </div>
