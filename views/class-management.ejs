                    showToast('Đã xuất danh sách học sinh (kẻ bảng & cân lề chuẩn Excel) thành công!');
                }

                // Gemini Chatbot Integration
                function onAiFileSelected(event) {
                    const file = event.target.files[0];
                    if (!file) return;
                    if (file.size > 5 * 1024 * 1024) {
                        showToast('Dung lượng file quá lớn (tối đa 5MB)', 'error');
                        event.target.value = '';
                        return;
                    }
                    aiAttachedFile.value = file;
                }

                function removeAiFile() {
                    aiAttachedFile.value = null;
                }

                function readFileAsBase64(file) {
                    return new Promise((resolve, reject) => {
                        const reader = new FileReader();
                        reader.onload = () => resolve(reader.result.split(',')[1]);
                        reader.onerror = error => reject(error);
                        reader.readAsDataURL(file);
                    });
                }

                async function sendChatMessage() {
                    const promptText = aiPrompt.value.trim();
                    if (!promptText && !aiAttachedFile.value) return;

                    let fileData = null;
                    if (aiAttachedFile.value) {
                        const base64Data = await readFileAsBase64(aiAttachedFile.value);
                        fileData = {
                            mimeType: aiAttachedFile.value.type,
                            data: base64Data
                        };
                    }

                    chatMessages.value.push({ 
                        role: 'user', 
                        text: promptText,
                        fileName: aiAttachedFile.value ? aiAttachedFile.value.name : null
                    });

                    aiPrompt.value = '';
                    aiAttachedFile.value = null;
                    parsingAi.value = true;

                    try {
                        const headers = { ...getTokenHeader(), 'Content-Type': 'application/json' };
                        const res = await fetch('/api/ai/parse-intent', {
                            method: 'POST',
                            headers,
                            body: JSON.stringify({ prompt: promptText, classId: getClassIdFromUrl(), fileData })
                        });

                        const data = await res.json();
                        if (res.ok) {
                            if (data.debugMode !== undefined) debugMode.value = Boolean(data.debugMode);
                            isGeminiPowered.value = Boolean(data.isGeminiPowered);
                            const hasCode = Boolean(data.code && data.code.trim());
                            const hasActions = (Array.isArray(data.actions) && data.actions.length > 0) || hasCode;

                            chatMessages.value.push({
                                role: 'assistant',
                                text: data.reply || data.summary || 'Đã phân tích yêu cầu của bạn.',
                                thought: data.thought || null,
                                hasActions,
                                actionsCount: (data.actions && data.actions.length) || (hasCode ? 1 : 0),
                                plan: { ...data, prompt: promptText }
                            });

                            if (hasActions) {
                                proposedPlan.value = { ...data, prompt: promptText };
                                showAiPreviewModal.value = true;
                            }
                        } else {
                            chatMessages.value.push({
                                role: 'assistant',
                                text: data.message || 'Lỗi xử lý câu lệnh AI.'
                            });
                        }
                    } catch (e) {
                        chatMessages.value.push({
                            role: 'assistant',
                            text: 'Lỗi kết nối tới máy chủ Gemini AI.'
                        });
                    } finally {
                        parsingAi.value = false;
                    }
                }

                function openPreviewFromChat(msg) {
                    if (msg.plan) {
                        proposedPlan.value = msg.plan;
                        showAiPreviewModal.value = true;
                    }
                }

                async function confirmExecuteServerPlan() {
                    const hasActions = (proposedPlan.value.actions && proposedPlan.value.actions.length > 0);
                    const hasCode = Boolean(proposedPlan.value.code && proposedPlan.value.code.trim());
                    if (!hasActions && !hasCode) return;

                    executingAi.value = true;
                    try {
                        const headers = { ...getTokenHeader(), 'Content-Type': 'application/json' };
                        const res = await fetch('/api/ai/execute-plan', {
                            method: 'POST',
                            headers,
                            body: JSON.stringify({
                                planActions: proposedPlan.value.actions || [],
                                code: proposedPlan.value.code || null,
                                prompt: proposedPlan.value.prompt || '',
                                classId: getClassIdFromUrl()
                            })
                        });

                        const data = await res.json();
                        if (res.ok) {
                            showToast('Server AI đã thực thi kịch bản thành công!');
                            showAiPreviewModal.value = false;

                            // Reflect Agent feedback and sandbox execution output in chat
                            chatMessages.value.push({
                                role: 'assistant',
                                text: data.agentReply || 'Đã hoàn tất thực thi kịch bản trên máy chủ.',
                                thought: data.agentThought || null,
                                executionLogs: data.logs && data.logs.length ? data.logs : null,
                                hasActions: false
                            });

                            await fetchStudents();
                        } else {
                            showToast(data.message || 'Server thực thi kịch bản thất bại', 'error');
                        }
                    } catch (e) {
                        showToast('Lỗi kết nối máy chủ AI', 'error');
                    } finally {
                        executingAi.value = false;
                    }
                }

                // Monthly Conduct Summary & Evaluation
                const showMonthlySummaryModal = ref(false);
                const showCloseConfirmModal = ref(false);
                const loadingMonthlySummary = ref(false);
                const closingMonthlyConduct = ref(false);
                const selectedSummaryMonth = ref((new Date()).getMonth() + 1);
                const selectedSummaryYear = ref((new Date()).getFullYear());
                const closedPeriodsList = ref([]);
                const selectedPeriodKey = ref('current');
                const customCloseTitle = ref('');
                const editingSummaryItem = ref(null);
                const savingSummaryItem = ref(false);

                const isOrganizationAccountUser = computed(() => {
                    return Boolean(user.value?.isOrganizationAccount || userPermission.value.isOwner);
                });

                const monthlyData = ref({
                    isClosed: false,
                    month: (new Date()).getMonth() + 1,
                    year: (new Date()).getFullYear(),
                    monthLabel: '',
                    closedInfo: null,
                    stats: { total: 0, tot: 0, kha: 0, dat: 0, chuaDat: 0 },
                    summaries: []
                });

                async function fetchClosedPeriodsList() {
                    try {
                        const headers = getTokenHeader();
                        const classId = getClassIdFromUrl();
                        const res = await fetch(`/api/organization/classes/${classId}/monthly-summaries/list`, { headers });
                        if (res.ok) {
                            const data = await res.json();
                            closedPeriodsList.value = data.periods || [];
                        }
                    } catch (e) {
                        console.error('Lỗi khi tải danh sách các kỳ đã chốt', e);
                    }
                }

                async function openMonthlySummaryModal() {
                    showMonthlySummaryModal.value = true;
                    editingSummaryItem.value = null;
                    customCloseTitle.value = '';
                    await fetchClosedPeriodsList();
                    await fetchMonthlySummary();
                }

                function onSelectPeriodKey() {
                    if (selectedPeriodKey.value === 'current') {
                        const now = new Date();
                        selectedSummaryMonth.value = now.getMonth() + 1;
                        selectedSummaryYear.value = now.getFullYear();
                    } else {
                        const [y, m] = selectedPeriodKey.value.split('-').map(Number);
                        selectedSummaryYear.value = y;
                        selectedSummaryMonth.value = m;
                    }
                    editingSummaryItem.value = null;
                    fetchMonthlySummary();
                }

                function onManualMonthYearChange() {
                    const match = closedPeriodsList.value.find(p => p.month === selectedSummaryMonth.value && p.year === selectedSummaryYear.value);
                    if (match) {
                        selectedPeriodKey.value = `${match.year}-${match.month}`;
                    } else {
                        selectedPeriodKey.value = 'current';
                    }
                    editingSummaryItem.value = null;
                    fetchMonthlySummary();
                }

                async function fetchMonthlySummary() {
                    loadingMonthlySummary.value = true;
                    editingSummaryItem.value = null;
                    try {
                        const headers = getTokenHeader();
                        const classId = getClassIdFromUrl();
                        const res = await fetch(`/api/organization/classes/${classId}/monthly-summaries?month=${selectedSummaryMonth.value}&year=${selectedSummaryYear.value}`, { headers });
                        if (res.ok) {
                            const data = await res.json();
                            monthlyData.value = data;
                        } else {
                            const err = await res.json();
                            showToast(err.message || 'Không thể tải tổng kết tháng', 'error');
                        }
                    } catch (e) {
                        showToast('Lỗi kết nối máy chủ', 'error');
                    } finally {
                        loadingMonthlySummary.value = false;
                        setTimeout(() => { if (window.renderLucideSafe) window.renderLucideSafe(); }, 50);
                    }
                }

                async function confirmCloseMonthlyConduct() {
                    closingMonthlyConduct.value = true;
                    try {
                        const headers = { ...getTokenHeader(), 'Content-Type': 'application/json' };
                        const classId = getClassIdFromUrl();
                        const res = await fetch(`/api/organization/classes/${classId}/monthly-summaries/close`, {
                            method: 'POST',
                            headers,
                            body: JSON.stringify({
                                month: selectedSummaryMonth.value,
                                year: selectedSummaryYear.value,
                                customTitle: customCloseTitle.value.trim() || undefined
                            })
                        });
                        const data = await res.json();
                        if (res.ok) {
                            showToast(data.message || 'Đã chốt sổ hạnh kiểm tháng và đặt lại điểm về 100!');
                            showCloseConfirmModal.value = false;
                            customCloseTitle.value = '';
                            await fetchClosedPeriodsList();
                            await fetchMonthlySummary();
                            await fetchStudents();
                        } else {
                            showToast(data.message || 'Không thể chốt sổ hạnh kiểm', 'error');
                        }
                    } catch (e) {
                        showToast('Lỗi kết nối máy chủ', 'error');
                    } finally {
                        closingMonthlyConduct.value = false;
                    }
                }

                async function reopenMonthlyConduct() {
                    if (!confirm(`Bạn có chắc chắn muốn mở lại sổ hạnh kiểm "${monthlyData.value.monthLabel}"? Dữ liệu đã lưu của tháng này sẽ được mở lại để chỉnh sửa.`)) return;
                    try {
                        const headers = { ...getTokenHeader(), 'Content-Type': 'application/json' };
                        const classId = getClassIdFromUrl();
                        const res = await fetch(`/api/organization/classes/${classId}/monthly-summaries/reopen`, {
                            method: 'POST',
                            headers,
                            body: JSON.stringify({
                                month: selectedSummaryMonth.value,
                                year: selectedSummaryYear.value
                            })
                        });
                        const data = await res.json();
                        if (res.ok) {
                            showToast(data.message || 'Đã mở lại sổ hạnh kiểm thành công!');
                            await fetchClosedPeriodsList();
                            await fetchMonthlySummary();
                        } else {
                            showToast(data.message || 'Không thể mở lại sổ', 'error');
                        }
                    } catch (e) {
                        showToast('Lỗi kết nối máy chủ', 'error');
                    }
                }

                // Inline edit for organization accounts in past closed summaries
                function startEditSummaryItem(item) {
                    if (!isOrganizationAccountUser.value) {
                        showToast('Chỉ tài khoản cấp Tổ chức mới có quyền chỉnh sửa điểm của tháng đã tổng kết!', 'error');
                        return;
                    }
                    editingSummaryItem.value = {
                        id: item.id,
                        score: item.finalScore,
                        note: ''
                    };
                }

                function cancelEditSummaryItem() {
                    editingSummaryItem.value = null;
                }

                async function saveEditSummaryItem() {
                    if (!editingSummaryItem.value) return;
                    if (!isOrganizationAccountUser.value) {
                        showToast('Chỉ tài khoản cấp Tổ chức mới có quyền chỉnh sửa điểm!', 'error');
                        return;
                    }

                    const score = Number(editingSummaryItem.value.score);
                    if (isNaN(score) || score < 0 || score > 100) {
                        showToast('Điểm hạnh kiểm phải từ 0 đến 100!', 'error');
                        return;
                    }

                    savingSummaryItem.value = true;
                    try {
                        const headers = { ...getTokenHeader(), 'Content-Type': 'application/json' };
                        const classId = getClassIdFromUrl();
                        const res = await fetch(`/api/organization/classes/${classId}/monthly-summaries/${editingSummaryItem.value.id}`, {
                            method: 'PUT',
                            headers,
                            body: JSON.stringify({
                                finalScore: score,
                                note: editingSummaryItem.value.note
                            })
                        });
                        const data = await res.json();
                        if (res.ok) {
                            showToast(data.message || 'Đã sửa điểm tổng kết thành công!');
                            editingSummaryItem.value = null;
                            await fetchMonthlySummary();
                        } else {
                            showToast(data.message || 'Không thể cập nhật điểm', 'error');
                        }
                    } catch (e) {
                        showToast('Lỗi kết nối khi cập nhật điểm', 'error');
                    } finally {
                        savingSummaryItem.value = false;
                    }
                }

                function exportMonthlySummaryCsv() {
                    if (!monthlyData.value || !monthlyData.value.summaries || monthlyData.value.summaries.length === 0) {
                        showToast('Chưa có dữ liệu để xuất', 'error');
                        return;
                    }

                    const className = currentClass.value?.name || 'Lớp';
                    const reportTitle = monthlyData.value.monthLabel || `Báo cáo Hạnh kiểm Tháng ${selectedSummaryMonth.value}/${selectedSummaryYear.value}`;
                    const stats = monthlyData.value.stats || { total: 0, tot: 0, kha: 0, dat: 0, chuaDat: 0 };
                    const creatorName = monthlyData.value.closedInfo?.closedByUserName || displayName.value || 'Người lập';

                    const headers = ['STT', 'Mã Học Sinh', 'Họ và Tên Học Sinh', 'Điểm Hạnh Kiểm', 'Xếp Loại', 'Chi Tiết Vi Phạm / Ghi Chú'];
                    const rows = monthlyData.value.summaries.map((s, idx) => {
                        const viPham = (s.deductions || []).map(d => d.reason).filter(Boolean).join('; ') || (s.currentReason || 'Tốt, không có vi phạm');
                        const rankCls = s.conductRank === 'Tốt' ? 'bg-good' : '';
                        return [
                            { value: idx + 1, align: 'text-center' },
                            { value: s.studentCode || '—', align: 'text-center' },
                            { value: s.studentName || '', align: 'text-left font-bold' },
                            { value: s.finalScore, align: 'text-center font-bold' },
                            { value: s.conductRank || '', align: `text-center ${rankCls}` },
                            { value: viPham, align: 'text-left' }
                        ];
                    });

                    exportExcelHtmlTable({
                        filename: `Bao_cao_hanh_kiem_${reportTitle.replace(/[^a-zA-Z0-9\p{L}]/gu, '_')}_${className}`,
                        title: `BÁO CÁO TỔNG KẾT ĐÁNH GIÁ & XẾP LOẠI HẠNH KIỂM`,
                        subheaders: [
                            `Tiêu đề kỳ báo cáo: ${reportTitle}`,
                            `Lớp: ${className} | Ngày xuất: ${new Date().toLocaleDateString('vi-VN')} | Người lập: ${creatorName}`,
                            `THỐNG KÊ: Tổng: ${stats.total} HS | Tốt: ${stats.tot} | Khá: ${stats.kha} | Đạt: ${stats.dat} | Chưa đạt: ${stats.chuaDat}`
                        ],
                        headers,
                        rows,
                        colWidths: [50, 95, 200, 110, 100, 320]
                    });

                    showToast('Đã xuất báo cáo tháng (kẻ bảng & căn lề chuẩn) thành công!');
                }

                function getRankBadgeClass(rank) {
                    switch (rank) {
                        case 'Tốt':
                            return 'bg-[#34c759]/10 text-[#15803d] border-[#34c759]/30';
                        case 'Khá':
                            return 'bg-[#0071e3]/10 text-[#0071e3] border-[#0071e3]/30';
                        case 'Đạt':
                            return 'bg-[#ff9500]/10 text-[#d97706] border-[#ff9500]/30';
                        case 'Chưa đạt':
                            return 'bg-[#ff3b30]/10 text-[#b91c1c] border-[#ff3b30]/30';
                        default:
                            return 'bg-black/[0.05] text-[#86868b] border-black/[0.08]';
                    }
                }

                // ==========================================
                // Term Summary State & Logic (HK1, HK2, Cả Năm)
                // ==========================================
                const showTermSummaryModal = ref(false);
                const loadingTermSummary = ref(false);
                const activeTermType = ref('sem1'); // 'sem1' | 'sem2' | 'year'
                const selectedTermPeriodKeys = ref([]);
                const termSummaryData = ref({
                    termType: 'sem1',
                    monthColumns: [],
                    students: []
                });

                async function openTermSummaryModal() {
                    showTermSummaryModal.value = true;
                    await fetchClosedPeriodsList();

                    // Mặc định chọn 5 tháng đầu tiên cho HK1 nếu có, hoặc các tháng hiện có
                    if (selectedTermPeriodKeys.value.length === 0 && closedPeriodsList.value.length > 0) {
                        // Sắp xếp tăng dần theo năm - tháng
                        const sorted = [...closedPeriodsList.value].sort((a, b) => (a.year * 100 + a.month) - (b.year * 100 + b.month));
                        selectedTermPeriodKeys.value = sorted.slice(0, Math.min(sorted.length, 5)).map(p => `${p.year}-${p.month}`);
                    }

                    await fetchTermSummaryData();
                }

                async function switchTermType(type) {
                    activeTermType.value = type;
                    if (type === 'year') {
                        // Cả năm: chọn tất cả các tháng đã chốt
                        selectedTermPeriodKeys.value = closedPeriodsList.value.map(p => `${p.year}-${p.month}`);
                    } else if (type === 'sem2') {
                        const sorted = [...closedPeriodsList.value].sort((a, b) => (a.year * 100 + a.month) - (b.year * 100 + b.month));
                        // HK2: lấy nửa sau các tháng nếu có
                        if (sorted.length > 5) {
                            selectedTermPeriodKeys.value = sorted.slice(5).map(p => `${p.year}-${p.month}`);
                        } else {
                            selectedTermPeriodKeys.value = sorted.map(p => `${p.year}-${p.month}`);
                        }
                    } else if (type === 'sem1') {
                        const sorted = [...closedPeriodsList.value].sort((a, b) => (a.year * 100 + a.month) - (b.year * 100 + b.month));
                        selectedTermPeriodKeys.value = sorted.slice(0, Math.min(sorted.length, 5)).map(p => `${p.year}-${p.month}`);
                    }

                    await fetchTermSummaryData();
                }

                async function fetchTermSummaryData() {
                    loadingTermSummary.value = true;
                    try {
                        const headers = { ...getTokenHeader(), 'Content-Type': 'application/json' };
                        const classId = getClassIdFromUrl();
                        const res = await fetch(`/api/organization/classes/${classId}/term-summaries`, {
                            method: 'POST',
                            headers,
                            body: JSON.stringify({
                                termType: activeTermType.value,
                                selectedPeriodKeys: selectedTermPeriodKeys.value
                            })
                        });

                        if (res.ok) {
                            const data = await res.json();
                            termSummaryData.value = data;
                        } else {
                            const err = await res.json();
                            showToast(err.message || 'Không thể tổng hợp dữ liệu học kỳ', 'error');
                        }
                    } catch (e) {
                        showToast('Lỗi kết nối máy chủ khi tổng hợp học kỳ', 'error');
                    } finally {
                        loadingTermSummary.value = false;
                        setTimeout(() => { if (window.renderLucideSafe) window.renderLucideSafe(); }, 50);
                    }
                }

                function exportTermSummaryCsv() {
                    if (!termSummaryData.value || !termSummaryData.value.students || termSummaryData.value.students.length === 0) {
                        showToast('Chưa có dữ liệu để xuất bảng tổng kết kỳ', 'error');
                        return;
                    }

                    const className = currentClass.value?.name || 'Lớp';
                    const termName = activeTermType.value === 'sem1' ? 'HỌC KỲ I' : activeTermType.value === 'sem2' ? 'HỌC KỲ II' : 'CẢ NĂM HỌC';
                    const creatorName = displayName.value || 'Giáo viên';
                    const monthCols = termSummaryData.value.monthColumns || [];

                    // Table headers: STT, Mã HS, Họ và Tên, [Các tháng], Số tháng Tốt (>=90đ), Khác (<90đ)
                    const headers = [
                        'STT',
                        'Mã Học Sinh',
                        'Họ và Tên Học Sinh',
                        ...monthCols.map(c => c.label),
                        'Số Tháng Tốt (≥90đ)',
                        'Khác (<90đ)'
                    ];

                    const colWidths = [
                        50,
                        95,
                        210,
                        ...monthCols.map(() => 110),
                        130,
                        110
                    ];

                    const rows = termSummaryData.value.students.map((st, idx) => {
                        const monthCells = monthCols.map(c => {
                            const item = st.monthScores && st.monthScores[c.key];
                            return {
                                value: item ? `${item.score} (${item.rank})` : '—',
                                align: 'text-center',
                                cls: item && item.score >= 90 ? 'bg-good' : ''
                            };
                        });

                        return [
                            { value: idx + 1, align: 'text-center' },
                            { value: st.studentCode || '—', align: 'text-center' },
                            { value: st.studentName || '', align: 'text-left font-bold' },
                            ...monthCells,
                            // Hiển thị dạng "X / Y tháng" rõ ràng, có mso-number-format text để Excel không tự đổi sang ngày (ví dụ 2-Feb)
                            { value: `${st.goodCount} / ${monthCols.length} tháng`, align: 'text-center font-bold bg-good' },
                            { value: `${st.fairCount + st.passCount + st.failCount} tháng`, align: 'text-center' }
                        ];
                    });

                    const fileTerm = activeTermType.value === 'sem1' ? 'Hoc_Ky_1' : activeTermType.value === 'sem2' ? 'Hoc_Ky_2' : 'Ca_Nam';

                    exportExcelHtmlTable({
                        filename: `Bang_tong_ket_${fileTerm}_${className}`,
                        title: `BẢNG TỔNG KẾT HẠNH KIỂM HỌC SINH — ${termName}`,
                        subheaders: [
                            `Lớp: ${className} | Ngày xuất: ${new Date().toLocaleDateString('vi-VN')} | Người lập: ${creatorName}`,
                            `Quy chuẩn: Số tháng Tốt tính theo các tháng đạt từ 90 đến 100 điểm`
                        ],
                        headers,
                        rows,
                        colWidths
                    });

                    showToast('Đã xuất bảng tổng kết kỳ (kẻ bảng & căn lề chuẩn) thành công!');
                }

                const refreshIcons = () => {
                    nextTick(() => {
                        if (window.lucide && window.lucide.createIcons) {
                            window.lucide.createIcons();
                        }
                    });
                };

                watch([students, searchQuery, showAiDrawer, showAiPreviewModal, showDeductModal, showAuditLogsModal, showMonthlySummaryModal, showTermSummaryModal, chatMessages, debugMode, toast], () => {
                    refreshIcons();
                }, { deep: true });

                onUpdated(() => {
                    refreshIcons();
                });

                onMounted(() => {
                    fetchStudents();
                    initRealtimeSync();
                    window.addEventListener('beforeunload', handleBeforeUnload);
                    refreshIcons();
                });

                onUnmounted(() => {
                    if (sseEventSource) {
                        sseEventSource.close();
                    }
                    window.removeEventListener('beforeunload', handleBeforeUnload);
                });

                return {
                    user,
                    userPermission,
                    isOrganizationAccountUser,
                    loading,
                    saving,
                    currentClass,
                    students,
                    searchQuery,
                    filteredStudents,
                    toast,
                    displayName,
                    modifiedCount,
                    debugMode,
                    sseConnected,
                    remoteUpdateDetected,
                    remoteUpdateMessage,
                    showDraftRecoveryPrompt,
                    draftItemCount,
                    lastDraftSavedTime,
                    restoreDraft,
                    discardDraft,
                    dismissRemoteBanner,
                    forceSyncWithServer,
                    showAiDrawer,
                    showAiPreviewModal,
                    aiPrompt,
                    aiAttachedFile,
                    parsingAi,
                    executingAi,
                    isGeminiPowered,
                    chatMessages,
                    proposedPlan,
                    sendChatMessage,
                    openPreviewFromChat,
                    confirmExecuteServerPlan,
                    fetchStudents,
                    markModified,
                    addNewRow,
                    deleteRow,
                    saveAllChanges,
                    exportCsv,
                    showAuditLogsModal,
                    auditLogs,
                    loadingAuditLogs,
                    openAuditLogsModal,
                    formatDate,
                    showDeductModal,
                    targetDeductStudent,
                    deductPoints,
                    deductReason,
                    openDeductModal,
                    confirmDeduction,
                    classAuditLogs,
                    getStudentDeductionHistory,
                    onAiFileSelected,
                    removeAiFile,
                    showMonthlySummaryModal,
                    showCloseConfirmModal,
                    loadingMonthlySummary,
                    closingMonthlyConduct,
                    selectedSummaryMonth,
                    selectedSummaryYear,
                    closedPeriodsList,
                    selectedPeriodKey,
                    customCloseTitle,
                    editingSummaryItem,
                    savingSummaryItem,
                    onSelectPeriodKey,
                    onManualMonthYearChange,
                    startEditSummaryItem,
                    cancelEditSummaryItem,
                    saveEditSummaryItem,
                    monthlyData,
                    openMonthlySummaryModal,
                    fetchMonthlySummary,
                    confirmCloseMonthlyConduct,
                    reopenMonthlyConduct,
                    exportMonthlySummaryCsv,
                    getRankBadgeClass,
                    // Term Summary returns
                    showTermSummaryModal,
                    loadingTermSummary,
                    activeTermType,
                    selectedTermPeriodKeys,
                    termSummaryData,
                    openTermSummaryModal,
                    switchTermType,
                    fetchTermSummaryData,
                    exportTermSummaryCsv
                };
            }
        }).mount('#app');
    </script>
</body>

</html>
