<!DOCTYPE html>
<html lang="vi" class="scroll-smooth">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quản lý Học sinh Bảng tính — EduManager</title>
    <!-- Lucide Icons CDN -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <script src="/public/lucide-safe.js"></script>
    <!-- Google Fonts Inter & JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    <!-- App Styles -->
    <link rel="stylesheet" href="/public/style.css">
    <!-- TailwindCSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        apple: {
                            canvas: '#f5f5f7',
                            surface: '#ffffff',
                            text: '#1d1d1f',
                            muted: '#86868b',
                            tertiary: '#aeaeb2',
                            blue: '#0071e3',
                            blueHover: '#0077ed',
                            green: '#34c759',
                            orange: '#ff9500',
                            red: '#ff3b30',
                            border: 'rgba(0, 0, 0, 0.08)'
                        }
                    },
                    fontFamily: {
                        sans: ['-apple-system', 'BlinkMacSystemFont', '"SF Pro Text"', '"SF Pro Display"', '"SF Pro"', 'Inter', 'sans-serif'],
                        mono: ['"JetBrains Mono"', 'monospace']
                    }
                }
            }
        }
    </script>
    <!-- Vue 3 CDN -->
    <script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>

    <style>
        /* Apple Numbers Inspired Spreadsheet Styling */
        .excel-table-container {
            user-select: none;
        }

        .excel-th {
            background-color: #fafafc;
            border-right: 1px solid rgba(0, 0, 0, 0.06);
            border-bottom: 1px solid rgba(0, 0, 0, 0.08);
            color: #1d1d1f;
            font-size: 11px;
            font-weight: 600;
            padding: 8px 12px;
            position: sticky;
            top: 0;
            z-index: 10;
            letter-spacing: -0.01em;
        }

        .excel-col-header {
            background-color: #f5f5f7;
            color: #86868b;
            font-family: 'JetBrains Mono', monospace;
            font-size: 10px;
            font-weight: 600;
            text-align: center;
            border-right: 1px solid rgba(0, 0, 0, 0.06);
            border-bottom: 1px solid rgba(0, 0, 0, 0.06);
            padding: 4px 8px;
        }

        .excel-row-num {
            background-color: #f5f5f7;
            color: #86868b;
            font-family: 'JetBrains Mono', monospace;
            font-size: 10px;
            text-align: center;
            border-right: 1px solid rgba(0, 0, 0, 0.06);
            border-bottom: 1px solid rgba(0, 0, 0, 0.06);
            width: 44px;
            min-width: 44px;
        }

        .excel-cell {
            border-right: 1px solid rgba(0, 0, 0, 0.05);
            border-bottom: 1px solid rgba(0, 0, 0, 0.05);
            padding: 0;
            background-color: #ffffff;
            transition: background-color 0.15s ease;
        }

        .excel-cell input {
            width: 100%;
            height: 100%;
            padding: 7px 11px;
            background: transparent;
            color: #1d1d1f;
            font-size: 12px;
            outline: none;
            border: 2px solid transparent;
            transition: all 0.15s ease;
            font-family: inherit;
        }

        .excel-cell input:focus {
            background-color: #ffffff;
            border-color: #0071e3;
            border-radius: 4px;
            box-shadow: 0 0 0 2px rgba(0, 113, 227, 0.2);
            z-index: 5;
            position: relative;
        }

        .excel-cell-modified input {
            color: #0071e3;
            font-weight: 600;
        }

        .excel-toolbar-btn {
            padding: 5px 12px;
            background-color: rgba(0, 0, 0, 0.03);
            border: 1px solid rgba(0, 0, 0, 0.06);
            border-radius: 9999px;
            color: #1d1d1f;
            font-size: 11px;
            font-weight: 500;
            display: flex;
            align-items: center;
            gap: 6px;
            transition: all 0.15s ease;
        }

        .excel-toolbar-btn:hover {
            background-color: rgba(0, 0, 0, 0.07);
            color: #1d1d1f;
        }

        .excel-toolbar-btn:active {
            transform: scale(0.98);
        }
    </style>
</head>

<body class="bg-[#f5f5f7] text-[#1d1d1f] font-sans antialiased min-h-screen flex flex-col selection:bg-[#0071e3] selection:text-white">
    <div id="app" class="relative min-h-screen flex flex-col flex-1">
        <!-- Apple Numbers Navigation & Ribbon Toolbar Header -->
        <header class="border-b border-black/[0.06] bg-white/90 backdrop-blur-xl sticky top-0 z-40 shadow-sm">
            <!-- Top App Bar -->
            <div class="px-6 py-2.5 flex items-center justify-between border-b border-black/[0.05]">
                <div class="flex items-center space-x-3">
                    <a href="/dashboard" class="px-3.5 py-1.5 bg-black/[0.04] hover:bg-black/[0.08] text-[#1d1d1f] rounded-full text-xs font-medium transition border border-black/[0.06] flex items-center space-x-1.5 active:scale-[0.98]">
                        <i data-lucide="arrow-left" class="w-3.5 h-3.5 text-[#86868b]"></i>
                        <span>Bảng điều khiển</span>
                    </a>
                    <span class="text-black/20">|</span>
                    <div class="flex items-center space-x-2.5">
                        <div class="w-8 h-8 rounded-full bg-[#34c759] flex items-center justify-center text-white text-xs shadow-sm font-bold">
                            <i data-lucide="table-2" class="w-4 h-4"></i>
                        </div>
                        <div>
                            <h1 class="text-xs font-semibold text-[#1d1d1f] flex items-center gap-2">
                                <span>Bảng tính Học sinh</span>
                                <span v-if="!userPermission.canWrite" class="px-2 py-0.2 text-[10px] font-medium bg-[#ff9500]/10 text-[#d97706] border border-[#ff9500]/20 rounded-full flex items-center">
                                    <i data-lucide="lock" class="w-2.5 h-2.5 mr-1 text-[#d97706] inline"></i>Chỉ xem
                                </span>
                                <span v-else class="px-2 py-0.2 text-[10px] font-medium bg-[#34c759]/10 text-[#15803d] border border-[#34c759]/20 rounded-full flex items-center">
                                    <i data-lucide="pencil" class="w-2.5 h-2.5 mr-1 text-[#15803d] inline"></i>Lớp {{ currentClass?.name }}
                                </span>
                            </h1>
                            <p class="text-[10px] text-[#86868b]">Quản lý dữ liệu học sinh dạng bảng tính trực quan</p>
                        </div>
                    </div>
                </div>

                <div class="flex items-center space-x-2.5">
                    <!-- Real-time SSE Live Indicator -->
                    <div :class="sseConnected ? 'bg-[#34c759]/10 text-[#15803d] border-[#34c759]/30' : 'bg-black/[0.03] text-[#86868b] border-black/[0.06]'" class="px-2.5 py-1 text-xs font-medium rounded-full border flex items-center space-x-1.5" :title="sseConnected ? 'Đồng bộ thời gian thực (SSE) đang hoạt động' : 'Chưa kết nối đồng bộ trực tiếp'">
                        <span class="w-2 h-2 rounded-full" :class="sseConnected ? 'bg-[#34c759] animate-pulse' : 'bg-[#86868b]'"></span>
                        <span class="text-[11px]">{{ sseConnected ? 'Trực tiếp' : 'Ngoại tuyến' }}</span>
                    </div>

                    <!-- Auto-saved draft status -->
                    <span v-if="lastDraftSavedTime" class="text-[10px] text-[#86868b] hidden sm:inline">
                        Nháp: {{ lastDraftSavedTime }}
                    </span>

                    <div :class="debugMode ? 'bg-[#34c759]/10 text-[#15803d] border-[#34c759]/30' : 'bg-black/[0.03] text-[#86868b] border-black/[0.06]'" class="px-3 py-1 text-xs font-medium rounded-full border flex items-center space-x-1.5">
                        <i v-if="debugMode" data-lucide="bug" class="w-3.5 h-3.5 text-[#34c759]"></i>
                        <i v-else data-lucide="bug-off" class="w-3.5 h-3.5 text-[#86868b]"></i>
                        <span>Debug: {{ debugMode ? 'Bật' : 'Tắt' }}</span>
                    </div>
                    <button @click="saveAllChanges" :disabled="saving || !userPermission.canWrite || modifiedCount === 0" :class="!userPermission.canWrite || modifiedCount === 0 ? 'bg-black/[0.03] text-[#86868b] border border-black/[0.06] cursor-not-allowed' : 'bg-[#0071e3] hover:bg-[#0077ed] text-white shadow-sm active:scale-[0.98]'" class="px-4 py-1.5 font-medium text-xs rounded-full transition flex items-center space-x-1.5">
                        <i v-if="saving" data-lucide="loader-2" class="w-3.5 h-3.5 animate-spin"></i>
                        <i v-else-if="!userPermission.canWrite" data-lucide="lock" class="w-3.5 h-3.5"></i>
                        <i v-else data-lucide="save" class="w-3.5 h-3.5"></i>
                        <span>Lưu thay đổi ({{ modifiedCount }})</span>
                    </button>
                </div>
            </div>

            <!-- Apple Numbers Ribbon Toolbar -->
            <div class="px-6 py-2 bg-white/50 flex items-center justify-between gap-4 overflow-x-auto text-xs">
                <div class="flex items-center space-x-2">
                    <button @click="addNewRow" :disabled="!userPermission.isOwner" :class="!userPermission.isOwner ? 'opacity-40 cursor-not-allowed text-[#86868b] border-black/[0.04] bg-white' : 'text-[#15803d] border-[#34c759]/30 bg-[#34c759]/10 hover:bg-[#34c759]/20'" class="excel-toolbar-btn" :title="!userPermission.isOwner ? 'Chỉ Người sở hữu Tổ chức mới được phép thêm học sinh' : ''">
                        <i data-lucide="plus" class="w-3.5 h-3.5"></i>
                        <span>Thêm hàng</span>
                    </button>
                    <button @click="fetchStudents" class="excel-toolbar-btn">
                        <i data-lucide="refresh-cw" class="w-3.5 h-3.5 text-[#86868b]"></i>
                        <span>Tải lại</span>
                    </button>
                    <button @click="exportCsv" class="excel-toolbar-btn">
                        <i data-lucide="file-spreadsheet" class="w-3.5 h-3.5 text-[#86868b]"></i>
                        <span>Xuất CSV</span>
                    </button>
                    <button @click="openAuditLogsModal" class="excel-toolbar-btn text-[#0071e3] border-[#0071e3]/20 bg-[#0071e3]/5 hover:bg-[#0071e3]/10">
                        <i data-lucide="history" class="w-3.5 h-3.5"></i>
                        <span>Lịch sử Phiên bản</span>
                    </button>
                    <div class="relative ml-2">
                        <i data-lucide="search" class="w-3.5 h-3.5 absolute left-3 top-2.5 text-[#86868b]"></i>
                        <input v-model="searchQuery" type="text" placeholder="Tìm kiếm học sinh..." class="pl-8 pr-3 py-1 bg-[#f5f5f7] border border-black/[0.08] rounded-full text-[#1d1d1f] text-xs focus:bg-white focus:border-[#0071e3] transition w-52 outline-none">
                    </div>
                </div>

                <div class="flex items-center space-x-3 text-xs text-[#86868b]">
                    <button @click="showAiDrawer = !showAiDrawer" class="px-3.5 py-1 bg-[#1d1d1f] hover:bg-black text-white rounded-full transition font-medium flex items-center space-x-1.5 shadow-sm text-xs active:scale-[0.98]">
                        <i data-lucide="sparkles" class="w-3.5 h-3.5 text-[#ff9500]"></i>
                        <span>Trợ lý Gemini AI</span>
                    </button>
                    <span class="text-black/10">|</span>
                    <span class="flex items-center gap-1.5">Tổng số: <strong class="text-[#1d1d1f] font-mono">{{ students.length }}</strong></span>
                    <span class="text-black/10">|</span>
                    <span class="flex items-center gap-1.5">Đang sửa: <strong class="text-[#0071e3] font-mono">{{ modifiedCount }}</strong></span>
                </div>
            </div>

            <!-- Real-time Conflict / Remote Update Alert Banner -->
            <div v-if="remoteUpdateDetected" class="px-6 py-2.5 bg-[#ff9500]/10 border-t border-black/[0.04] flex items-center justify-between text-xs text-[#b45309] transition-all">
                <div class="flex items-center space-x-2">
                    <i data-lucide="alert-circle" class="w-4 h-4 text-[#ff9500]"></i>
                    <span><strong>Đồng bộ Máy chủ:</strong> {{ remoteUpdateMessage || 'Một người dùng khác vừa cập nhật dữ liệu lớp học này.' }}</span>
                </div>
                <div class="flex items-center space-x-2">
                    <button @click="dismissRemoteBanner" class="px-3 py-1 bg-black/[0.05] hover:bg-black/[0.1] rounded-full text-black/70 transition">Để sau</button>
                    <button @click="forceSyncWithServer" class="px-3 py-1 bg-[#ff9500] hover:bg-[#d97706] text-white rounded-full font-medium shadow-sm transition active:scale-[0.98]">Đồng bộ dữ liệu mới</button>
                </div>
            </div>

            <!-- Local Draft Recovery Prompt Banner -->
            <div v-if="showDraftRecoveryPrompt" class="px-6 py-2.5 bg-[#0071e3]/10 border-t border-black/[0.04] flex items-center justify-between text-xs text-[#0071e3] transition-all">
                <div class="flex items-center space-x-2">
                    <i data-lucide="sparkles" class="w-4 h-4 text-[#0071e3]"></i>
                    <span><strong>Phát hiện bản nháp chưa lưu:</strong> Bạn có {{ draftItemCount }} thay đổi từ phiên làm việc trước chưa lưu lên máy chủ.</span>
                </div>
                <div class="flex items-center space-x-2">
                    <button @click="discardDraft" class="px-3 py-1 bg-black/[0.05] hover:bg-black/[0.1] text-black/70 rounded-full transition">Bỏ qua</button>
                    <button @click="restoreDraft" class="px-3 py-1 bg-[#0071e3] hover:bg-[#0077ed] text-white rounded-full font-medium shadow-sm transition active:scale-[0.98]">Khôi phục bản nháp</button>
                </div>
            </div>
        </header>

        <!-- Main Excel Spreadsheet Work Area -->
        <main class="flex-1 flex flex-col overflow-hidden p-5 bg-[#f5f5f7]">
            <!-- Read-Only Banner for Members with Read Permission -->
            <div v-if="!userPermission.canWrite" class="mb-3 p-3 bg-[#ff9500]/10 border border-[#ff9500]/25 rounded-3xl text-[#d97706] text-xs flex items-center justify-between shadow-sm">
                <span class="flex items-center gap-2">
                    <i data-lucide="lock" class="w-4 h-4"></i>
                    <span><strong>Chế độ Chỉ xem (Read-Only):</strong> Bạn được phân quyền xem dữ liệu tại lớp này. Thao tác chỉnh sửa, thêm và xóa học sinh đã bị khóa.</span>
                </span>
            </div>

            <!-- Loading Indicator -->
            <div v-if="loading" class="flex-1 flex flex-col items-center justify-center space-y-3">
                <i data-lucide="loader-2" class="w-8 h-8 animate-spin text-[#0071e3]"></i>
                <p class="text-xs text-[#86868b] font-medium">Đang tải bảng tính...</p>
            </div>

            <!-- Spreadsheet Grid Container -->
            <div v-else class="flex-1 bg-white rounded-3xl border border-black/[0.08] overflow-auto flex flex-col excel-table-container shadow-[0_4px_24px_rgba(0,0,0,0.03)]">
                <table class="w-full text-left border-collapse min-w-[1100px]">
                    <thead>
                        <!-- Column Header Letters (A, B, C, D...) -->
                        <tr>
                            <th class="excel-col-header">#</th>
                            <th class="excel-col-header">A</th>
                            <th class="excel-col-header">B</th>
                            <th class="excel-col-header">C</th>
                            <th class="excel-col-header">D</th>
                            <th class="excel-col-header">E</th>
                            <th class="excel-col-header">F</th>
                            <th class="excel-col-header">G</th>
                            <th class="excel-col-header">H</th>
                            <th class="excel-col-header text-center">Thao tác</th>
                        </tr>
                        <!-- Attribute Field Names -->
                        <tr>
                            <th class="excel-th text-center">STT</th>
                            <th class="excel-th">Mã Học Sinh</th>
                            <th class="excel-th">Họ và Tên (*)</th>
                            <th class="excel-th">Ngày Sinh</th>
                            <th class="excel-th">SĐT Học Sinh</th>
                            <th class="excel-th">Email Học Sinh</th>
                            <th class="excel-th">SĐT Phụ Huynh</th>
                            <th class="excel-th">Email Phụ Huynh</th>
                            <th class="excel-th">Điểm Hạnh Kiểm</th>
                            <th class="excel-th text-center">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr v-for="(row, index) in filteredStudents" :key="row.tempId || row.id" :class="{'bg-[#0071e3]/5': row.isModified, 'bg-[#34c759]/5': row.isNew}">
                            <!-- Row Index Number -->
                            <td class="excel-row-num">{{ index + 1 }}</td>

                            <!-- Cell A: Student Code (Chỉ Owner chỉnh sửa) -->
                            <td class="excel-cell" :class="{'excel-cell-modified': row.isModified}">
                                <input v-model="row.studentCode" @input="markModified(row)" :readonly="!userPermission.isOwner" type="text" placeholder="HS001" :title="!userPermission.isOwner ? 'Chỉ Người sở hữu Tổ chức mới được sửa thông tin cá nhân' : ''">
                            </td>

                            <!-- Cell B: Name (Chỉ Owner chỉnh sửa) -->
                            <td class="excel-cell" :class="{'excel-cell-modified': row.isModified}">
                                <input v-model="row.name" @input="markModified(row)" :readonly="!userPermission.isOwner" type="text" placeholder="Nguyễn Văn A" class="font-medium text-[#1d1d1f]" :title="!userPermission.isOwner ? 'Chỉ Người sở hữu Tổ chức mới được sửa thông tin cá nhân' : ''">
                            </td>

                            <!-- Cell C: DOB (Chỉ Owner chỉnh sửa) -->
                            <td class="excel-cell" :class="{'excel-cell-modified': row.isModified}">
                                <input v-model="row.dateOfBirth" @change="markModified(row)" :readonly="!userPermission.isOwner" type="date" class="font-mono" :title="!userPermission.isOwner ? 'Chỉ Người sở hữu Tổ chức mới được sửa thông tin cá nhân' : ''">
                            </td>

                            <!-- Cell D: Student Phone (Chỉ Owner chỉnh sửa) -->
                            <td class="excel-cell" :class="{'excel-cell-modified': row.isModified}">
                                <input v-model="row.phone" @input="markModified(row)" :readonly="!userPermission.isOwner" type="text" placeholder="0901234567" class="font-mono" :title="!userPermission.isOwner ? 'Chỉ Người sở hữu Tổ chức mới được sửa thông tin cá nhân' : ''">
                            </td>

                            <!-- Cell E: Student Email (Chỉ Owner chỉnh sửa) -->
                            <td class="excel-cell" :class="{'excel-cell-modified': row.isModified}">
                                <input v-model="row.email" @input="markModified(row)" :readonly="!userPermission.isOwner" type="email" placeholder="student@gmail.com" :title="!userPermission.isOwner ? 'Chỉ Người sở hữu Tổ chức mới được sửa thông tin cá nhân' : ''">
                            </td>

                            <!-- Cell F: Parent Phone (Chỉ Owner chỉnh sửa) -->
                            <td class="excel-cell" :class="{'excel-cell-modified': row.isModified}">
                                <input v-model="row.parentPhone" @input="markModified(row)" :readonly="!userPermission.isOwner" type="text" placeholder="0987654321" class="font-mono" :title="!userPermission.isOwner ? 'Chỉ Người sở hữu Tổ chức mới được sửa thông tin cá nhân' : ''">
                            </td>

                            <!-- Cell G: Parent Email (Chỉ Owner chỉnh sửa) -->
                            <td class="excel-cell" :class="{'excel-cell-modified': row.isModified}">
                                <input v-model="row.parentEmail" @input="markModified(row)" :readonly="!userPermission.isOwner" type="email" placeholder="parent@gmail.com" :title="!userPermission.isOwner ? 'Chỉ Người sở hữu Tổ chức mới được sửa thông tin cá nhân' : ''">
                            </td>

                            <!-- Cell H: Conduct Score & Deduction Trigger Button with Hover History Tooltip (Thành viên có quyền ghi được phép) -->
                            <td class="excel-cell relative group" :class="{'excel-cell-modified': row.isModified}">
                                <div class="flex items-center justify-between px-2 h-full space-x-1.5">
                                    <div class="flex flex-col text-left leading-tight py-1 cursor-help">
                                        <span class="font-semibold text-[#15803d] text-xs font-mono flex items-center gap-1">
                                            <span>{{ row.conductScore ?? 100 }}</span>
                                            <i v-if="getStudentDeductionHistory(row.id).length > 0" data-lucide="history" class="w-2.5 h-2.5 text-[#ff9500] inline"></i>
                                        </span>
                                        <span v-if="row.conductDeductionReason" class="text-[10px] text-[#ff9500] truncate max-w-[120px] flex items-center" :title="row.conductDeductionReason">
                                            <i data-lucide="alert-triangle" class="w-2.5 h-2.5 mr-0.5 inline"></i>{{ row.conductDeductionReason }}
                                        </span>
                                    </div>
                                    <button v-if="userPermission.canWrite" @click="openDeductModal(row)" type="button" class="px-2.5 py-0.5 bg-[#ff9500]/10 hover:bg-[#ff9500]/20 text-[#d97706] border border-[#ff9500]/30 rounded-full text-[10px] font-medium transition flex items-center space-x-1 whitespace-nowrap active:scale-[0.98]" title="Trừ điểm hạnh kiểm & Nhập lý do">
                                        <i data-lucide="minus-circle" class="w-3 h-3"></i>
                                        <span>Trừ điểm</span>
                                    </button>
                                </div>

                                <!-- Hover Tooltip: Show Deduction History & Who Deducted -->
                                <div class="hidden group-hover:block absolute left-0 bottom-full mb-2 w-72 p-3.5 bg-white/95 border border-black/[0.08] rounded-3xl shadow-[0_12px_40px_rgba(0,0,0,0.12)] z-50 pointer-events-none text-left backdrop-blur-xl">
                                    <div class="flex items-center justify-between border-b border-black/[0.06] pb-1.5 mb-2">
                                        <span class="text-xs font-semibold text-[#1d1d1f] flex items-center gap-1.5">
                                            <i data-lucide="history" class="w-3.5 h-3.5 text-[#ff9500]"></i>
                                            <span>Lịch sử trừ điểm: {{ row.name }}</span>
                                        </span>
                                        <span class="text-[10px] font-mono text-[#86868b]">#{{ row.id }}</span>
                                    </div>

                                    <div v-if="getStudentDeductionHistory(row.id).length === 0" class="text-[11px] text-[#86868b] italic py-1">
                                        Chưa có lịch sử trừ điểm nào được ghi nhận.
                                    </div>

                                    <div v-else class="space-y-2 max-h-48 overflow-y-auto pr-1">
                                        <div v-for="h in getStudentDeductionHistory(row.id)" :key="h.id" class="p-2.5 bg-[#f5f5f7] rounded-2xl border border-black/[0.04] text-[11px] space-y-1">
                                            <div class="flex items-center justify-between text-[#1d1d1f]">
                                                <span :class="h.source === 'AGENT' ? 'text-[#d97706] font-semibold' : 'text-[#0071e3] font-semibold'" class="flex items-center gap-1">
                                                    <i v-if="h.source === 'AGENT'" data-lucide="bot" class="w-3 h-3"></i>
                                                    <i v-else data-lucide="user" class="w-3 h-3"></i>
                                                    <span>{{ h.userName || h.userEmail || 'Ẩn danh' }}</span>
                                                </span>
                                                <span class="text-[10px] text-[#86868b] font-mono">{{ formatDate(h.createdAt) }}</span>
                                            </div>
                                            <p class="text-[#1d1d1f] text-[10px] leading-snug">{{ h.description }}</p>
                                        </div>
                                    </div>
                                </div>
                            </td>

                            <!-- Action Column: Delete Row (Chỉ Owner mới có quyền xóa) -->
                            <td class="excel-cell text-center align-middle bg-white">
                                <button v-if="userPermission.isOwner" @click="deleteRow(index, row)" class="w-7 h-7 rounded-full hover:bg-[#ff3b30]/10 text-[#86868b] hover:text-[#ff3b30] transition flex items-center justify-center mx-auto" title="Xóa hàng này">
                                    <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                                </button>
                                <span v-else class="text-[#aeaeb2] text-xs flex justify-center" title="Chỉ Người sở hữu Tổ chức mới có quyền xóa học sinh"><i data-lucide="lock" class="w-3.5 h-3.5"></i></span>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </main>

        <!-- Status Footer Bar -->
        <footer class="bg-white/80 backdrop-blur-md border-t border-black/[0.06] px-6 py-2 flex items-center justify-between text-xs text-[#86868b]">
            <div class="flex items-center space-x-2">
                <span class="w-2 h-2 rounded-full bg-[#34c759]"></span>
                <span class="text-[11px]">Bảng tính đã sẵn sàng</span>
            </div>
            <div>
                <span class="text-[11px]">Trạng thái: <strong class="text-[#1d1d1f]">{{ saving ? 'Đang lưu...' : (modifiedCount > 0 ? 'Có thay đổi chưa lưu' : 'Đã đồng bộ với Server') }}</strong></span>
            </div>
        </footer>

        <!-- GEMINI AI CHATBOT DRAWER & PREVIEW MODAL -->
        <!-- Floating Gemini AI Trigger Button -->
        <button @click="showAiDrawer = !showAiDrawer" class="fixed bottom-6 right-6 w-14 h-14 bg-[#1d1d1f] hover:bg-black text-white rounded-full shadow-[0_8px_30px_rgba(0,0,0,0.2)] flex items-center justify-center text-lg z-40 hover:scale-105 active:scale-95 transition-all border border-white/20" title="Trợ lý Gemini AI">
            <i data-lucide="sparkles" class="w-6 h-6 text-[#ff9500]"></i>
        </button>

        <!-- Gemini AI Chatbot Drawer Panel -->
        <div v-if="showAiDrawer" class="fixed bottom-20 right-6 w-96 rounded-[32px] border border-black/[0.08] shadow-[0_16px_50px_rgba(0,0,0,0.12)] z-40 flex flex-col bg-white/95 backdrop-blur-2xl overflow-hidden h-[490px]">
            <div class="px-5 py-3.5 border-b border-black/[0.06] flex justify-between items-center bg-white/80 backdrop-blur-md">
                <div class="flex items-center space-x-2.5">
                    <div class="w-8 h-8 rounded-full bg-[#1d1d1f] flex items-center justify-center text-white text-xs shadow-sm">
                        <i data-lucide="sparkles" class="w-4 h-4 text-[#ff9500]"></i>
                    </div>
                    <div>
                        <h3 class="font-semibold text-[#1d1d1f] text-xs flex items-center gap-1.5">
                            <span>Gemini AI Assistant</span>
                            <span v-if="isGeminiPowered" class="px-2 py-0.2 text-[9px] bg-[#34c759]/10 text-[#15803d] border border-[#34c759]/20 rounded-full font-semibold">Active</span>
                        </h3>
                        <p class="text-[10px] text-[#86868b]">Trợ lý AI quản lý Lớp học & Bảng tính</p>
                    </div>
                </div>
                <button @click="showAiDrawer = false" class="w-7 h-7 rounded-full hover:bg-black/[0.05] text-[#86868b] hover:text-[#1d1d1f] flex items-center justify-center transition">
                    <i data-lucide="x" class="w-4 h-4"></i>
                </button>
            </div>

            <div class="flex-1 p-4 overflow-y-auto space-y-3 text-xs">
                <div v-for="(msg, idx) in chatMessages" :key="idx" :class="msg.role === 'user' ? 'justify-end' : 'justify-start'" class="flex items-start gap-2">
                    <div v-if="msg.role === 'assistant'" class="w-7 h-7 rounded-full bg-black/[0.05] text-[#1d1d1f] flex items-center justify-center text-[10px] flex-shrink-0 mt-0.5">
                        <i data-lucide="bot" class="w-3.5 h-3.5"></i>
                    </div>
                    <div :class="msg.role === 'user' ? 'bg-[#0071e3] text-white rounded-[22px] rounded-br-sm' : 'bg-[#f2f2f7] border border-black/[0.04] text-[#1d1d1f] rounded-[22px] rounded-bl-sm'" class="p-3 max-w-[82%] leading-relaxed space-y-2">
                        <div v-if="msg.fileName" class="flex items-center space-x-1.5 bg-black/[0.08] px-2.5 py-1 rounded-full text-[11px] mb-1.5">
                            <i data-lucide="paperclip" class="w-3 h-3"></i>
                            <span class="truncate">{{ msg.fileName }}</span>
                        </div>

                        <!-- Agent Thought Process / Luồng suy nghĩ của Agent -->
                        <div v-if="msg.thought" class="p-2.5 bg-black/[0.03] rounded-2xl border border-black/[0.04] text-[11px] text-[#424245] space-y-1">
                            <div class="flex items-center space-x-1.5 font-medium text-[#0071e3]">
                                <i data-lucide="brain" class="w-3.5 h-3.5 flex-shrink-0"></i>
                                <span>Suy nghĩ của Agent:</span>
                            </div>
                            <p class="whitespace-pre-wrap font-sans text-[#515154] leading-relaxed">{{ msg.thought }}</p>
                        </div>

                        <p>{{ msg.text }}</p>

                        <!-- Sandbox Output Logs / Kết quả thực thi lệnh -->
                        <div v-if="msg.executionLogs && msg.executionLogs.length" class="p-2.5 bg-[#1d1d1f] text-emerald-400 rounded-2xl border border-black/10 text-[10px] font-mono space-y-1 overflow-x-auto">
                            <div class="flex items-center space-x-1 text-[#86868b] text-[9px] uppercase font-sans font-semibold">
                                <i data-lucide="terminal" class="w-3 h-3 flex-shrink-0"></i>
                                <span>Output Sandbox:</span>
                            </div>
                            <div v-for="(log, lIdx) in msg.executionLogs" :key="lIdx" class="whitespace-pre-wrap leading-tight">{{ log }}</div>
                        </div>

                        <div v-if="msg.hasActions" class="pt-1.5 border-t border-black/[0.06] flex items-center justify-between text-[11px]">
                            <span class="text-[#ff9500] font-medium"><i data-lucide="list-checks" class="w-3 h-3 mr-1 inline"></i>{{ msg.actionsCount }} thao tác</span>
                            <button @click="openPreviewFromChat(msg)" class="px-3 py-1 bg-[#0071e3] hover:bg-[#0077ed] text-white rounded-full font-medium transition text-[10px] shadow-sm">
                                Xem & Thực thi
                            </button>
                        </div>
                    </div>
                </div>
                <div v-if="parsingAi" class="flex items-center space-x-2 text-[#86868b] italic text-xs py-2">
                    <i data-lucide="loader-2" class="w-4 h-4 animate-spin text-[#0071e3]"></i>
                    <span>Gemini AI đang suy nghĩ...</span>
                </div>
            </div>

            <div class="p-3 border-t border-black/[0.06] bg-white/90 backdrop-blur-md relative">
                <!-- File Preview Chip -->
                <div v-if="aiAttachedFile" class="absolute bottom-[58px] left-3 right-3 flex items-center justify-between bg-white border border-black/[0.08] px-3.5 py-1.5 rounded-full z-10 shadow-lg">
                    <div class="flex items-center space-x-2 overflow-hidden">
                        <i data-lucide="file-text" class="w-3.5 h-3.5 text-[#0071e3]"></i>
                        <span class="text-xs text-[#1d1d1f] truncate">{{ aiAttachedFile.name }}</span>
                        <span class="text-[10px] text-[#86868b]">({{ (aiAttachedFile.size / 1024).toFixed(1) }} KB)</span>
                    </div>
                    <button @click="removeAiFile" type="button" class="text-[#86868b] hover:text-[#ff3b30] transition">
                        <i data-lucide="x" class="w-3.5 h-3.5"></i>
                    </button>
                </div>

                <form @submit.prevent="sendChatMessage" class="flex items-center space-x-2">
                    <button type="button" @click="$refs.aiFileInput.click()" :disabled="parsingAi" class="w-8 h-8 rounded-full bg-[#f5f5f7] hover:bg-black/[0.08] text-[#1d1d1f] flex items-center justify-center text-xs transition border border-black/[0.06]" title="Đính kèm file">
                        <i data-lucide="paperclip" class="w-3.5 h-3.5"></i>
                    </button>
                    <input type="file" ref="aiFileInput" @change="onAiFileSelected" accept=".pdf,.doc,.docx,.csv,image/*" class="hidden">
                    
                    <input v-model="aiPrompt" type="text" placeholder="Thêm học sinh hoặc đính kèm file..." :disabled="parsingAi" class="flex-1 px-4 py-2 bg-[#f5f5f7] border border-black/[0.08] rounded-full text-[#1d1d1f] text-xs focus:bg-white focus:border-[#0071e3] transition outline-none">
                    <button type="submit" :disabled="parsingAi || (!aiPrompt.trim() && !aiAttachedFile)" class="w-8 h-8 rounded-full bg-[#0071e3] hover:bg-[#0077ed] disabled:opacity-40 text-white flex items-center justify-center text-xs transition shadow-sm active:scale-95">
                        <i data-lucide="send" class="w-3.5 h-3.5"></i>
                    </button>
                </form>
            </div>
        </div>

        <!-- Server AI Preview Modal -->
        <div v-if="showAiPreviewModal" class="fixed inset-0 bg-black/40 backdrop-blur-md z-50 flex items-center justify-center p-4">
            <div class="bg-white max-w-lg w-full rounded-[36px] p-6 border border-black/[0.08] space-y-4 shadow-[0_24px_70px_rgba(0,0,0,0.18)]">
                <div class="flex items-center space-x-3 border-b border-black/[0.06] pb-3">
                    <div class="w-10 h-10 rounded-full bg-[#0071e3]/10 text-[#0071e3] flex items-center justify-center text-base font-bold">
                        <i data-lucide="eye" class="w-5 h-5"></i>
                    </div>
                    <div>
                        <h3 class="font-semibold text-[#1d1d1f] text-sm">Kế hoạch Gemini AI (Server Preview)</h3>
                        <p class="text-xs text-[#86868b]">Các thao tác được xác thực an toàn trước khi thực thi.</p>
                    </div>
                </div>

                <div class="space-y-3">
                    <div class="p-3.5 bg-[#0071e3]/5 border border-[#0071e3]/15 rounded-2xl text-xs text-[#1d1d1f]">
                        <i data-lucide="info" class="w-3.5 h-3.5 mr-1 text-[#0071e3] inline"></i>{{ proposedPlan.summary }}
                    </div>

                    <!-- Agent Thought in Preview Modal -->
                    <div v-if="proposedPlan.thought" class="p-3 bg-black/[0.02] border border-black/[0.05] rounded-2xl text-xs text-[#424245] space-y-1">
                        <div class="flex items-center space-x-1.5 font-medium text-[#0071e3] text-[11px]">
                            <i data-lucide="brain" class="w-3.5 h-3.5 flex-shrink-0"></i>
                            <span>Suy nghĩ của Agent:</span>
                        </div>
                        <p class="whitespace-pre-wrap leading-relaxed text-[#515154] text-[11px]">{{ proposedPlan.thought }}</p>
                    </div>

                    <div v-if="debugMode && proposedPlan.code" class="space-y-1.5">
                        <label class="text-[11px] font-semibold text-[#15803d] uppercase tracking-wider flex items-center justify-between">
                            <span><i data-lucide="bug" class="w-3.5 h-3.5 mr-1 inline"></i>Mã JavaScript (Debug Mode):</span>
                            <span class="text-[#0071e3] font-mono text-[10px]">Node.js Sandbox</span>
                        </label>
                        <pre class="p-3 bg-[#1d1d1f] text-emerald-400 rounded-2xl border border-black/10 text-xs font-mono overflow-x-auto whitespace-pre-wrap max-h-44"><code>{{ proposedPlan.code }}</code></pre>
                    </div>

                    <div v-if="proposedPlan.actions && proposedPlan.actions.length" class="space-y-2 max-h-44 overflow-y-auto">
                        <div v-for="(item, idx) in proposedPlan.actions" :key="idx" class="p-3 bg-[#f5f5f7] rounded-2xl border border-black/[0.05] flex items-center justify-between text-xs">
                            <div class="flex items-center space-x-2">
                                <span class="w-5 h-5 bg-black/[0.05] rounded-full flex items-center justify-center font-bold text-[10px] text-[#1d1d1f]">{{ idx + 1 }}</span>
                                <span class="font-medium text-[#1d1d1f]">{{ item.description || item.action }}</span>
                            </div>
                            <span class="px-2.5 py-0.5 text-[9px] font-semibold rounded-full bg-[#34c759]/10 text-[#15803d] border border-[#34c759]/20">
                                Server API
                            </span>
                        </div>
                    </div>
                </div>

                <div class="flex justify-end space-x-2 pt-2 border-t border-black/[0.06]">
                    <button @click="showAiPreviewModal = false" class="px-4 py-2 bg-black/[0.04] hover:bg-black/[0.08] text-[#1d1d1f] text-xs font-medium rounded-full transition">
                        Hủy bỏ
                    </button>
                    <button @click="confirmExecuteServerPlan" :disabled="executingAi" class="px-5 py-2 bg-[#0071e3] hover:bg-[#0077ed] text-white text-xs font-medium rounded-full transition flex items-center space-x-2 shadow-sm active:scale-[0.98]">
                        <i v-if="executingAi" data-lucide="loader-2" class="w-3.5 h-3.5 animate-spin"></i>
                        <i v-else data-lucide="check" class="w-3.5 h-3.5"></i>
                        <span>Chấp nhận & Thực thi</span>
                    </button>
                </div>
            </div>
        </div>

        <!-- Conduct Deduction Popup Modal -->
        <div v-if="showDeductModal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/40 backdrop-blur-md">
            <div class="bg-white border border-black/[0.08] rounded-[36px] max-w-md w-full p-6 shadow-[0_24px_70px_rgba(0,0,0,0.18)] space-y-4">
                <div class="flex items-center justify-between pb-3 border-b border-black/[0.06]">
                    <div class="flex items-center space-x-2.5">
                        <div class="w-10 h-10 rounded-full bg-[#ff9500]/10 text-[#ff9500] border border-[#ff9500]/20 flex items-center justify-center font-bold">
                            <i data-lucide="minus-circle" class="w-5 h-5"></i>
                        </div>
                        <div>
                            <h3 class="text-sm font-semibold text-[#1d1d1f]">Trừ Điểm Hạnh Kiểm</h3>
                            <p class="text-xs text-[#86868b]">Học sinh: <strong class="text-[#1d1d1f]">{{ targetDeductStudent?.name }}</strong> ({{ targetDeductStudent?.studentCode }})</p>
                        </div>
                    </div>
                    <button @click="showDeductModal = false" class="w-7 h-7 rounded-full hover:bg-black/[0.05] text-[#86868b] hover:text-[#1d1d1f] flex items-center justify-center transition">
                        <i data-lucide="x" class="w-4 h-4"></i>
                    </button>
                </div>

                <div class="space-y-3 text-xs">
                    <div>
                        <label class="block text-[#86868b] font-medium mb-1">Điểm hiện tại:</label>
                        <input :value="targetDeductStudent?.conductScore ?? 100" readonly type="text" class="w-full px-4 py-2 bg-[#f5f5f7] border border-black/[0.06] rounded-full text-[#1d1d1f] font-semibold font-mono outline-none">
                    </div>

                    <div>
                        <label class="block text-[#ff9500] font-medium mb-1">Số điểm muốn trừ (*):</label>
                        <input v-model.number="deductPoints" type="number" min="1" max="100" placeholder="Ví dụ: 5" class="w-full px-4 py-2 bg-[#f5f5f7] border border-black/[0.08] rounded-full text-[#1d1d1f] font-semibold focus:bg-white focus:border-[#ff9500] outline-none transition">
                    </div>

                    <div>
                        <label class="block text-[#1d1d1f] font-medium mb-1">Lý do vi phạm / trừ điểm (*):</label>
                        <textarea v-model="deductReason" rows="3" placeholder="Nhập lý do chi tiết (Ví dụ: Đóng tiền muộn, đi học trễ, không mặc đồng phục...)" class="w-full p-3 bg-[#f5f5f7] border border-black/[0.08] rounded-2xl text-[#1d1d1f] focus:bg-white focus:border-[#0071e3] outline-none transition"></textarea>
                    </div>

                    <!-- Common preset reasons -->
                    <div>
                        <label class="block text-[11px] text-[#86868b] mb-1.5">Gợi ý nhanh lý do vi phạm:</label>
                        <div class="flex flex-wrap gap-1.5">
                            <button @click="deductReason = 'Đi học muộn/Đi trễ'" type="button" class="px-3 py-1 bg-black/[0.04] hover:bg-black/[0.08] text-[#1d1d1f] rounded-full text-[10px] font-medium transition active:scale-95">Đi học muộn</button>
                            <button @click="deductReason = 'Không mặc đúng đồng phục'" type="button" class="px-3 py-1 bg-black/[0.04] hover:bg-black/[0.08] text-[#1d1d1f] rounded-full text-[10px] font-medium transition active:scale-95">Không đồng phục</button>
                            <button @click="deductReason = 'Không làm bài tập về nhà'" type="button" class="px-3 py-1 bg-black/[0.04] hover:bg-black/[0.08] text-[#1d1d1f] rounded-full text-[10px] font-medium transition active:scale-95">Thiếu BT về nhà</button>
                            <button @click="deductReason = 'Mất trật tự trong giờ học'" type="button" class="px-3 py-1 bg-black/[0.04] hover:bg-black/[0.08] text-[#1d1d1f] rounded-full text-[10px] font-medium transition active:scale-95">Mất trật tự</button>
                        </div>
                    </div>
                </div>

                <div class="flex justify-end space-x-2 pt-3 border-t border-black/[0.06]">
                    <button @click="showDeductModal = false" class="px-4 py-2 bg-black/[0.04] hover:bg-black/[0.08] text-[#1d1d1f] text-xs font-medium rounded-full transition">
                        Hủy
                    </button>
                    <button @click="confirmDeduction" class="px-5 py-2 bg-[#ff9500] hover:bg-[#e08500] text-white text-xs font-medium rounded-full transition flex items-center space-x-1.5 shadow-sm active:scale-[0.98]">
                        <i data-lucide="check" class="w-3.5 h-3.5"></i>
                        <span>Xác nhận Trừ điểm</span>
                    </button>
                </div>
            </div>
        </div>

        <!-- Google Sheets Style Version History Modal -->
        <div v-if="showAuditLogsModal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/40 backdrop-blur-md">
            <div class="bg-white border border-black/[0.08] rounded-[36px] max-w-4xl w-full p-6 shadow-[0_24px_70px_rgba(0,0,0,0.18)] flex flex-col max-h-[85vh]">
                <div class="flex items-center justify-between pb-4 border-b border-black/[0.06]">
                    <div class="flex items-center space-x-3">
                        <div class="w-10 h-10 rounded-full bg-[#0071e3]/10 text-[#0071e3] border border-[#0071e3]/20 flex items-center justify-center font-bold">
                            <i data-lucide="history" class="w-5 h-5"></i>
                        </div>
                        <div>
                            <h3 class="text-sm font-semibold text-[#1d1d1f] flex items-center gap-2">
                                <span>Lịch sử Phiên bản & Nhật ký Thay đổi</span>
                                <span class="px-2.5 py-0.5 text-[10px] bg-black/[0.04] text-[#86868b] rounded-full border border-black/[0.06]">Google Sheets Style</span>
                            </h3>
                            <p class="text-xs text-[#86868b]">Lịch sử chỉnh sửa dữ liệu, phân biệt giữa Người dùng và AI Agent</p>
                        </div>
                    </div>
                    <button @click="showAuditLogsModal = false" class="w-7 h-7 rounded-full hover:bg-black/[0.05] text-[#86868b] hover:text-[#1d1d1f] flex items-center justify-center transition">
                        <i data-lucide="x" class="w-4 h-4"></i>
                    </button>
                </div>

                <div class="flex-1 overflow-y-auto py-4 space-y-3">
                    <div v-if="loadingAuditLogs" class="text-center py-12 text-[#86868b]">
                        <i data-lucide="loader-2" class="w-6 h-6 animate-spin mb-2 text-[#0071e3] mx-auto"></i>
                        <p class="text-xs">Đang tải lịch sử phiên bản...</p>
                    </div>

                    <div v-else-if="auditLogs.length === 0" class="text-center py-12 text-[#86868b]">
                        <i data-lucide="clock" class="w-6 h-6 mb-2 text-[#86868b] mx-auto"></i>
                        <p class="text-xs">Chưa có nhật ký thay đổi nào cho lớp học này</p>
                    </div>

                    <div v-else v-for="log in auditLogs" :key="log.id" class="p-4 bg-white rounded-3xl border border-black/[0.06] shadow-[0_2px_8px_rgba(0,0,0,0.02)] space-y-2.5">
                        <div class="flex items-center justify-between gap-4 mb-1">
                            <div class="flex items-center space-x-2">
                                <span :class="log.source === 'AGENT' ? 'bg-[#ff9500]/10 text-[#d97706] border-[#ff9500]/20' : 'bg-[#0071e3]/10 text-[#0071e3] border-[#0071e3]/20'" class="px-2.5 py-0.5 text-[10px] font-semibold rounded-full border flex items-center gap-1">
                                    <i v-if="log.source === 'AGENT'" data-lucide="bot" class="w-3 h-3"></i>
                                    <i v-else data-lucide="user" class="w-3 h-3"></i>
                                    <span>{{ log.source === 'AGENT' ? 'AI Agent' : 'Người dùng' }}</span>
                                </span>
                                <span class="font-medium text-[#1d1d1f] text-xs">{{ log.userName || log.userEmail || 'Ẩn danh' }}</span>
                                <span class="text-[#86868b] text-xs">({{ log.action }})</span>
                            </div>
                            <span class="text-[11px] text-[#86868b] font-mono">{{ formatDate(log.createdAt) }}</span>
                        </div>

                        <p class="text-xs text-[#1d1d1f] font-medium">{{ log.description }}</p>

                        <!-- Google Sheets Diff View -->
                        <div v-if="log.diffs && log.diffs.length > 0" class="mt-2 space-y-1.5 bg-[#f5f5f7] p-3 rounded-2xl border border-black/[0.05]">
                            <div class="text-[10px] font-semibold text-[#86868b] uppercase tracking-wider mb-1 flex items-center gap-1">
                                <i data-lucide="git-compare" class="w-3.5 h-3.5 text-[#0071e3]"></i>
                                <span>Chi tiết các trường thay đổi:</span>
                            </div>
                            <div v-for="d in log.diffs" :key="d.field" class="flex items-center justify-between text-xs py-1 px-2.5 rounded-xl bg-white border border-black/[0.05]">
                                <span class="text-[#86868b] font-medium w-1/4 text-[11px]">{{ d.field }}:</span>
                                <div class="w-3/4 flex items-center gap-2 font-mono text-[11px]">
                                    <span class="text-[#ff3b30] line-through bg-[#ff3b30]/10 px-1.5 py-0.2 rounded-full border border-[#ff3b30]/20 truncate max-w-[45%] text-[10px]">{{ d.oldValue }}</span>
                                    <i data-lucide="arrow-right" class="w-3 h-3 text-[#86868b]"></i>
                                    <span class="text-[#15803d] font-medium bg-[#34c759]/10 px-1.5 py-0.2 rounded-full border border-[#34c759]/20 truncate max-w-[45%] text-[10px]">{{ d.newValue }}</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="flex justify-end pt-3 border-t border-black/[0.06]">
                    <button @click="showAuditLogsModal = false" class="px-5 py-2 bg-black/[0.04] hover:bg-black/[0.08] text-[#1d1d1f] text-xs font-medium rounded-full transition">
                        Đóng
                    </button>
                </div>
            </div>
        </div>

        <!-- Toast Feedback Notification -->
        <div v-if="toast.show" :class="toast.type === 'error' ? 'bg-white text-[#1d1d1f] border-[#ff3b30]/30 shadow-[0_8px_30px_rgba(255,59,48,0.15)]' : 'bg-white text-[#1d1d1f] border-[#34c759]/30 shadow-[0_8px_30px_rgba(52,199,89,0.15)]'" class="fixed bottom-6 left-6 px-4 py-2.5 rounded-full border text-xs font-medium flex items-center space-x-2.5 z-50 backdrop-blur-xl transition-all">
            <i v-if="toast.type === 'error'" data-lucide="alert-circle" class="w-4 h-4 text-[#ff3b30]"></i>
            <i v-else data-lucide="check-circle-2" class="w-4 h-4 text-[#34c759]"></i>
            <span>{{ toast.message }}</span>
        </div>
    </div>

    <script type="module">
        import { getAuthToken, clientLogout } from "/public/clientAuth.js";

        const { createApp, ref, computed, onMounted, onUnmounted, onUpdated, nextTick, watch } = Vue;

        createApp({
            setup() {
                const user = ref(null);
                const loading = ref(true);
                const saving = ref(false);
                const currentClass = ref(null);
                const students = ref([]);
                const searchQuery = ref('');

                // Real-time SSE & Local Draft State
                const sseConnected = ref(false);
                const remoteUpdateDetected = ref(false);
                const remoteUpdateMessage = ref('');
                const showDraftRecoveryPrompt = ref(false);
                const draftItemCount = ref(0);
                const lastDraftSavedTime = ref('');
                let sseEventSource = null;
                let draftDebounceTimer = null;

                // Gemini AI Chatbot & Debug State
                const debugMode = ref(false);
                const showAiDrawer = ref(false);
                const showAiPreviewModal = ref(false);
                const aiPrompt = ref('');
                const aiAttachedFile = ref(null);
                const parsingAi = ref(false);
                const executingAi = ref(false);
                const isGeminiPowered = ref(false);
                const proposedPlan = ref({ summary: '', code: '', actions: [] });

                // Conduct Deduction Popup Modal State
                const showDeductModal = ref(false);
                const targetDeductStudent = ref(null);
                const deductPoints = ref(5);
                const deductReason = ref('');

                function openDeductModal(row) {
                    if (!userPermission.value.canWrite) {
                        showToast('Bạn không có quyền trừ điểm hạnh kiểm ở lớp này!', 'error');
                        return;
                    }
                    targetDeductStudent.value = row;
                    deductPoints.value = 5;
                    deductReason.value = row.conductDeductionReason || '';
                    showDeductModal.value = true;
                }

                async function confirmDeduction() {
                    if (!targetDeductStudent.value) return;
                    if (!deductReason.value.trim()) {
                        showToast('Vui lòng nhập lý do trừ điểm hạnh kiểm!', 'error');
                        return;
                    }

                    const pts = Number(deductPoints.value) || 0;
                    const reason = deductReason.value.trim();
                    const studentId = targetDeductStudent.value.id;

                    try {
                        const headers = { ...getTokenHeader(), 'Content-Type': 'application/json' };
                        const res = await fetch(`/api/organization/students/${studentId}/deduct`, {
                            method: 'POST',
                            headers,
                            body: JSON.stringify({ points: pts, reason })
                        });

                        const data = await res.json();
                        if (res.ok) {
                            showToast(`Đã trừ ${pts} điểm hạnh kiểm của ${targetDeductStudent.value.name}!`);
                            showDeductModal.value = false;
                            await fetchStudents();
                        } else {
                            showToast(data.message || 'Không thể trừ điểm hạnh kiểm', 'error');
                        }
                    } catch (e) {
                        showToast('Lỗi kết nối máy chủ khi trừ điểm', 'error');
                    }
                }

                // Audit Logs / Version History State
                const showAuditLogsModal = ref(false);
                const auditLogs = ref([]);
                const loadingAuditLogs = ref(false);

                async function openAuditLogsModal() {
                    showAuditLogsModal.value = true;
                    loadingAuditLogs.value = true;
                    try {
                        const headers = getTokenHeader();
                        const classId = getClassIdFromUrl();
                        const res = await fetch(`/api/organization/audit-logs?classId=${classId}`, { headers });
                        if (res.ok) {
                            const data = await res.json();
                            auditLogs.value = data.auditLogs || [];
                        } else {
                            showToast('Không thể tải lịch sử phiên bản', 'error');
                        }
                    } catch (e) {
                        showToast('Lỗi kết nối máy chủ', 'error');
                    } finally {
                        loadingAuditLogs.value = false;
                    }
                }

                function formatDate(isoStr) {
                    if (!isoStr) return '';
                    const d = new Date(isoStr);
                    return d.toLocaleString('vi-VN');
                }

                function getStudentDeductionHistory(studentId) {
                    if (!studentId) return [];
                    return classAuditLogs.value.filter(log => {
                        const isStudentEntity = (log.entityType === 'student' && Number(log.entityId) === Number(studentId));
                        const isDeductAction = log.action === 'DEDUCT_CONDUCT_SCORE' || log.action === 'UPDATE_STUDENT';
                        const hasScoreDecrease = log.diffs && log.diffs.some(d => d.field === 'conductScore' || d.field === 'conductDeductionReason');
                        return isStudentEntity && (isDeductAction || hasScoreDecrease);
                    });
                }

                const chatMessages = ref([
                    {
                        role: 'assistant',
                        text: 'Xin chào! Tôi là Gemini AI Chatbot. Bạn có thể yêu cầu tôi thêm học sinh, cập nhật hoặc tạo lớp học.'
                    }
                ]);

                const toast = ref({ show: false, message: '', type: 'success' });
                function showToast(msg, type = 'success') {
                    toast.value = { show: true, message: msg, type };
                    setTimeout(() => { toast.value.show = false; }, 3500);
                }

                function getTokenHeader() {
                    try {
                        const tok = getAuthToken();
                        return tok ? { 'Authorization': `Bearer ${tok}` } : {};
                    } catch {
                        return {};
                    }
                }

                const userPermission = ref({ canWrite: true, isOwner: true });

                const displayName = computed(() => user.value?.name || 'Tổ chức');
                const modifiedCount = computed(() => students.value.filter(s => s.isModified || s.isNew).length);

                const filteredStudents = computed(() => {
                    if (!searchQuery.value.trim()) return students.value;
                    const q = searchQuery.value.toLowerCase().trim();
                    return students.value.filter(s =>
                        (s.name && s.name.toLowerCase().includes(q)) ||
                        (s.studentCode && s.studentCode.toLowerCase().includes(q)) ||
                        (s.phone && s.phone.includes(q)) ||
                        (s.email && s.email.toLowerCase().includes(q))
                    );
                });

                function getClassIdFromUrl() {
                    const parts = window.location.pathname.split('/').filter(Boolean);
                    const id = parts[parts.length - 1];
                    if (id && !isNaN(Number(id))) {
                        return Number(id);
                    }
                    window.location.href = '/dashboard';
                    return null;
                }

                const classAuditLogs = ref([]);

                async function fetchStudents() {
                    const classId = getClassIdFromUrl();
                    if (!classId) return;
                    loading.value = true;
                    try {
                        const headers = getTokenHeader();
                        const [dashRes, stdRes, auditRes] = await Promise.all([
                            fetch('/api/organization/dashboard', { headers }),
                            fetch(`/api/organization/classes/${classId}/students`, { headers }),
                            fetch(`/api/organization/audit-logs?classId=${classId}`, { headers })
                        ]);

                        if (dashRes.ok) {
                            const dashData = await dashRes.json();
                            user.value = dashData.user;
                            debugMode.value = Boolean(dashData.debugMode);
                            currentClass.value = (dashData.classes || []).find(c => c.id === classId) || { id: classId, name: `Lớp #${classId}` };
                        }

                        if (stdRes.ok) {
                            const stdData = await stdRes.json();
                            students.value = (stdData.students || []).map(s => ({
                                ...s,
                                isModified: false,
                                isNew: false
                            }));
                            if (stdData.userPermission) {
                                userPermission.value = stdData.userPermission;
                            }
                            checkLocalDraft();
                        }

                        if (auditRes.ok) {
                            const auditData = await auditRes.json();
                            classAuditLogs.value = auditData.auditLogs || [];
                        }
                    } catch (e) {
                        showToast('Lỗi tải dữ liệu lớp học', 'error');
                    } finally {
                        loading.value = false;
                        nextTick(() => { refreshIcons(); });
                    }
                }

                // --- LOCAL DRAFT AUTO-SAVE & RECOVERY ---
                function scheduleDraftSave() {
                    clearTimeout(draftDebounceTimer);
                    draftDebounceTimer = setTimeout(() => {
                        saveDraftToStorage();
                    }, 600);
                }

                function saveDraftToStorage() {
                    const classId = getClassIdFromUrl();
                    if (!classId) return;
                    const dirtyRows = students.value.filter(s => s.isModified || s.isNew);
                    if (dirtyRows.length > 0) {
                        try {
                            localStorage.setItem('draft_class_' + classId, JSON.stringify({
                                timestamp: Date.now(),
                                rows: dirtyRows
                            }));
                            const now = new Date();
                            lastDraftSavedTime.value = `${now.getHours().toString().padStart(2, '0')}:${now.getMinutes().toString().padStart(2, '0')}:${now.getSeconds().toString().padStart(2, '0')}`;
                        } catch {}
                    } else {
                        localStorage.removeItem('draft_class_' + classId);
                        lastDraftSavedTime.value = '';
                    }
                }

                function checkLocalDraft() {
                    const classId = getClassIdFromUrl();
                    if (!classId) return;
                    try {
                        const raw = localStorage.getItem('draft_class_' + classId);
                        if (!raw) return;
                        const parsed = JSON.parse(raw);
                        if (parsed && Array.isArray(parsed.rows) && parsed.rows.length > 0) {
                            draftItemCount.value = parsed.rows.length;
                            showDraftRecoveryPrompt.value = true;
                        }
                    } catch {}
                }

                function restoreDraft() {
                    const classId = getClassIdFromUrl();
                    try {
                        const raw = localStorage.getItem('draft_class_' + classId);
                        if (!raw) return;
                        const parsed = JSON.parse(raw);
                        const draftRows = parsed.rows || [];

                        for (const d of draftRows) {
                            if (d.isNew) {
                                students.value.push({ ...d, isModified: true, isNew: true });
                            } else {
                                const idx = students.value.findIndex(s => s.id === d.id);
                                if (idx !== -1) {
                                    students.value[idx] = { ...students.value[idx], ...d, isModified: true };
                                }
                            }
                        }
                        showDraftRecoveryPrompt.value = false;
                        showToast(`Đã khôi phục ${draftRows.length} thay đổi từ bản nháp!`);
                        nextTick(() => { refreshIcons(); });
                    } catch {
                        showToast('Không thể khôi phục bản nháp', 'error');
                    }
                }

                function discardDraft() {
                    const classId = getClassIdFromUrl();
                    localStorage.removeItem('draft_class_' + classId);
                    showDraftRecoveryPrompt.value = false;
                    showToast('Đã xóa bỏ bản nháp tạm.');
                }

                const handleBeforeUnload = (e) => {
                    if (modifiedCount.value > 0) {
                        e.preventDefault();
                        e.returnValue = 'Bạn có thay đổi chưa lưu trên bảng tính. Bạn có chắc muốn rời đi?';
                        return e.returnValue;
                    }
                };

                // Watch students deeply to trigger auto-draft
                watch(students, () => {
                    scheduleDraftSave();
                }, { deep: true });

                // --- REAL-TIME SSE SYNCHRONIZATION ---
                function initRealtimeSync() {
                    const classId = getClassIdFromUrl();
                    if (!classId) return;

                    let token = '';
                    try { token = getAuthToken(); } catch {}
                    if (!token) return;

                    if (sseEventSource) {
                        sseEventSource.close();
                    }

                    const sseUrl = `/api/organization/sync-events?classId=${classId}&token=${encodeURIComponent(token)}`;
                    sseEventSource = new EventSource(sseUrl);

                    sseEventSource.addEventListener('connected', () => {
                        sseConnected.value = true;
                    });

                    sseEventSource.addEventListener('sync', async (event) => {
                        try {
                            const ev = JSON.parse(event.data);
                            if (user.value && ev.senderUserId && ev.senderUserId === user.value.id) {
                                return;
                            }
                            if (ev.classId && Number(ev.classId) !== Number(classId)) {
                                return;
                            }

                            if (modifiedCount.value === 0) {
                                await fetchStudents();
                                showToast(ev.message || 'Dữ liệu vừa được cập nhật thời gian thực');
                            } else {
                                remoteUpdateDetected.value = true;
                                remoteUpdateMessage.value = ev.message || 'Một người dùng khác vừa cập nhật dữ liệu lớp học này trên máy chủ.';
                            }
                        } catch (err) {
                            console.error('[SSE Event Error]', err);
                        }
                    });

                    sseEventSource.onerror = () => {
                        sseConnected.value = false;
                    };
                }

                function dismissRemoteBanner() {
                    remoteUpdateDetected.value = false;
                }

                async function forceSyncWithServer() {
                    remoteUpdateDetected.value = false;
                    await fetchStudents();
                    showToast('Đã đồng bộ dữ liệu mới nhất từ máy chủ');
                }

                function markModified(row) {
                    if (!userPermission.value.canWrite) return;
                    row.isModified = true;
                    scheduleDraftSave();
                }

                function addNewRow() {
                    if (!userPermission.value.isOwner) {
                        showToast('Chỉ Người sở hữu Tổ chức mới có quyền thêm học sinh mới!', 'error');
                        return;
                    }

                    students.value.push({
                        tempId: Date.now(),
                        studentCode: `HS${Math.floor(1000 + Math.random() * 9000)}`,
                        name: '',
                        dateOfBirth: '',
                        phone: '',
                        email: '',
                        parentPhone: '',
                        parentEmail: '',
                        conductScore: 100,
                        conductDeductionReason: '',
                        isModified: true,
                        isNew: true
                    });
                    scheduleDraftSave();
                }

                async function deleteRow(index, row) {
                    if (!userPermission.value.isOwner) {
                        showToast('Chỉ Người sở hữu Tổ chức mới có quyền xóa học sinh!', 'error');
                        return;
                    }

                    if (row.isNew) {
                        students.value.splice(index, 1);
                        scheduleDraftSave();
                        return;
                    }

                    if (!confirm(`Bạn có chắc muốn xóa học sinh "${row.name || row.studentCode}" khỏi bảng tính?`)) return;

                    try {
                        const headers = getTokenHeader();
                        const res = await fetch(`/api/organization/students/${row.id}`, {
                            method: 'DELETE',
                            headers
                        });

                        if (res.ok) {
                            students.value.splice(index, 1);
                            scheduleDraftSave();
                            showToast('Đã xóa học sinh khỏi bảng tính');
                        } else {
                            showToast('Không thể xóa học sinh', 'error');
                        }
                    } catch (e) {
                        showToast('Lỗi kết nối máy chủ', 'error');
                    }
                }

                async function saveAllChanges() {
                    if (!userPermission.value.canWrite) {
                        showToast('Tài khoản của bạn không có quyền lưu thay đổi ở lớp này!', 'error');
                        return;
                    }

                    const modifiedRows = students.value.filter(s => s.isModified || s.isNew);
                    if (modifiedRows.length === 0) {
                        showToast('Không có thay đổi nào cần lưu!');
                        return;
                    }

                    const invalidRow = modifiedRows.find(s => !s.name || !s.name.trim());
                    if (invalidRow) {
                        showToast('Vui lòng nhập Họ và Tên cho tất cả học sinh được chỉnh sửa!', 'error');
                        return;
                    }

                    saving.value = true;
                    const classId = getClassIdFromUrl();

                    try {
                        const headers = { ...getTokenHeader(), 'Content-Type': 'application/json' };
                        const creates = [];
                        const updates = [];

                        for (const row of modifiedRows) {
                            if (row.isNew) {
                                creates.push({
                                    studentCode: row.studentCode,
                                    name: row.name,
                                    dateOfBirth: row.dateOfBirth,
                                    phone: row.phone,
                                    email: row.email,
                                    parentPhone: row.parentPhone,
                                    parentEmail: row.parentEmail,
                                    conductScore: row.conductScore,
                                    conductDeductionReason: row.conductDeductionReason
                                });
                            } else {
                                const payload = userPermission.value.isOwner
                                    ? {
                                        id: row.id,
                                        studentCode: row.studentCode,
                                        name: row.name,
                                        dateOfBirth: row.dateOfBirth,
                                        phone: row.phone,
                                        email: row.email,
                                        parentPhone: row.parentPhone,
                                        parentEmail: row.parentEmail,
                                        conductScore: row.conductScore,
                                        conductDeductionReason: row.conductDeductionReason
                                    }
                                    : {
                                        id: row.id,
                                        conductScore: row.conductScore,
                                        conductDeductionReason: row.conductDeductionReason
                                    };
                                updates.push(payload);
                            }
                        }

                        // Atomic Batch Save in 1 transaction
                        const res = await fetch(`/api/organization/classes/${classId}/students/batch`, {
                            method: 'POST',
                            headers,
                            body: JSON.stringify({ creates, updates, deletes: [] })
                        });

                        const data = await res.json();
                        if (!res.ok) {
                            throw new Error(data.message || 'Lỗi khi lưu dữ liệu lên máy chủ');
                        }

                        // Clear draft on successful batch save
                        localStorage.removeItem('draft_class_' + classId);
                        lastDraftSavedTime.value = '';
                        remoteUpdateDetected.value = false;

                        showToast(`Đã lưu đồng bộ ${creates.length + updates.length} học sinh thành công!`);
                        await fetchStudents();
                    } catch (e) {
                        showToast(e.message || 'Lỗi khi lưu dữ liệu lên máy chủ', 'error');
                    } finally {
                        saving.value = false;
                    }
                }

                function exportCsv() {
                    if (students.value.length === 0) {
                        showToast('Không có dữ liệu để xuất CSV!', 'error');
                        return;
                    }

                    let csvContent = "data:text/csv;charset=utf-8,STT,Mã Học Sinh,Họ và Tên,Ngày Sinh,SĐT Học Sinh,Email Học Sinh,SĐT Phụ Huynh,Email Phụ Huynh,Điểm Hạnh Kiểm\n";

                    students.value.forEach((st, idx) => {
                        const row = [
                            idx + 1,
                            st.studentCode || '',
                            `"${st.name || ''}"`,
                            st.dateOfBirth || '',
                            st.phone || '',
                            st.email || '',
                            st.parentPhone || '',
                            st.parentEmail || '',
                            st.conductScore ?? 100
                        ].join(",");
                        csvContent += row + "\n";
                    });

                    const encodedUri = encodeURI(csvContent);
                    const link = document.createElement("a");
                    link.setAttribute("href", encodedUri);
                    link.setAttribute("download", `Danh_Sach_Hoc_Sinh_Lop_${currentClass.value?.name || 'Class'}.csv`);
                    document.body.appendChild(link);
                    link.click();
                    document.body.removeChild(link);
                }

                // Gemini Chatbot Integration
                function onAiFileSelected(event) {
                    const file = event.target.files[0];
                    if (!file) return;
                    if (file.size > 5 * 1024 * 1024) {
                        showToast('Dung lượng file quá lớn (tối đa 5MB)', 'error');
                        event.target.value = '';
                        return;
                    }
                    aiAttachedFile.value = file;
                }

                function removeAiFile() {
                    aiAttachedFile.value = null;
                }

                function readFileAsBase64(file) {
                    return new Promise((resolve, reject) => {
                        const reader = new FileReader();
                        reader.onload = () => resolve(reader.result.split(',')[1]);
                        reader.onerror = error => reject(error);
                        reader.readAsDataURL(file);
                    });
                }

                async function sendChatMessage() {
                    const promptText = aiPrompt.value.trim();
                    if (!promptText && !aiAttachedFile.value) return;

                    let fileData = null;
                    if (aiAttachedFile.value) {
                        const base64Data = await readFileAsBase64(aiAttachedFile.value);
                        fileData = {
                            mimeType: aiAttachedFile.value.type,
                            data: base64Data
                        };
                    }

                    chatMessages.value.push({ 
                        role: 'user', 
                        text: promptText,
                        fileName: aiAttachedFile.value ? aiAttachedFile.value.name : null
                    });

                    aiPrompt.value = '';
                    aiAttachedFile.value = null;
                    parsingAi.value = true;

                    try {
                        const headers = { ...getTokenHeader(), 'Content-Type': 'application/json' };
                        const res = await fetch('/api/ai/parse-intent', {
                            method: 'POST',
                            headers,
                            body: JSON.stringify({ prompt: promptText, classId: getClassIdFromUrl(), fileData })
                        });

                        const data = await res.json();
                        if (res.ok) {
                            if (data.debugMode !== undefined) debugMode.value = Boolean(data.debugMode);
                            isGeminiPowered.value = Boolean(data.isGeminiPowered);
                            const hasCode = Boolean(data.code && data.code.trim());
                            const hasActions = (Array.isArray(data.actions) && data.actions.length > 0) || hasCode;

                            chatMessages.value.push({
                                role: 'assistant',
                                text: data.reply || data.summary || 'Đã phân tích yêu cầu của bạn.',
                                thought: data.thought || null,
                                hasActions,
                                actionsCount: (data.actions && data.actions.length) || (hasCode ? 1 : 0),
                                plan: { ...data, prompt: promptText }
                            });

                            if (hasActions) {
                                proposedPlan.value = { ...data, prompt: promptText };
                                showAiPreviewModal.value = true;
                            }
                        } else {
                            chatMessages.value.push({
                                role: 'assistant',
                                text: data.message || 'Lỗi xử lý câu lệnh AI.'
                            });
                        }
                    } catch (e) {
                        chatMessages.value.push({
                            role: 'assistant',
                            text: 'Lỗi kết nối tới máy chủ Gemini AI.'
                        });
                    } finally {
                        parsingAi.value = false;
                    }
                }

                function openPreviewFromChat(msg) {
                    if (msg.plan) {
                        proposedPlan.value = msg.plan;
                        showAiPreviewModal.value = true;
                    }
                }

                async function confirmExecuteServerPlan() {
                    const hasActions = (proposedPlan.value.actions && proposedPlan.value.actions.length > 0);
                    const hasCode = Boolean(proposedPlan.value.code && proposedPlan.value.code.trim());
                    if (!hasActions && !hasCode) return;

                    executingAi.value = true;
                    try {
                        const headers = { ...getTokenHeader(), 'Content-Type': 'application/json' };
                        const res = await fetch('/api/ai/execute-plan', {
                            method: 'POST',
                            headers,
                            body: JSON.stringify({
                                planActions: proposedPlan.value.actions || [],
                                code: proposedPlan.value.code || null,
                                prompt: proposedPlan.value.prompt || '',
                                classId: getClassIdFromUrl()
                            })
                        });

                        const data = await res.json();
                        if (res.ok) {
                            showToast('Server AI đã thực thi kịch bản thành công!');
                            showAiPreviewModal.value = false;

                            // Reflect Agent feedback and sandbox execution output in chat
                            chatMessages.value.push({
                                role: 'assistant',
                                text: data.agentReply || 'Đã hoàn tất thực thi kịch bản trên máy chủ.',
                                thought: data.agentThought || null,
                                executionLogs: data.logs && data.logs.length ? data.logs : null,
                                hasActions: false
                            });

                            await fetchStudents();
                        } else {
                            showToast(data.message || 'Server thực thi kịch bản thất bại', 'error');
                        }
                    } catch (e) {
                        showToast('Lỗi kết nối máy chủ AI', 'error');
                    } finally {
                        executingAi.value = false;
                    }
                }

                const refreshIcons = () => {
                    nextTick(() => {
                        if (window.lucide && window.lucide.createIcons) {
                            window.lucide.createIcons();
                        }
                    });
                };

                watch([students, searchQuery, showAiDrawer, showAiPreviewModal, showDeductModal, showAuditLogsModal, chatMessages, debugMode, toast], () => {
                    refreshIcons();
                }, { deep: true });

                onUpdated(() => {
                    refreshIcons();
                });

                onMounted(() => {
                    fetchStudents();
                    initRealtimeSync();
                    window.addEventListener('beforeunload', handleBeforeUnload);
                    refreshIcons();
                });

                onUnmounted(() => {
                    if (sseEventSource) {
                        sseEventSource.close();
                    }
                    window.removeEventListener('beforeunload', handleBeforeUnload);
                });

                return {
                    user,
                    userPermission,
                    loading,
                    saving,
                    currentClass,
                    students,
                    searchQuery,
                    filteredStudents,
                    toast,
                    displayName,
                    modifiedCount,
                    debugMode,
                    sseConnected,
                    remoteUpdateDetected,
                    remoteUpdateMessage,
                    showDraftRecoveryPrompt,
                    draftItemCount,
                    lastDraftSavedTime,
                    restoreDraft,
                    discardDraft,
                    dismissRemoteBanner,
                    forceSyncWithServer,
                    showAiDrawer,
                    showAiPreviewModal,
                    aiPrompt,
                    aiAttachedFile,
                    parsingAi,
                    executingAi,
                    isGeminiPowered,
                    chatMessages,
                    proposedPlan,
                    sendChatMessage,
                    openPreviewFromChat,
                    confirmExecuteServerPlan,
                    fetchStudents,
                    markModified,
                    addNewRow,
                    deleteRow,
                    saveAllChanges,
                    exportCsv,
                    showAuditLogsModal,
                    auditLogs,
                    loadingAuditLogs,
                    openAuditLogsModal,
                    formatDate,
                    showDeductModal,
                    targetDeductStudent,
                    deductPoints,
                    deductReason,
                    openDeductModal,
                    confirmDeduction,
                    classAuditLogs,
                    getStudentDeductionHistory,
                    onAiFileSelected,
                    removeAiFile
                };
            }
        }).mount('#app');
    </script>
</body>

</html>
