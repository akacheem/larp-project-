                    </button>
                    <button @click="confirmDeduction" class="px-5 py-2 bg-[#ff9500] hover:bg-[#e08500] text-white text-xs font-medium rounded-full transition flex items-center space-x-1.5 shadow-sm active:scale-[0.98]">
                        <i data-lucide="check" class="w-3.5 h-3.5"></i>
                        <span>Xác nhận Trừ điểm</span>
                    </button>
                </div>
            </div>
        </div>

        <!-- Google Sheets Style Version History Modal -->
        <div v-if="showAuditLogsModal" v-cloak class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/40 backdrop-blur-md">
            <div class="bg-white border border-black/[0.08] rounded-[36px] max-w-4xl w-full p-6 shadow-[0_24px_70px_rgba(0,0,0,0.18)] flex flex-col max-h-[85vh]">
                <div class="flex items-center justify-between pb-4 border-b border-black/[0.06]">
                    <div class="flex items-center space-x-3">
                        <div class="w-10 h-10 rounded-full bg-[#0071e3]/10 text-[#0071e3] border border-[#0071e3]/20 flex items-center justify-center font-bold">
                            <i data-lucide="history" class="w-5 h-5"></i>
                        </div>
                        <div>
                            <h3 class="text-sm font-semibold text-[#1d1d1f] flex items-center gap-2">
                                <span>Lịch sử Phiên bản & Nhật ký Thay đổi</span>
                                <span class="px-2.5 py-0.5 text-[10px] bg-black/[0.04] text-[#86868b] rounded-full border border-black/[0.06]">Google Sheets Style</span>
                            </h3>
                            <p class="text-xs text-[#86868b]">Lịch sử chỉnh sửa dữ liệu, phân biệt giữa Người dùng và AI Agent</p>
                        </div>
                    </div>
                    <button @click="showAuditLogsModal = false" class="w-7 h-7 rounded-full hover:bg-black/[0.05] text-[#86868b] hover:text-[#1d1d1f] flex items-center justify-center transition">
                        <i data-lucide="x" class="w-4 h-4"></i>
                    </button>
                </div>

                <div class="flex-1 overflow-y-auto py-4 space-y-3">
