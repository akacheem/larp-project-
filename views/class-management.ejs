                </div>

                <div class="flex justify-end space-x-2 pt-2 border-t border-black/[0.06]">
                    <button @click="showCloseConfirmModal = false" :disabled="closingMonthlyConduct" class="px-4 py-2 bg-black/[0.04] hover:bg-black/[0.08] text-[#1d1d1f] text-xs font-medium rounded-full transition">
                        Hủy
                    </button>
                    <button @click="confirmCloseMonthlyConduct" :disabled="closingMonthlyConduct" class="px-5 py-2 bg-[#34c759] hover:bg-[#2fb34f] text-white text-xs font-medium rounded-full transition flex items-center space-x-1.5 shadow-sm active:scale-[0.98]">
                        <i v-if="closingMonthlyConduct" data-lucide="loader-2" class="w-3.5 h-3.5 animate-spin"></i>
                        <i v-else data-lucide="check" class="w-3.5 h-3.5"></i>
                        <span>Đồng ý Chốt Sổ & Reset</span>
                    </button>
                </div>
            </div>
        </div>

        <!-- Term Summary Modal (Tổng kết Học kỳ I, Học kỳ II, Cả năm) -->
        <div v-if="showTermSummaryModal" v-cloak class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/50 backdrop-blur-md">
            <div class="bg-white border border-black/[0.08] rounded-[36px] max-w-6xl w-full p-6 shadow-[0_24px_70px_rgba(0,0,0,0.2)] flex flex-col max-h-[92vh]">
                <!-- Modal Header -->
                <div class="flex items-center justify-between pb-4 border-b border-black/[0.06]">
                    <div class="flex items-center space-x-3.5">
                        <div class="w-11 h-11 rounded-2xl bg-[#7c3aed]/10 text-[#7c3aed] border border-[#7c3aed]/20 flex items-center justify-center font-bold shadow-xs">
                            <i data-lucide="calendar-range" class="w-6 h-6"></i>
                        </div>
                        <div>
                            <h3 class="text-base font-bold text-[#1d1d1f] flex items-center gap-2">
                                <span>BẢNG TỔNG KẾT HẠNH KIỂM — LỚP {{ currentClass?.name }}</span>
                                <span class="px-3 py-0.5 text-xs font-semibold rounded-full bg-[#7c3aed]/10 text-[#7c3aed] border border-[#7c3aed]/20">
                                    {{ activeTermType === 'sem1' ? 'Học kỳ I' : activeTermType === 'sem2' ? 'Học kỳ II' : 'Cả Năm Học' }}
                                </span>
                            </h3>
                            <p class="text-xs text-[#86868b]">
                                Xem điểm chi tiết theo từng tháng và thống kê số tháng xếp loại Tốt của từng học sinh
                            </p>
                        </div>
                    </div>

                    <div class="flex items-center space-x-3">
                        <!-- Term Switcher Tabs -->
                        <div class="flex items-center bg-[#f5f5f7] p-1 rounded-full border border-black/[0.06]">
                            <button @click="switchTermType('sem1')" :class="activeTermType === 'sem1' ? 'bg-white text-[#7c3aed] shadow-xs font-bold' : 'text-[#86868b] hover:text-[#1d1d1f] font-medium'" class="px-3.5 py-1.5 rounded-full text-xs transition">
                                Học kỳ I
                            </button>
                            <button @click="switchTermType('sem2')" :class="activeTermType === 'sem2' ? 'bg-white text-[#7c3aed] shadow-xs font-bold' : 'text-[#86868b] hover:text-[#1d1d1f] font-medium'" class="px-3.5 py-1.5 rounded-full text-xs transition">
                                Học kỳ II
                            </button>
                            <button @click="switchTermType('year')" :class="activeTermType === 'year' ? 'bg-white text-[#15803d] shadow-xs font-bold' : 'text-[#86868b] hover:text-[#1d1d1f] font-medium'" class="px-3.5 py-1.5 rounded-full text-xs transition">
                                Cả Năm (Tất cả tháng)
                            </button>
                        </div>

                        <button @click="showTermSummaryModal = false" class="w-9 h-9 rounded-full hover:bg-black/[0.05] text-[#86868b] hover:text-[#1d1d1f] flex items-center justify-center transition">
                            <i data-lucide="x" class="w-5 h-5"></i>
                        </button>
                    </div>
                </div>

                <!-- Custom Month Selection Filter for Semester I & II -->
                <div v-if="activeTermType !== 'year'" class="mt-3.5 p-3.5 bg-[#f8fafc] border border-black/[0.06] rounded-2xl flex flex-wrap items-center justify-between gap-3 text-xs">
                    <div class="flex items-center gap-2">
                        <span class="font-semibold text-[#1d1d1f] flex items-center gap-1.5">
                            <i data-lucide="check-square" class="w-4 h-4 text-[#7c3aed]"></i>
                            <span>Chọn các tháng gộp vào {{ activeTermType === 'sem1' ? 'Học kỳ I' : 'Học kỳ II' }}:</span>
                        </span>
                        <div v-if="closedPeriodsList.length === 0" class="text-[#86868b] italic">
                            (Chưa có tháng nào được chốt sổ. Hãy dùng nút "Tổng kết Tháng" để chốt sổ các tháng trước.)
                        </div>
                        <div v-else class="flex flex-wrap items-center gap-2">
                            <label v-for="p in closedPeriodsList" :key="p.year + '-' + p.month" class="flex items-center space-x-1.5 px-2.5 py-1 rounded-xl border cursor-pointer transition select-none" :class="selectedTermPeriodKeys.includes(p.year + '-' + p.month) ? 'bg-[#7c3aed]/10 border-[#7c3aed]/30 text-[#7c3aed] font-semibold' : 'bg-white border-black/[0.08] text-[#86868b] hover:bg-black/[0.02]'">
                                <input type="checkbox" :value="p.year + '-' + p.month" v-model="selectedTermPeriodKeys" @change="fetchTermSummaryData" class="rounded text-[#7c3aed] focus:ring-0">
                                <span>{{ p.monthLabel }}</span>
                            </label>
                        </div>
                    </div>
                    <div class="text-[11px] text-[#86868b]">
                        Đã chọn <strong>{{ selectedTermPeriodKeys.length }}</strong> tháng
                    </div>
                </div>

                <div v-else class="mt-3.5 p-3 bg-[#34c759]/10 border border-[#34c759]/20 rounded-2xl text-xs text-[#15803d] flex items-center justify-between">
                    <span class="flex items-center gap-1.5 font-medium">
                        <i data-lucide="sparkles" class="w-4 h-4 text-[#34c759]"></i>
                        <span>Tổng kết Cả Năm: Mặc định nối và hiển thị toàn bộ tất cả <strong>{{ closedPeriodsList.length }} tháng</strong> đã chốt của cả năm học.</span>
                    </span>
                </div>

                <!-- Table Content Container -->
                <div class="flex-1 overflow-auto border border-black/[0.08] rounded-2xl mt-4">
                    <div v-if="loadingTermSummary" class="text-center py-20 text-[#86868b]">
                        <i data-lucide="loader-2" class="w-7 h-7 animate-spin mb-2 text-[#7c3aed] mx-auto"></i>
                        <p class="text-xs">Đang tổng hợp dữ liệu học kỳ...</p>
                    </div>

                    <div v-else-if="!termSummaryData.students || termSummaryData.students.length === 0" class="text-center py-20 text-[#86868b]">
                        <i data-lucide="calendar-x" class="w-9 h-9 mb-2 text-[#86868b] mx-auto opacity-40"></i>
                        <p class="text-xs">Không tìm thấy dữ liệu học sinh hoặc các tháng đã chọn</p>
                    </div>

                    <!-- Excel-like Term Evaluation Table (Inspired by Teacher Worksheet) -->
                    <table v-else class="w-full text-left text-xs border-collapse font-sans">
                        <thead class="bg-[#f8fafc] border-b-2 border-black/[0.1] sticky top-0 z-10 text-[11px] font-bold text-[#1d1d1f]">
                            <!-- Row 1 Header: Stt, Họ Tên, Các Cột Tháng, Thống kê -->
                            <tr class="divide-x divide-black/[0.08]">
                                <th class="p-2.5 text-center w-12 bg-[#f1f5f9]">STT</th>
                                <th class="p-2.5 w-24 bg-[#f1f5f9]">Mã HS</th>
                                <th class="p-2.5 w-52 bg-[#f1f5f9]">Họ và Tên Học Sinh</th>

                                <!-- Dynamic Month Columns on Top Header -->
                                <th v-for="col in termSummaryData.monthColumns" :key="col.key" class="p-2.5 text-center min-w-[100px] bg-[#f8fafc] text-[#7c3aed]">
                                    <div class="text-[12px] font-bold">{{ col.label }}</div>
                                    <div class="text-[10px] text-[#86868b] font-normal">Điểm (Loại)</div>
                                </th>

                                <th v-if="termSummaryData.monthColumns.length === 0" class="p-2.5 text-center text-[#86868b] italic">
                                    Chưa có tháng nào được chọn
                                </th>

                                <!-- Summary Statistics Column -->
                                <th class="p-2.5 text-center w-36 bg-[#ecfdf5] text-[#15803d]">
                                    <div class="text-[12px] font-bold">Số Tháng Tốt</div>
                                    <div class="text-[10px] text-[#15803d]/70 font-normal">≥ 90 điểm</div>
                                </th>
                                <th class="p-2.5 text-center w-36 bg-[#f1f5f9] text-[#1d1d1f]">
                                    <div class="text-[12px] font-bold">Khác (Khá/Đạt/CĐ)</div>
                                    <div class="text-[10px] text-[#86868b] font-normal">&lt; 90 điểm</div>
                                </th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-black/[0.06]">
                            <tr v-for="(st, idx) in termSummaryData.students" :key="st.studentId || idx" class="hover:bg-black/[0.015] divide-x divide-black/[0.06] transition">
                                <td class="p-2.5 text-center font-mono text-[#86868b] font-medium">{{ idx + 1 }}</td>
                                <td class="p-2.5 font-mono text-[#86868b]">{{ st.studentCode || '—' }}</td>
                                <td class="p-2.5 font-semibold text-[#1d1d1f] whitespace-nowrap">{{ st.studentName }}</td>

                                <!-- Monthly Scores & Conduct Ranks -->
                                <td v-for="col in termSummaryData.monthColumns" :key="col.key" class="p-2.5 text-center font-mono">
                                    <div v-if="st.monthScores && st.monthScores[col.key]" class="flex flex-col items-center">
                                        <span class="font-bold text-sm" :class="st.monthScores[col.key].score >= 90 ? 'text-[#15803d]' : st.monthScores[col.key].score >= 80 ? 'text-[#0071e3]' : st.monthScores[col.key].score >= 70 ? 'text-[#d97706]' : 'text-[#b91c1c]'">
                                            {{ st.monthScores[col.key].score }}
                                        </span>
                                        <span :class="getRankBadgeClass(st.monthScores[col.key].rank)" class="px-2 py-0.2 text-[9px] font-bold rounded-full border mt-0.5">
                                            {{ st.monthScores[col.key].rank }}
                                        </span>
                                    </div>
                                    <span v-else class="text-[#86868b] text-[11px]">—</span>
                                </td>

                                <td v-if="termSummaryData.monthColumns.length === 0" class="p-2.5 text-center text-[#86868b]">
                                    —
                                </td>

                                <!-- Stat 1: Số tháng Tốt -->
                                <td class="p-2.5 text-center font-mono bg-[#ecfdf5]/40">
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-[#34c759]/15 text-[#15803d] border border-[#34c759]/30">
                                        {{ st.goodCount }} / {{ termSummaryData.monthColumns.length }}
                                    </span>
                                </td>

                                <!-- Stat 2: Khác -->
                                <td class="p-2.5 text-center font-mono text-xs text-[#86868b]">
                                    {{ st.fairCount + st.passCount + st.failCount }} tháng
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <!-- Footer Actions -->
                <div class="flex items-center justify-between pt-4 border-t border-black/[0.06] mt-4">
                    <button @click="exportTermSummaryCsv" class="px-5 py-2.5 bg-[#7c3aed] hover:bg-[#6d28d9] text-white rounded-full text-xs font-semibold transition flex items-center space-x-2 shadow-sm active:scale-[0.98]">
                        <i data-lucide="file-spreadsheet" class="w-4 h-4"></i>
                        <span>Xuất CSV Bảng Điểm Kỳ & Cả Năm</span>
                    </button>

                    <button @click="showTermSummaryModal = false" class="px-5 py-2.5 bg-black/[0.05] hover:bg-black/[0.09] text-[#1d1d1f] rounded-full text-xs font-medium transition">
                        Đóng
                    </button>
                </div>
            </div>
        </div>

        <!-- Toast Feedback Notification -->
        <div v-if="toast.show" v-cloak :class="toast.type === 'error' ? 'bg-white text-[#1d1d1f] border-[#ff3b30]/30 shadow-[0_8px_30px_rgba(255,59,48,0.15)]' : 'bg-white text-[#1d1d1f] border-[#34c759]/30 shadow-[0_8px_30px_rgba(52,199,89,0.15)]'" class="fixed bottom-6 left-6 px-4 py-2.5 rounded-full border text-xs font-medium flex items-center space-x-2.5 z-50 backdrop-blur-xl transition-all">
            <i v-if="toast.type === 'error'" data-lucide="alert-circle" class="w-4 h-4 text-[#ff3b30]"></i>
            <i v-else data-lucide="check-circle-2" class="w-4 h-4 text-[#34c759]"></i>
            <span>{{ toast.message }}</span>
        </div>
    </div>

    <script type="module">
        import { getAuthToken, clientLogout } from "/public/clientAuth.js";

        const { createApp, ref, computed, onMounted, onUnmounted, onUpdated, nextTick, watch } = Vue;

        createApp({
            setup() {
                const user = ref(null);
                const loading = ref(true);
                const saving = ref(false);
                const currentClass = ref(null);
                const students = ref([]);
                const searchQuery = ref('');

                // Real-time SSE & Local Draft State
                const sseConnected = ref(false);
                const remoteUpdateDetected = ref(false);
                const remoteUpdateMessage = ref('');
                const showDraftRecoveryPrompt = ref(false);
                const draftItemCount = ref(0);
                const lastDraftSavedTime = ref('');
                let sseEventSource = null;
                let draftDebounceTimer = null;

                // Gemini AI Chatbot & Debug State
                const debugMode = ref(false);
                const showAiDrawer = ref(false);
                const showAiPreviewModal = ref(false);
                const aiPrompt = ref('');
                const aiAttachedFile = ref(null);
                const parsingAi = ref(false);
                const executingAi = ref(false);
                const isGeminiPowered = ref(false);
                const proposedPlan = ref({ summary: '', code: '', actions: [] });

                // Conduct Deduction Popup Modal State
                const showDeductModal = ref(false);
                const targetDeductStudent = ref(null);
                const deductPoints = ref(5);
                const deductReason = ref('');

                function openDeductModal(row) {
                    if (!userPermission.value.canWrite) {
                        showToast('Bạn không có quyền trừ điểm hạnh kiểm ở lớp này!', 'error');
                        return;
                    }
                    targetDeductStudent.value = row;
                    deductPoints.value = 5;
                    deductReason.value = row.conductDeductionReason || '';
                    showDeductModal.value = true;
                }

                async function confirmDeduction() {
                    if (!targetDeductStudent.value) return;
                    if (!deductReason.value.trim()) {
                        showToast('Vui lòng nhập lý do trừ điểm hạnh kiểm!', 'error');
                        return;
                    }

                    const pts = Number(deductPoints.value) || 0;
                    const reason = deductReason.value.trim();
                    const studentId = targetDeductStudent.value.id;

                    try {
                        const headers = { ...getTokenHeader(), 'Content-Type': 'application/json' };
                        const res = await fetch(`/api/organization/students/${studentId}/deduct`, {
                            method: 'POST',
                            headers,
                            body: JSON.stringify({ points: pts, reason })
                        });

                        const data = await res.json();
                        if (res.ok) {
                            showToast(`Đã trừ ${pts} điểm hạnh kiểm của ${targetDeductStudent.value.name}!`);
                            showDeductModal.value = false;
                            await fetchStudents();
                        } else {
                            showToast(data.message || 'Không thể trừ điểm hạnh kiểm', 'error');
                        }
                    } catch (e) {
                        showToast('Lỗi kết nối máy chủ khi trừ điểm', 'error');
                    }
                }

                // Audit Logs / Version History State
                const showAuditLogsModal = ref(false);
                const auditLogs = ref([]);
                const loadingAuditLogs = ref(false);

                async function openAuditLogsModal() {
                    showAuditLogsModal.value = true;
                    loadingAuditLogs.value = true;
                    try {
                        const headers = getTokenHeader();
                        const classId = getClassIdFromUrl();
                        const res = await fetch(`/api/organization/audit-logs?classId=${classId}`, { headers });
                        if (res.ok) {
                            const data = await res.json();
                            auditLogs.value = data.auditLogs || [];
                        } else {
                            showToast('Không thể tải lịch sử phiên bản', 'error');
                        }
                    } catch (e) {
                        showToast('Lỗi kết nối máy chủ', 'error');
                    } finally {
                        loadingAuditLogs.value = false;
                    }
                }

                function formatDate(isoStr) {
                    if (!isoStr) return '';
                    const d = new Date(isoStr);
                    return d.toLocaleString('vi-VN');
                }

                function getStudentDeductionHistory(studentId) {
                    if (!studentId) return [];
                    return classAuditLogs.value.filter(log => {
                        const isStudentEntity = (log.entityType === 'student' && Number(log.entityId) === Number(studentId));
                        const isDeductAction = log.action === 'DEDUCT_CONDUCT_SCORE' || log.action === 'UPDATE_STUDENT';
                        const hasScoreDecrease = log.diffs && log.diffs.some(d => d.field === 'conductScore' || d.field === 'conductDeductionReason');
                        return isStudentEntity && (isDeductAction || hasScoreDecrease);
                    });
                }

                const chatMessages = ref([
                    {
                        role: 'assistant',
                        text: 'Xin chào! Tôi là Gemini AI Chatbot. Bạn có thể yêu cầu tôi thêm học sinh, cập nhật hoặc tạo lớp học.'
                    }
                ]);

                const toast = ref({ show: false, message: '', type: 'success' });
                function showToast(msg, type = 'success') {
                    toast.value = { show: true, message: msg, type };
                    setTimeout(() => { toast.value.show = false; }, 3500);
                }

                function getTokenHeader() {
                    try {
                        const tok = getAuthToken();
                        return tok ? { 'Authorization': `Bearer ${tok}` } : {};
                    } catch {
                        return {};
                    }
                }

                const userPermission = ref({ canWrite: true, isOwner: true });

                const displayName = computed(() => user.value?.name || 'Tổ chức');
                const modifiedCount = computed(() => students.value.filter(s => s.isModified || s.isNew).length);

                const filteredStudents = computed(() => {
                    if (!searchQuery.value.trim()) return students.value;
                    const q = searchQuery.value.toLowerCase().trim();
                    return students.value.filter(s =>
                        (s.name && s.name.toLowerCase().includes(q)) ||
                        (s.studentCode && s.studentCode.toLowerCase().includes(q)) ||
                        (s.phone && s.phone.includes(q)) ||
                        (s.email && s.email.toLowerCase().includes(q))
                    );
                });

                function getClassIdFromUrl() {
                    const parts = window.location.pathname.split('/').filter(Boolean);
                    const id = parts[parts.length - 1];
                    if (id && !isNaN(Number(id))) {
                        return Number(id);
                    }
                    window.location.href = '/dashboard';
                    return null;
                }

                const classAuditLogs = ref([]);

                async function fetchStudents() {
                    const classId = getClassIdFromUrl();
                    if (!classId) return;
                    loading.value = true;
                    try {
                        const headers = getTokenHeader();
                        const [dashRes, stdRes, auditRes] = await Promise.all([
                            fetch('/api/organization/dashboard', { headers }),
                            fetch(`/api/organization/classes/${classId}/students`, { headers }),
                            fetch(`/api/organization/audit-logs?classId=${classId}`, { headers })
                        ]);

                        if (dashRes.ok) {
                            const dashData = await dashRes.json();
                            user.value = dashData.user;
                            debugMode.value = Boolean(dashData.debugMode);
                            currentClass.value = (dashData.classes || []).find(c => c.id === classId) || { id: classId, name: `Lớp #${classId}` };
                        }

                        if (stdRes.ok) {
                            const stdData = await stdRes.json();
                            students.value = (stdData.students || []).map(s => ({
                                ...s,
                                isModified: false,
                                isNew: false
                            }));
                            if (stdData.userPermission) {
                                userPermission.value = stdData.userPermission;
                            }
                            checkLocalDraft();
                        }

                        if (auditRes.ok) {
                            const auditData = await auditRes.json();
                            classAuditLogs.value = auditData.auditLogs || [];
                        }
                    } catch (e) {
                        showToast('Lỗi tải dữ liệu lớp học', 'error');
                    } finally {
                        loading.value = false;
                        nextTick(() => { refreshIcons(); });
                    }
                }

                // --- LOCAL DRAFT AUTO-SAVE & RECOVERY ---
                function scheduleDraftSave() {
                    clearTimeout(draftDebounceTimer);
                    draftDebounceTimer = setTimeout(() => {
                        saveDraftToStorage();
                    }, 600);
                }

                function saveDraftToStorage() {
                    const classId = getClassIdFromUrl();
                    if (!classId) return;
                    const dirtyRows = students.value.filter(s => s.isModified || s.isNew);
                    if (dirtyRows.length > 0) {
                        try {
                            localStorage.setItem('draft_class_' + classId, JSON.stringify({
                                timestamp: Date.now(),
                                rows: dirtyRows
                            }));
                            const now = new Date();
                            lastDraftSavedTime.value = `${now.getHours().toString().padStart(2, '0')}:${now.getMinutes().toString().padStart(2, '0')}:${now.getSeconds().toString().padStart(2, '0')}`;
                        } catch {}
                    } else {
                        localStorage.removeItem('draft_class_' + classId);
                        lastDraftSavedTime.value = '';
                    }
                }

                function checkLocalDraft() {
                    const classId = getClassIdFromUrl();
                    if (!classId) return;
                    try {
                        const raw = localStorage.getItem('draft_class_' + classId);
                        if (!raw) return;
                        const parsed = JSON.parse(raw);
                        if (parsed && Array.isArray(parsed.rows) && parsed.rows.length > 0) {
                            draftItemCount.value = parsed.rows.length;
                            showDraftRecoveryPrompt.value = true;
                        }
                    } catch {}
                }

                function restoreDraft() {
                    const classId = getClassIdFromUrl();
                    try {
                        const raw = localStorage.getItem('draft_class_' + classId);
                        if (!raw) return;
                        const parsed = JSON.parse(raw);
                        const draftRows = parsed.rows || [];

                        for (const d of draftRows) {
                            if (d.isNew) {
                                students.value.push({ ...d, isModified: true, isNew: true });
                            } else {
                                const idx = students.value.findIndex(s => s.id === d.id);
                                if (idx !== -1) {
                                    students.value[idx] = { ...students.value[idx], ...d, isModified: true };
                                }
                            }
                        }
                        showDraftRecoveryPrompt.value = false;
                        showToast(`Đã khôi phục ${draftRows.length} thay đổi từ bản nháp!`);
                        nextTick(() => { refreshIcons(); });
                    } catch {
                        showToast('Không thể khôi phục bản nháp', 'error');
                    }
                }

                function discardDraft() {
                    const classId = getClassIdFromUrl();
                    localStorage.removeItem('draft_class_' + classId);
                    showDraftRecoveryPrompt.value = false;
                    showToast('Đã xóa bỏ bản nháp tạm.');
                }

                const handleBeforeUnload = (e) => {
                    if (modifiedCount.value > 0) {
                        e.preventDefault();
                        e.returnValue = 'Bạn có thay đổi chưa lưu trên bảng tính. Bạn có chắc muốn rời đi?';
                        return e.returnValue;
                    }
                };

                // Watch students deeply to trigger auto-draft
                watch(students, () => {
                    scheduleDraftSave();
                }, { deep: true });

                // --- REAL-TIME SSE SYNCHRONIZATION ---
                function initRealtimeSync() {
                    const classId = getClassIdFromUrl();
                    if (!classId) return;

                    let token = '';
                    try { token = getAuthToken(); } catch {}
                    if (!token) return;

                    if (sseEventSource) {
                        sseEventSource.close();
                    }

                    const sseUrl = `/api/organization/sync-events?classId=${classId}&token=${encodeURIComponent(token)}`;
                    sseEventSource = new EventSource(sseUrl);

                    sseEventSource.addEventListener('connected', () => {
                        sseConnected.value = true;
                    });

                    sseEventSource.addEventListener('sync', async (event) => {
                        try {
                            const ev = JSON.parse(event.data);
                            if (user.value && ev.senderUserId && ev.senderUserId === user.value.id) {
                                return;
                            }
                            if (ev.classId && Number(ev.classId) !== Number(classId)) {
                                return;
                            }

                            if (modifiedCount.value === 0) {
                                await fetchStudents();
                                showToast(ev.message || 'Dữ liệu vừa được cập nhật thời gian thực');
                            } else {
                                remoteUpdateDetected.value = true;
                                remoteUpdateMessage.value = ev.message || 'Một người dùng khác vừa cập nhật dữ liệu lớp học này trên máy chủ.';
                            }
                        } catch (err) {
                            console.error('[SSE Event Error]', err);
                        }
                    });

                    sseEventSource.onerror = () => {
                        sseConnected.value = false;
                    };
                }

                function dismissRemoteBanner() {
                    remoteUpdateDetected.value = false;
                }

                async function forceSyncWithServer() {
                    remoteUpdateDetected.value = false;
                    await fetchStudents();
                    showToast('Đã đồng bộ dữ liệu mới nhất từ máy chủ');
                }

                function markModified(row) {
                    if (!userPermission.value.canWrite) return;
                    row.isModified = true;
                    scheduleDraftSave();
                }

                function addNewRow() {
                    if (!userPermission.value.isOwner) {
                        showToast('Chỉ Người sở hữu Tổ chức mới có quyền thêm học sinh mới!', 'error');
                        return;
                    }

                    students.value.push({
                        tempId: Date.now(),
                        studentCode: `HS${Math.floor(1000 + Math.random() * 9000)}`,
                        name: '',
                        dateOfBirth: '',
                        phone: '',
                        email: '',
                        parentPhone: '',
                        parentEmail: '',
                        conductScore: 100,
                        conductDeductionReason: '',
                        isModified: true,
                        isNew: true
                    });
                    scheduleDraftSave();
                }

                async function deleteRow(index, row) {
                    if (!userPermission.value.isOwner) {
                        showToast('Chỉ Người sở hữu Tổ chức mới có quyền xóa học sinh!', 'error');
                        return;
                    }

                    if (row.isNew) {
                        students.value.splice(index, 1);
                        scheduleDraftSave();
                        return;
                    }

                    if (!confirm(`Bạn có chắc muốn xóa học sinh "${row.name || row.studentCode}" khỏi bảng tính?`)) return;

                    try {
                        const headers = getTokenHeader();
                        const res = await fetch(`/api/organization/students/${row.id}`, {
                            method: 'DELETE',
                            headers
                        });

                        if (res.ok) {
                            students.value.splice(index, 1);
                            scheduleDraftSave();
                            showToast('Đã xóa học sinh khỏi bảng tính');
                        } else {
                            showToast('Không thể xóa học sinh', 'error');
                        }
                    } catch (e) {
                        showToast('Lỗi kết nối máy chủ', 'error');
                    }
                }

                async function saveAllChanges() {
                    if (!userPermission.value.canWrite) {
                        showToast('Tài khoản của bạn không có quyền lưu thay đổi ở lớp này!', 'error');
                        return;
                    }

                    const modifiedRows = students.value.filter(s => s.isModified || s.isNew);
                    if (modifiedRows.length === 0) {
                        showToast('Không có thay đổi nào cần lưu!');
                        return;
                    }

                    const invalidRow = modifiedRows.find(s => !s.name || !s.name.trim());
                    if (invalidRow) {
                        showToast('Vui lòng nhập Họ và Tên cho tất cả học sinh được chỉnh sửa!', 'error');
                        return;
                    }

                    saving.value = true;
                    const classId = getClassIdFromUrl();

                    try {
                        const headers = { ...getTokenHeader(), 'Content-Type': 'application/json' };
                        const creates = [];
                        const updates = [];

                        for (const row of modifiedRows) {
                            if (row.isNew) {
                                creates.push({
                                    studentCode: row.studentCode,
                                    name: row.name,
                                    dateOfBirth: row.dateOfBirth,
                                    phone: row.phone,
                                    email: row.email,
                                    parentPhone: row.parentPhone,
                                    parentEmail: row.parentEmail,
                                    conductScore: row.conductScore,
                                    conductDeductionReason: row.conductDeductionReason
                                });
                            } else {
                                const payload = userPermission.value.isOwner
                                    ? {
                                        id: row.id,
                                        studentCode: row.studentCode,
                                        name: row.name,
                                        dateOfBirth: row.dateOfBirth,
                                        phone: row.phone,
                                        email: row.email,
                                        parentPhone: row.parentPhone,
                                        parentEmail: row.parentEmail,
                                        conductScore: row.conductScore,
                                        conductDeductionReason: row.conductDeductionReason
                                    }
                                    : {
                                        id: row.id,
                                        conductScore: row.conductScore,
                                        conductDeductionReason: row.conductDeductionReason
                                    };
                                updates.push(payload);
                            }
                        }

                        // Atomic Batch Save in 1 transaction
                        const res = await fetch(`/api/organization/classes/${classId}/students/batch`, {
                            method: 'POST',
                            headers,
                            body: JSON.stringify({ creates, updates, deletes: [] })
                        });

                        const data = await res.json();
                        if (!res.ok) {
                            throw new Error(data.message || 'Lỗi khi lưu dữ liệu lên máy chủ');
                        }

                        // Clear draft on successful batch save
                        localStorage.removeItem('draft_class_' + classId);
                        lastDraftSavedTime.value = '';
                        remoteUpdateDetected.value = false;

                        showToast(`Đã lưu đồng bộ ${creates.length + updates.length} học sinh thành công!`);
                        await fetchStudents();
                    } catch (e) {
                        showToast(e.message || 'Lỗi khi lưu dữ liệu lên máy chủ', 'error');
                    } finally {
                        saving.value = false;
                    }
                }

                // Helper function to export beautiful Excel with real grid borders, alignments & auto column widths
                function exportExcelHtmlTable({ filename, title, subheaders = [], headers, rows, colWidths = [] }) {
                    const totalCols = headers.length;
                    let html = `
                    <html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:x="urn:schemas-microsoft-com:office:excel" xmlns="http://www.w3.org/TR/REC-html40">
                    <head>
                        <!--[if gte mso 9]>
                        <xml>
                            <x:ExcelWorkbook>
                                <x:ExcelWorksheets>
                                    <x:ExcelWorksheet>
                                        <x:Name>Báo Cáo</x:Name>
                                        <x:WorksheetOptions>
                                            <x:DisplayGridlines/>
                                        </x:WorksheetOptions>
                                    </x:ExcelWorksheet>
                                </x:ExcelWorksheets>
                            </x:ExcelWorkbook>
                        </xml>
                        <![endif]-->
                        <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
                        <style>
                            body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; font-size: 11pt; }
                            .title-row { font-size: 14pt; font-weight: bold; text-align: center; height: 32px; vertical-align: middle; }
                            .sub-row { font-size: 10.5pt; text-align: center; color: #333333; height: 22px; vertical-align: middle; }
                            .table-grid { border-collapse: collapse; border: 1.5pt solid #000000; width: 100%; }
                            .table-grid th { 
                                background-color: #f1f5f9; 
                                color: #000000; 
                                font-weight: bold; 
                                border: 1pt solid #000000; 
                                padding: 8px 10px; 
                                text-align: center; 
                                vertical-align: middle; 
                            }
                            .table-grid td { 
                                border: 1pt solid #000000; 
                                padding: 6px 9px; 
                                vertical-align: middle; 
                                mso-number-format: "\\@"; /* Treat as explicit Text in Excel to avoid 2-Feb auto date bug */
                            }
                            .text-center { text-align: center; }
                            .text-left { text-align: left; }
                            .text-right { text-align: right; }
                            .font-bold { font-weight: bold; }
                            .bg-good { background-color: #ecfdf5; color: #15803d; font-weight: bold; }
                        </style>
                    </head>
                    <body>
                        <table>
                            ${title ? `<tr><td colspan="${totalCols}" class="title-row">${title}</td></tr>` : ''}
                            ${subheaders.map(sub => `<tr><td colspan="${totalCols}" class="sub-row">${sub}</td></tr>`).join('')}
                            ${title || subheaders.length > 0 ? '<tr><td colspan="' + totalCols + '" style="height: 12px;"></td></tr>' : ''}
                        </table>
                        <table class="table-grid">
                            <thead>
                                <tr>
                                    ${headers.map((h, i) => `<th ${colWidths[i] ? `style="width:${colWidths[i]}px;"` : ''}>${h}</th>`).join('')}
                                </tr>
                            </thead>
                            <tbody>
                                ${rows.map(r => `
                                    <tr>
                                        ${r.map(c => {
                                            const val = c.value !== undefined ? c.value : c;
                                            const align = c.align || 'text-center';
                                            const cls = c.cls || '';
                                            return `<td class="${align} ${cls}">${val}</td>`;
                                        }).join('')}
                                    </tr>
                                `).join('')}
                            </tbody>
                        </table>
                    </body>
                    </html>
                    `;

                    const blob = new Blob(['\uFEFF' + html], { type: 'application/vnd.ms-excel;charset=utf-8' });
                    const link = document.createElement('a');
                    link.href = URL.createObjectURL(blob);
                    link.download = filename.endsWith('.xls') ? filename : `${filename}.xls`;
                    document.body.appendChild(link);
                    link.click();
                    document.body.removeChild(link);
                }

                function exportCsv() {
                    if (students.value.length === 0) {
                        showToast('Không có dữ liệu để xuất!', 'error');
                        return;
                    }

                    const className = currentClass.value?.name || 'Lớp';
                    const headers = ['STT', 'Mã Học Sinh', 'Họ và Tên', 'Ngày Sinh', 'SĐT Học Sinh', 'Email Học Sinh', 'SĐT Phụ Huynh', 'Email Phụ Huynh', 'Điểm Hạnh Kiểm'];
                    const rows = students.value.map((st, idx) => [
                        { value: idx + 1, align: 'text-center' },
