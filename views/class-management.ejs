<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quản lý Học sinh Excel - EduManager</title>
    <!-- FontAwesome 6 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts Inter & JetBrains Mono -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap">
    <!-- TailwindCSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Custom CSS -->
    <link rel="stylesheet" href="/public/style.css">
    <!-- Vue 3 CDN -->
    <script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>

    <style>
        /* Excel Sheet Custom Styling */
        .excel-table-container {
            user-select: none;
        }

        .excel-th {
            background-color: #0f172a;
            border: 1px solid #1e293b;
            color: #94a3b8;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            padding: 8px 12px;
            position: sticky;
            top: 0;
            z-index: 10;
        }

        .excel-col-header {
            background-color: #1e293b;
            color: #cbd5e1;
            font-family: 'JetBrains Mono', monospace;
            font-size: 11px;
            text-align: center;
            border: 1px solid #334155;
            padding: 4px 8px;
        }

        .excel-row-num {
            background-color: #1e293b;
            color: #94a3b8;
            font-family: 'JetBrains Mono', monospace;
            font-size: 11px;
            text-align: center;
            border: 1px solid #334155;
            width: 40px;
            min-width: 40px;
        }

        .excel-cell {
            border: 1px solid #1e293b;
            padding: 0;
            background-color: #020617;
            transition: all 0.15s ease;
        }

        .excel-cell input {
            width: 100%;
            height: 100%;
            padding: 8px 12px;
            background: transparent;
            color: #f8fafc;
            font-size: 13px;
            outline: none;
            border: 2px solid transparent;
            transition: all 0.15s ease;
        }

        .excel-cell input:focus {
            background-color: #0f172a;
            border-color: #0ea5e9;
            box-shadow: 0 0 0 2px rgba(14, 165, 233, 0.2);
            z-index: 5;
        }

        .excel-cell-modified input {
            color: #38bdf8;
            font-weight: 600;
        }

        .excel-toolbar-btn {
            padding: 6px 12px;
            background-color: #1e293b;
            border: 1px solid #334155;
            border-radius: 8px;
            color: #cbd5e1;
            font-size: 12px;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 6px;
            transition: all 0.15s ease;
        }

        .excel-toolbar-btn:hover {
            background-color: #334155;
            color: #ffffff;
            border-color: #475569;
        }
    </style>
</head>

<body class="bg-slate-950 text-slate-100 font-sans antialiased min-h-screen flex flex-col">
    <div id="app" class="relative min-h-screen flex flex-col flex-1">
        <!-- Excel Navigation & Ribbon Toolbar Header -->
        <header class="border-b border-slate-800 bg-slate-900 sticky top-0 z-40 shadow-xl">
            <!-- Top App Bar -->
            <div class="px-6 py-3 flex items-center justify-between border-b border-slate-800/80">
                <div class="flex items-center space-x-4">
                    <a href="/dashboard" class="px-3 py-1.5 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded-lg text-xs font-semibold transition border border-slate-700 flex items-center space-x-1.5">
                        <i class="fa-solid fa-arrow-left"></i>
                        <span>Về Bảng điều khiển</span>
                    </a>
                    <span class="text-slate-700">|</span>
                    <div class="flex items-center space-x-2.5">
                        <div class="w-8 h-8 rounded-lg bg-emerald-600 flex items-center justify-center text-white text-sm shadow-lg shadow-emerald-600/30 font-extrabold">
                            <i class="fa-solid fa-file-excel"></i>
                        </div>
                        <div>
                            <h1 class="text-sm font-bold text-slate-100 flex items-center gap-2">
                                <span>EduManager Excel Sheet</span>
                                <span v-if="!userPermission.canWrite" class="px-2 py-0.5 text-[10px] font-extrabold bg-amber-500/20 text-amber-300 border border-amber-500/30 rounded uppercase flex items-center">
                                    <i class="fa-solid fa-lock mr-1 text-[9px]"></i>Chế độ Chỉ xem
                                </span>
                                <span v-else class="px-2 py-0.5 text-[10px] font-extrabold bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 rounded uppercase flex items-center">
                                    <i class="fa-solid fa-pen mr-1 text-[9px]"></i>Lớp {{ currentClass?.name }}
                                </span>
                            </h1>
                            <p class="text-[10px] text-slate-400">Trình quản lý Học sinh trực tiếp dạng Bảng tính Spreadsheet</p>
                        </div>
                    </div>
                </div>

                <div class="flex items-center space-x-3">
                    <div :class="debugMode ? 'bg-emerald-500/20 text-emerald-300 border-emerald-500/40' : 'bg-slate-800/60 text-slate-400 border-slate-700'" class="px-3 py-1.5 text-xs font-bold rounded-lg border flex items-center space-x-1.5 shadow-md">
                        <i class="fa-solid" :class="debugMode ? 'fa-bug text-emerald-400' : 'fa-bug-slash'"></i>
                        <span>Debug Mode: {{ debugMode ? 'Bật (.env)' : 'Tắt (.env)' }}</span>
                    </div>
                    <button @click="saveAllChanges" :disabled="saving || !userPermission.canWrite" :class="!userPermission.canWrite ? 'bg-slate-800 text-slate-500 border border-slate-700 cursor-not-allowed' : 'bg-emerald-600 hover:bg-emerald-500 text-white shadow-lg shadow-emerald-600/30'" class="px-4 py-1.5 font-bold text-xs rounded-lg transition flex items-center space-x-1.5">
                        <i v-if="saving" class="fa-solid fa-circle-notch fa-spin"></i>
                        <i v-else-if="!userPermission.canWrite" class="fa-solid fa-lock"></i>
                        <i v-else class="fa-solid fa-floppy-disk"></i>
                        <span>Lưu tất cả thay đổi</span>
                    </button>
                </div>
            </div>

            <!-- Excel Ribbon Toolbar -->
            <div class="px-6 py-2 bg-slate-950/60 flex items-center justify-between gap-4 overflow-x-auto text-xs">
                <div class="flex items-center space-x-2">
                    <button @click="addNewRow" :disabled="!userPermission.isOwner" :class="!userPermission.isOwner ? 'opacity-50 cursor-not-allowed text-slate-500 border-slate-800 bg-slate-900' : 'text-emerald-400 border-emerald-500/40 bg-emerald-500/10 hover:bg-emerald-500/20'" class="excel-toolbar-btn" :title="!userPermission.isOwner ? 'Chỉ Người sở hữu Tổ chức mới được phép thêm học sinh' : ''">
                        <i class="fa-solid fa-plus"></i>
                        <span>Thêm hàng mới (Add Row)</span>
                    </button>
                    <button @click="fetchStudents" class="excel-toolbar-btn">
                        <i class="fa-solid fa-rotate"></i>
                        <span>Tải lại</span>
                    </button>
                    <button @click="exportCsv" class="excel-toolbar-btn">
                        <i class="fa-solid fa-file-csv"></i>
                        <span>Xuất CSV</span>
                    </button>
                    <button @click="openAuditLogsModal" class="excel-toolbar-btn text-indigo-400 border-indigo-500/40 bg-indigo-500/10 hover:bg-indigo-500/20">
                        <i class="fa-solid fa-clock-rotate-left"></i>
                        <span>Lịch sử Phiên bản</span>
                    </button>
                    <div class="relative ml-2">
                        <i class="fa-solid fa-magnifying-glass absolute left-3 top-2.5 text-slate-500"></i>
                        <input v-model="searchQuery" type="text" placeholder="Tìm tên, mã HS, SĐT..." class="pl-8 pr-3 py-1.5 bg-slate-900 border border-slate-700 rounded-lg text-slate-200 text-xs focus:outline-none focus:border-emerald-500 transition w-56">
                    </div>
                </div>

                <div class="flex items-center space-x-3 text-xs text-slate-400">
                    <button @click="showAiDrawer = !showAiDrawer" class="px-3 py-1.5 gradient-bg hover:opacity-90 text-white rounded-lg transition font-semibold flex items-center space-x-1.5 shadow-md">
                        <i class="fa-solid fa-sparkles text-amber-300"></i>
                        <span>Trợ lý Gemini AI</span>
                    </button>
                    <span>|</span>
                    <span class="flex items-center gap-1.5"><i class="fa-solid fa-layer-group text-sky-400"></i>Tổng hàng: <strong class="text-slate-200">{{ students.length }}</strong></span>
                    <span>|</span>
                    <span class="flex items-center gap-1.5"><i class="fa-solid fa-pen text-amber-400"></i>Đang sửa: <strong class="text-amber-400">{{ modifiedCount }}</strong></span>
                </div>
            </div>
        </header>

        <!-- Main Excel Spreadsheet Work Area -->
        <main class="flex-1 flex flex-col overflow-hidden p-4 bg-slate-950">
            <!-- Read-Only Banner for Members with Read Permission -->
            <div v-if="!userPermission.canWrite" class="mb-3 p-3 bg-amber-500/10 border border-amber-500/30 rounded-xl text-amber-300 text-xs flex items-center justify-between shadow-lg">
                <span class="flex items-center gap-2">
                    <i class="fa-solid fa-lock text-amber-400 text-sm"></i>
                    <span><strong>Chế độ Chỉ xem (Read-Only):</strong> Tài khoản của bạn được cấp quyền xem dữ liệu ở lớp học này. Thao tác chỉnh sửa, thêm và xóa học sinh đã bị khóa.</span>
                </span>
            </div>

            <!-- Loading Indicator -->
            <div v-if="loading" class="flex-1 flex flex-col items-center justify-center space-y-3">
                <i class="fa-solid fa-circle-notch fa-spin text-4xl text-emerald-500"></i>
                <p class="text-xs text-slate-400 font-medium">Đang tải bảng tính Excel...</p>
            </div>

            <!-- Spreadsheet Grid Container -->
            <div v-else class="flex-1 glass-card rounded-xl border border-slate-800 overflow-auto flex flex-col excel-table-container shadow-2xl">
                <table class="w-full text-left border-collapse min-w-[1100px]">
                    <thead>
                        <!-- Column Header Letters (A, B, C, D...) -->
                        <tr>
                            <th class="excel-col-header">#</th>
                            <th class="excel-col-header">A</th>
                            <th class="excel-col-header">B</th>
                            <th class="excel-col-header">C</th>
                            <th class="excel-col-header">D</th>
                            <th class="excel-col-header">E</th>
                            <th class="excel-col-header">F</th>
                            <th class="excel-col-header">G</th>
                            <th class="excel-col-header">H</th>
                            <th class="excel-col-header text-center">Thao tác</th>
                        </tr>
                        <!-- Attribute Field Names -->
                        <tr>
                            <th class="excel-th text-center">STT</th>
                            <th class="excel-th">Mã Học Sinh</th>
                            <th class="excel-th">Họ và Tên (*)</th>
                            <th class="excel-th">Ngày Sinh</th>
                            <th class="excel-th">SĐT Học Sinh</th>
                            <th class="excel-th">Email Học Sinh</th>
                            <th class="excel-th">SĐT Phụ Huynh</th>
                            <th class="excel-th">Email Phụ Huynh</th>
                            <th class="excel-th">Điểm Hạnh Kiểm</th>
                            <th class="excel-th text-center">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr v-for="(row, index) in filteredStudents" :key="row.tempId || row.id" :class="{'bg-sky-500/5': row.isModified, 'bg-emerald-500/10': row.isNew}">
                            <!-- Row Index Number -->
                            <td class="excel-row-num">{{ index + 1 }}</td>

                            <!-- Cell A: Student Code (Chỉ Owner chỉnh sửa) -->
                            <td class="excel-cell" :class="{'excel-cell-modified': row.isModified}">
                                <input v-model="row.studentCode" @input="markModified(row)" :readonly="!userPermission.isOwner" type="text" placeholder="HS001" :title="!userPermission.isOwner ? 'Chỉ Người sở hữu Tổ chức mới được sửa thông tin cá nhân' : ''">
                            </td>

                            <!-- Cell B: Name (Chỉ Owner chỉnh sửa) -->
                            <td class="excel-cell" :class="{'excel-cell-modified': row.isModified}">
                                <input v-model="row.name" @input="markModified(row)" :readonly="!userPermission.isOwner" type="text" placeholder="Nguyễn Văn A" class="font-semibold text-slate-100" :title="!userPermission.isOwner ? 'Chỉ Người sở hữu Tổ chức mới được sửa thông tin cá nhân' : ''">
                            </td>

                            <!-- Cell C: DOB (Chỉ Owner chỉnh sửa) -->
                            <td class="excel-cell" :class="{'excel-cell-modified': row.isModified}">
                                <input v-model="row.dateOfBirth" @change="markModified(row)" :readonly="!userPermission.isOwner" type="date" class="font-mono" :title="!userPermission.isOwner ? 'Chỉ Người sở hữu Tổ chức mới được sửa thông tin cá nhân' : ''">
                            </td>

                            <!-- Cell D: Student Phone (Chỉ Owner chỉnh sửa) -->
                            <td class="excel-cell" :class="{'excel-cell-modified': row.isModified}">
                                <input v-model="row.phone" @input="markModified(row)" :readonly="!userPermission.isOwner" type="text" placeholder="0901234567" class="font-mono" :title="!userPermission.isOwner ? 'Chỉ Người sở hữu Tổ chức mới được sửa thông tin cá nhân' : ''">
                            </td>

                            <!-- Cell E: Student Email (Chỉ Owner chỉnh sửa) -->
                            <td class="excel-cell" :class="{'excel-cell-modified': row.isModified}">
                                <input v-model="row.email" @input="markModified(row)" :readonly="!userPermission.isOwner" type="email" placeholder="student@gmail.com" :title="!userPermission.isOwner ? 'Chỉ Người sở hữu Tổ chức mới được sửa thông tin cá nhân' : ''">
                            </td>

                            <!-- Cell F: Parent Phone (Chỉ Owner chỉnh sửa) -->
                            <td class="excel-cell" :class="{'excel-cell-modified': row.isModified}">
                                <input v-model="row.parentPhone" @input="markModified(row)" :readonly="!userPermission.isOwner" type="text" placeholder="0987654321" class="font-mono" :title="!userPermission.isOwner ? 'Chỉ Người sở hữu Tổ chức mới được sửa thông tin cá nhân' : ''">
                            </td>

                            <!-- Cell G: Parent Email (Chỉ Owner chỉnh sửa) -->
                            <td class="excel-cell" :class="{'excel-cell-modified': row.isModified}">
                                <input v-model="row.parentEmail" @input="markModified(row)" :readonly="!userPermission.isOwner" type="email" placeholder="parent@gmail.com" :title="!userPermission.isOwner ? 'Chỉ Người sở hữu Tổ chức mới được sửa thông tin cá nhân' : ''">
                            </td>

                            <!-- Cell H: Conduct Score & Deduction Trigger Button with Hover History Tooltip (Thành viên có quyền ghi được phép) -->
                            <td class="excel-cell relative group" :class="{'excel-cell-modified': row.isModified}">
                                <div class="flex items-center justify-between px-1.5 h-full space-x-1.5">
                                    <div class="flex flex-col text-left leading-tight py-1 cursor-help">
                                        <span class="font-extrabold text-emerald-400 text-sm font-mono flex items-center gap-1">
                                            <span>{{ row.conductScore ?? 100 }}</span>
                                            <i v-if="getStudentDeductionHistory(row.id).length > 0" class="fa-solid fa-clock-rotate-left text-[10px] text-amber-400"></i>
                                        </span>
                                        <span v-if="row.conductDeductionReason" class="text-[10px] text-amber-300 truncate max-w-[120px]" :title="row.conductDeductionReason">
                                            <i class="fa-solid fa-triangle-exclamation text-[9px] mr-0.5"></i>{{ row.conductDeductionReason }}
                                        </span>
                                    </div>
                                    <button v-if="userPermission.canWrite" @click="openDeductModal(row)" type="button" class="px-2 py-1 bg-amber-500/20 hover:bg-amber-500/30 text-amber-300 border border-amber-500/40 rounded text-[11px] font-bold transition flex items-center space-x-1 whitespace-nowrap shadow-sm" title="Trừ điểm hạnh kiểm & Nhập lý do">
                                        <i class="fa-solid fa-minus-circle text-amber-400"></i>
                                        <span>Trừ điểm</span>
                                    </button>
                                </div>

                                <!-- Hover Tooltip: Show Deduction History & Who Deducted -->
                                <div class="hidden group-hover:block absolute left-0 bottom-full mb-2 w-72 p-3 bg-slate-900 border border-amber-500/40 rounded-xl shadow-2xl z-50 pointer-events-none text-left backdrop-blur-md">
                                    <div class="flex items-center justify-between border-b border-slate-800 pb-1.5 mb-2">
                                        <span class="text-xs font-bold text-amber-300 flex items-center gap-1.5">
                                            <i class="fa-solid fa-clock-rotate-left text-amber-400"></i>
                                            <span>Lịch sử trừ điểm: {{ row.name }}</span>
                                        </span>
                                        <span class="text-[10px] font-mono text-slate-400">ID: {{ row.id }}</span>
                                    </div>

                                    <div v-if="getStudentDeductionHistory(row.id).length === 0" class="text-[11px] text-slate-400 italic py-1">
                                        Chưa có lịch sử trừ điểm nào được ghi nhận.
                                    </div>

                                    <div v-else class="space-y-2 max-h-48 overflow-y-auto pr-1">
                                        <div v-for="h in getStudentDeductionHistory(row.id)" :key="h.id" class="p-2 bg-slate-950/80 rounded-lg border border-slate-800 text-[11px] space-y-1">
                                            <div class="flex items-center justify-between text-slate-300">
                                                <span :class="h.source === 'AGENT' ? 'text-amber-300 font-bold' : 'text-emerald-300 font-bold'" class="flex items-center gap-1">
                                                    <i :class="h.source === 'AGENT' ? 'fa-robot' : 'fa-user'" class="fa-solid text-[10px]"></i>
                                                    <span>{{ h.userName || h.userEmail || 'Ẩn danh' }}</span>
                                                </span>
                                                <span class="text-[10px] text-slate-500 font-mono">{{ formatDate(h.createdAt) }}</span>
                                            </div>
                                            <p class="text-slate-200 font-medium text-[10px] leading-snug">{{ h.description }}</p>
                                        </div>
                                    </div>
                                </div>
                            </td>

                            <!-- Action Column: Delete Row (Chỉ Owner mới có quyền xóa) -->
                            <td class="excel-cell text-center align-middle bg-slate-900/60">
                                <button v-if="userPermission.isOwner" @click="deleteRow(index, row)" class="p-2 text-slate-500 hover:text-red-400 transition" title="Xóa hàng này (Chỉ Người sở hữu Tổ chức)">
                                    <i class="fa-solid fa-trash-can"></i>
                                </button>
                                <span v-else class="text-slate-600 text-xs" title="Chỉ Người sở hữu Tổ chức mới có quyền xóa học sinh"><i class="fa-solid fa-lock"></i></span>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </main>

        <!-- Status Footer Bar -->
        <footer class="bg-slate-900 border-t border-slate-800 px-6 py-2 flex items-center justify-between text-xs text-slate-400">
            <div class="flex items-center space-x-2">
                <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                <span>Bảng tính đã sẵn sàng</span>
            </div>
            <div>
                <span>Trạng thái: <strong>{{ saving ? 'Đang lưu...' : (modifiedCount > 0 ? 'Có thay đổi chưa lưu' : 'Đã đồng bộ với Server') }}</strong></span>
            </div>
        <!-- GEMINI AI CHATBOT DRAWER & PREVIEW MODAL -->
        <!-- Floating Gemini AI Trigger Button -->
        <button @click="showAiDrawer = !showAiDrawer" class="fixed bottom-6 right-6 w-14 h-14 gradient-bg text-white rounded-full shadow-2xl flex items-center justify-center text-xl z-40 hover:scale-105 transition border border-white/20">
            <i class="fa-solid fa-sparkles text-amber-300"></i>
        </button>

        <!-- Gemini AI Chatbot Drawer Panel -->
        <div v-if="showAiDrawer" class="fixed bottom-24 right-6 w-96 glass-card rounded-2xl border border-sky-500/30 shadow-2xl z-40 flex flex-col bg-slate-950/95 overflow-hidden h-[480px]">
            <div class="px-4 py-3 border-b border-slate-800 flex justify-between items-center bg-slate-900/90">
                <div class="flex items-center space-x-2.5">
                    <div class="w-8 h-8 rounded-lg gradient-bg flex items-center justify-center text-white text-sm shadow-md">
                        <i class="fa-solid fa-sparkles text-amber-300"></i>
                    </div>
                    <div>
                        <h3 class="font-bold text-slate-100 text-sm flex items-center gap-1.5">
                            <span>Gemini AI Chatbot</span>
                            <span v-if="isGeminiPowered" class="px-1.5 py-0.5 text-[9px] bg-amber-500/20 text-amber-300 border border-amber-500/30 rounded font-bold">API Active</span>
                        </h3>
                        <p class="text-[10px] text-slate-400">Trợ lý AI quản lý Lớp học & Bảng tính</p>
                    </div>
                </div>
                <button @click="showAiDrawer = false" class="text-slate-400 hover:text-slate-200">
                    <i class="fa-solid fa-xmark text-sm"></i>
                </button>
            </div>

            <div class="flex-1 p-4 overflow-y-auto space-y-3 text-xs">
                <div v-for="(msg, idx) in chatMessages" :key="idx" :class="msg.role === 'user' ? 'justify-end' : 'justify-start'" class="flex items-start gap-2">
                    <div v-if="msg.role === 'assistant'" class="w-6 h-6 rounded-full bg-sky-500/20 text-sky-400 flex items-center justify-center text-[10px] flex-shrink-0 mt-0.5">
                        <i class="fa-solid fa-robot"></i>
                    </div>
                    <div :class="msg.role === 'user' ? 'bg-sky-600 text-white rounded-2xl rounded-tr-none' : 'bg-slate-900 border border-slate-800 text-slate-200 rounded-2xl rounded-tl-none'" class="p-3 max-w-[80%] leading-relaxed space-y-2">
                        <div v-if="msg.fileName" class="flex items-center space-x-2 bg-sky-700/50 p-2 rounded text-xs mb-2">
                            <i class="fa-solid fa-paperclip text-sky-200"></i>
                            <span class="truncate">{{ msg.fileName }}</span>
                        </div>
                        <p>{{ msg.text }}</p>
                        <div v-if="msg.hasActions" class="pt-1 border-t border-slate-800/80 flex items-center justify-between text-[11px]">
                            <span class="text-amber-400 font-semibold"><i class="fa-solid fa-list-check mr-1"></i>Có {{ msg.actionsCount }} thao tác đề xuất</span>
                            <button @click="openPreviewFromChat(msg)" class="px-2 py-1 bg-sky-500/20 hover:bg-sky-500/30 text-sky-300 rounded font-bold transition border border-sky-500/30">
                                Xem & Thực thi
                            </button>
                        </div>
                    </div>
                </div>
                <div v-if="parsingAi" class="flex items-center space-x-2 text-slate-400 italic text-xs py-2">
                    <i class="fa-solid fa-circle-notch fa-spin text-sky-400"></i>
                    <span>Gemini AI đang suy nghĩ...</span>
                </div>
            </div>

            <div class="p-3 border-t border-slate-800 bg-slate-900/90 relative">
                <!-- File Preview Chip -->
                <div v-if="aiAttachedFile" class="absolute bottom-[60px] left-3 right-3 flex items-center justify-between bg-slate-800 border border-slate-700 px-3 py-2 rounded-lg z-10 shadow-lg">
                    <div class="flex items-center space-x-2 overflow-hidden">
                        <i class="fa-solid fa-file-lines text-sky-400"></i>
                        <span class="text-xs text-slate-200 truncate">{{ aiAttachedFile.name }}</span>
                        <span class="text-[10px] text-slate-500">({{ (aiAttachedFile.size / 1024).toFixed(1) }} KB)</span>
                    </div>
                    <button @click="removeAiFile" type="button" class="text-slate-400 hover:text-red-400 transition">
                        <i class="fa-solid fa-xmark"></i>
                    </button>
                </div>

                <form @submit.prevent="sendChatMessage" class="flex items-center space-x-2">
                    <button type="button" @click="$refs.aiFileInput.click()" :disabled="parsingAi" class="px-3 py-2 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded-xl text-xs transition shadow-md border border-slate-700">
                        <i class="fa-solid fa-paperclip"></i>
                    </button>
                    <input type="file" ref="aiFileInput" @change="onAiFileSelected" accept=".pdf,.doc,.docx,.csv,image/*" class="hidden">
                    
                    <input v-model="aiPrompt" type="text" placeholder="Thêm học sinh hoặc đính kèm file..." :disabled="parsingAi" class="flex-1 px-3.5 py-2 bg-slate-950 border border-slate-700 rounded-xl text-slate-200 text-xs focus:outline-none focus:border-sky-500 transition">
                    <button type="submit" :disabled="parsingAi || (!aiPrompt.trim() && !aiAttachedFile)" class="px-3.5 py-2 gradient-bg hover:opacity-90 text-white rounded-xl text-xs transition font-semibold shadow-md flex items-center justify-center">
                        <i class="fa-solid fa-paper-plane"></i>
                    </button>
                </form>
            </div>
        </div>

        <div v-if="showAiPreviewModal" class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm z-50 flex items-center justify-center p-4">
            <div class="glass-card max-w-lg w-full rounded-2xl p-6 border border-sky-500/40 space-y-5 bg-slate-900 shadow-2xl">
                <div class="flex items-center space-x-3 border-b border-slate-800 pb-3">
                    <div class="w-10 h-10 rounded-xl bg-sky-500/20 text-sky-400 flex items-center justify-center text-lg">
                        <i class="fa-solid fa-eye"></i>
                    </div>
                    <div>
                        <h3 class="font-bold text-slate-100 text-base">Xem trước Kế hoạch Gemini AI (Server Preview)</h3>
                        <p class="text-xs text-slate-400">Các hàm Node.js được phép gọi trực tiếp tại Server.</p>
                    </div>
                </div>

                <div class="space-y-3">
                    <div class="p-3 bg-sky-500/10 border border-sky-500/20 rounded-xl text-xs text-sky-300">
                        <i class="fa-solid fa-info-circle mr-1"></i>{{ proposedPlan.summary }}
                    </div>

                    <div v-if="debugMode && proposedPlan.code" class="space-y-1.5">
                        <label class="text-[11px] font-semibold text-emerald-400 uppercase tracking-wider flex items-center justify-between">
                            <span><i class="fa-solid fa-bug mr-1"></i>Mã JavaScript (Debug Mode):</span>
                            <span class="text-sky-400 font-mono text-[10px]"><i class="fa-brands fa-js mr-1"></i>Node.js Sandbox</span>
                        </label>
                        <pre class="p-3 bg-slate-950 rounded-xl border border-slate-800 text-xs font-mono text-emerald-400 overflow-x-auto whitespace-pre-wrap max-h-48"><code>{{ proposedPlan.code }}</code></pre>
                    </div>

                    <div v-if="proposedPlan.actions && proposedPlan.actions.length" class="space-y-2 max-h-48 overflow-y-auto">
                        <div v-for="(item, idx) in proposedPlan.actions" :key="idx" class="p-3 bg-slate-950 rounded-xl border border-slate-800 flex items-center justify-between text-xs">
                            <div class="flex items-center space-x-2">
                                <span class="w-5 h-5 bg-slate-800 rounded-full flex items-center justify-center font-bold text-[10px] text-slate-300">{{ idx + 1 }}</span>
                                <span class="font-medium text-slate-200">{{ item.description || item.action }}</span>
                            </div>
                            <span class="px-2 py-0.5 text-[10px] font-bold rounded bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">
                                Server Whitelist API
                            </span>
                        </div>
                    </div>
                </div>

                <div class="flex justify-end space-x-3 pt-2 border-t border-slate-800">
                    <button @click="showAiPreviewModal = false" class="px-4 py-2 bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs font-semibold rounded-xl transition">
                        Hủy bỏ
                    </button>
                    <button @click="confirmExecuteServerPlan" :disabled="executingAi" class="px-5 py-2 bg-sky-600 hover:bg-sky-500 text-white text-xs font-bold rounded-xl transition flex items-center space-x-2 shadow-lg shadow-sky-600/30">
                        <i v-if="executingAi" class="fa-solid fa-spinner fa-spin"></i>
                        <i v-else class="fa-solid fa-check"></i>
                        <span>Chấp nhận & Thực thi trên Server</span>
                    </button>
                </div>
            </div>
        </div>

        <!-- Conduct Deduction Popup Modal -->
        <div v-if="showDeductModal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-950/80 backdrop-blur-md">
            <div class="bg-slate-900 border border-slate-700/80 rounded-2xl max-w-md w-full p-6 shadow-2xl space-y-4">
                <div class="flex items-center justify-between pb-3 border-b border-slate-800">
                    <div class="flex items-center space-x-2.5">
                        <div class="w-9 h-9 rounded-xl bg-amber-500/20 text-amber-400 border border-amber-500/30 flex items-center justify-center font-bold">
                            <i class="fa-solid fa-minus-circle"></i>
                        </div>
                        <div>
                            <h3 class="text-sm font-bold text-slate-100">Trừ Điểm Hạnh Kiểm</h3>
                            <p class="text-xs text-slate-400">Học sinh: <strong class="text-amber-300">{{ targetDeductStudent?.name }}</strong> ({{ targetDeductStudent?.studentCode }})</p>
                        </div>
                    </div>
                    <button @click="showDeductModal = false" class="text-slate-400 hover:text-slate-200">
                        <i class="fa-solid fa-xmark"></i>
                    </button>
                </div>

                <div class="space-y-3 text-xs">
                    <div>
                        <label class="block text-slate-400 font-semibold mb-1">Điểm hiện tại:</label>
                        <input :value="targetDeductStudent?.conductScore ?? 100" readonly type="text" class="w-full px-3 py-2 bg-slate-950 border border-slate-800 rounded-lg text-slate-300 font-bold">
                    </div>

                    <div>
                        <label class="block text-amber-400 font-semibold mb-1">Số điểm muốn trừ (*):</label>
                        <input v-model.number="deductPoints" type="number" min="1" max="100" placeholder="Ví dụ: 5" class="w-full px-3 py-2 bg-slate-950 border border-slate-700 rounded-lg text-slate-100 font-bold focus:border-amber-500 outline-none">
                    </div>

                    <div>
                        <label class="block text-slate-300 font-semibold mb-1">Lý do vi phạm / trừ điểm (*):</label>
                        <textarea v-model="deductReason" rows="3" placeholder="Nhập lý do chi tiết (Ví dụ: Đóng tiền muộn, đi học trễ, không mặc đồng phục...)" class="w-full px-3 py-2 bg-slate-950 border border-slate-700 rounded-lg text-slate-200 focus:border-amber-500 outline-none"></textarea>
                    </div>

                    <!-- Common preset reasons -->
                    <div>
                        <label class="block text-[11px] text-slate-400 mb-1">Gợi ý nhanh lý do vi phạm:</label>
                        <div class="flex flex-wrap gap-1.5">
                            <button @click="deductReason = 'Đi học muộn/Đi trễ'" type="button" class="px-2 py-1 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded text-[10px]">Đi học muộn</button>
                            <button @click="deductReason = 'Không mặc đúng đồng phục'" type="button" class="px-2 py-1 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded text-[10px]">Không đồng phục</button>
                            <button @click="deductReason = 'Không làm bài tập về nhà'" type="button" class="px-2 py-1 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded text-[10px]">Thiếu BT về nhà</button>
                            <button @click="deductReason = 'Mất trật tự trong giờ học'" type="button" class="px-2 py-1 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded text-[10px]">Mất trật tự</button>
                        </div>
                    </div>
                </div>

                <div class="flex justify-end space-x-2 pt-3 border-t border-slate-800">
                    <button @click="showDeductModal = false" class="px-4 py-2 bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs font-semibold rounded-xl transition">
                        Hủy
                    </button>
                    <button @click="confirmDeduction" class="px-5 py-2 bg-amber-600 hover:bg-amber-500 text-white text-xs font-bold rounded-xl transition flex items-center space-x-1.5 shadow-lg shadow-amber-600/30">
                        <i class="fa-solid fa-check"></i>
                        <span>Xác nhận Trừ điểm</span>
                    </button>
                </div>
            </div>
        </div>

        <!-- Google Sheets Style Version History Modal -->
        <div v-if="showAuditLogsModal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-950/80 backdrop-blur-md">
            <div class="bg-slate-900 border border-slate-700/80 rounded-2xl max-w-4xl w-full p-6 shadow-2xl flex flex-col max-h-[85vh]">
                <div class="flex items-center justify-between pb-4 border-b border-slate-800">
                    <div class="flex items-center space-x-3">
                        <div class="w-9 h-9 rounded-xl bg-indigo-600/20 text-indigo-400 border border-indigo-500/30 flex items-center justify-center font-bold">
                            <i class="fa-solid fa-clock-rotate-left"></i>
                        </div>
                        <div>
                            <h3 class="text-base font-bold text-slate-100 flex items-center gap-2">
                                <span>Lịch sử Phiên bản & Nhật ký Thay đổi</span>
                                <span class="px-2 py-0.5 text-[10px] bg-slate-800 text-slate-400 rounded border border-slate-700">Google Sheets Diff Style</span>
                            </h3>
                            <p class="text-xs text-slate-400">Theo dõi toàn bộ lịch sử chỉnh sửa dữ liệu, phân biệt giữa Người dùng và AI Agent</p>
                        </div>
                    </div>
                    <button @click="showAuditLogsModal = false" class="text-slate-400 hover:text-slate-200 transition">
                        <i class="fa-solid fa-xmark text-lg"></i>
                    </button>
                </div>

                <div class="flex-1 overflow-y-auto py-4 space-y-3">
                    <div v-if="loadingAuditLogs" class="text-center py-12 text-slate-400">
                        <i class="fa-solid fa-circle-notch fa-spin text-2xl mb-2 text-indigo-400"></i>
                        <p class="text-xs">Đang tải lịch sử phiên bản...</p>
                    </div>

                    <div v-else-if="auditLogs.length === 0" class="text-center py-12 text-slate-500">
                        <i class="fa-solid fa-clock text-3xl mb-2"></i>
                        <p class="text-xs">Chưa có nhật ký thay đổi nào cho lớp học này</p>
                    </div>

                    <div v-else v-for="log in auditLogs" :key="log.id" class="p-4 bg-slate-950/60 rounded-xl border border-slate-800/80 hover:border-slate-700 transition">
                        <div class="flex items-center justify-between gap-4 mb-2">
                            <div class="flex items-center space-x-2.5">
                                <span :class="log.source === 'AGENT' ? 'bg-amber-500/20 text-amber-300 border-amber-500/30' : 'bg-emerald-500/20 text-emerald-300 border-emerald-500/30'" class="px-2.5 py-0.5 text-[11px] font-bold rounded-md border flex items-center gap-1.5">
                                    <i :class="log.source === 'AGENT' ? 'fa-robot text-amber-400' : 'fa-user text-emerald-400'" class="fa-solid"></i>
                                    <span>{{ log.source === 'AGENT' ? 'AI Agent' : 'Người dùng' }}</span>
                                </span>
                                <span class="font-semibold text-slate-200 text-xs">{{ log.userName || log.userEmail || 'Ẩn danh' }}</span>
                                <span class="text-slate-500 text-xs">({{ log.action }})</span>
                            </div>
                            <span class="text-[11px] text-slate-500 font-mono">{{ formatDate(log.createdAt) }}</span>
                        </div>

                        <p class="text-xs text-slate-300 font-medium mb-2">{{ log.description }}</p>

                        <!-- Google Sheets Diff View -->
                        <div v-if="log.diffs && log.diffs.length > 0" class="mt-2 space-y-1.5 bg-slate-900/90 p-3 rounded-lg border border-slate-800">
                            <div class="text-[11px] font-semibold text-slate-400 mb-1 flex items-center gap-1">
                                <i class="fa-solid fa-code-compare text-indigo-400"></i>
                                <span>Chi tiết các trường thay đổi:</span>
                            </div>
                            <div v-for="d in log.diffs" :key="d.field" class="flex items-start justify-between text-xs py-1 px-2 rounded bg-slate-950/50 border border-slate-800/50">
                                <span class="text-slate-400 font-medium w-1/4">{{ d.field }}:</span>
                                <div class="w-3/4 flex items-center gap-2 font-mono text-[11px]">
                                    <span class="text-red-400 line-through bg-red-950/40 px-1.5 py-0.5 rounded border border-red-900/40 truncate max-w-[45%]">{{ d.oldValue }}</span>
                                    <i class="fa-solid fa-arrow-right text-slate-500 text-[10px]"></i>
                                    <span class="text-emerald-400 font-semibold bg-emerald-950/40 px-1.5 py-0.5 rounded border border-emerald-900/40 truncate max-w-[45%]">{{ d.newValue }}</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="flex justify-end pt-3 border-t border-slate-800">
                    <button @click="showAuditLogsModal = false" class="px-5 py-2 bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs font-semibold rounded-xl transition">
                        Đóng
                    </button>
                </div>
            </div>
        </div>

        <!-- Toast Feedback Notification -->
        <div v-if="toast.show" :class="toast.type === 'error' ? 'bg-red-950 border-red-500 text-red-200' : 'bg-emerald-950 border-emerald-500 text-emerald-200'" class="fixed bottom-6 left-6 px-5 py-3.5 rounded-xl border shadow-xl text-sm flex items-center space-x-3 z-50 transition-all transform duration-300">
            <i :class="toast.type === 'error' ? 'fa-circle-xmark text-red-400' : 'fa-circle-check text-emerald-400'" class="fa-solid text-lg"></i>
            <span class="font-medium">{{ toast.message }}</span>
        </div>
    </div>

    <script type="module">
        import { getAuthToken, clientLogout } from "/public/clientAuth.js";

        const { createApp, ref, computed, onMounted } = Vue;

        createApp({
            setup() {
                const user = ref(null);
                const loading = ref(true);
                const saving = ref(false);
                const currentClass = ref(null);
                const students = ref([]);
                const searchQuery = ref('');

                // Gemini AI Chatbot & Debug State
                const debugMode = ref(false);
                const showAiDrawer = ref(false);
                const showAiPreviewModal = ref(false);
                const aiPrompt = ref('');
                const aiAttachedFile = ref(null);
                const parsingAi = ref(false);
                const executingAi = ref(false);
                const isGeminiPowered = ref(false);
                const proposedPlan = ref({ summary: '', code: '', actions: [] });

                // Conduct Deduction Popup Modal State
                const showDeductModal = ref(false);
                const targetDeductStudent = ref(null);
                const deductPoints = ref(5);
                const deductReason = ref('');

                function openDeductModal(row) {
                    if (!userPermission.value.canWrite) {
                        showToast('Bạn không có quyền trừ điểm hạnh kiểm ở lớp này!', 'error');
                        return;
                    }
                    targetDeductStudent.value = row;
                    deductPoints.value = 5;
                    deductReason.value = row.conductDeductionReason || '';
                    showDeductModal.value = true;
                }

                async function confirmDeduction() {
                    if (!targetDeductStudent.value) return;
                    if (!deductReason.value.trim()) {
                        showToast('Vui lòng nhập lý do trừ điểm hạnh kiểm!', 'error');
                        return;
                    }

                    const pts = Number(deductPoints.value) || 0;
                    const reason = deductReason.value.trim();
                    const studentId = targetDeductStudent.value.id;

                    try {
                        const headers = { ...getTokenHeader(), 'Content-Type': 'application/json' };
                        const res = await fetch(`/api/organization/students/${studentId}/deduct`, {
                            method: 'POST',
                            headers,
                            body: JSON.stringify({ points: pts, reason })
                        });

                        const data = await res.json();
                        if (res.ok) {
                            showToast(`Đã trừ ${pts} điểm hạnh kiểm của ${targetDeductStudent.value.name}!`);
                            showDeductModal.value = false;
                            await fetchStudents();
                        } else {
                            showToast(data.message || 'Không thể trừ điểm hạnh kiểm', 'error');
                        }
                    } catch (e) {
                        showToast('Lỗi kết nối máy chủ khi trừ điểm', 'error');
                    }
                }

                // Audit Logs / Version History State
                const showAuditLogsModal = ref(false);
                const auditLogs = ref([]);
                const loadingAuditLogs = ref(false);

                async function openAuditLogsModal() {
                    showAuditLogsModal.value = true;
                    loadingAuditLogs.value = true;
                    try {
                        const headers = getTokenHeader();
                        const classId = getClassIdFromUrl();
                        const res = await fetch(`/api/organization/audit-logs?classId=${classId}`, { headers });
                        if (res.ok) {
                            const data = await res.json();
                            auditLogs.value = data.auditLogs || [];
                        } else {
                            showToast('Không thể tải lịch sử phiên bản', 'error');
                        }
                    } catch (e) {
                        showToast('Lỗi kết nối máy chủ', 'error');
                    } finally {
                        loadingAuditLogs.value = false;
                    }
                }

                function formatDate(isoStr) {
                    if (!isoStr) return '';
                    const d = new Date(isoStr);
                    return d.toLocaleString('vi-VN');
                }

                function getStudentDeductionHistory(studentId) {
                    if (!studentId) return [];
                    return classAuditLogs.value.filter(log => {
                        const isStudentEntity = (log.entityType === 'student' && Number(log.entityId) === Number(studentId));
                        const isDeductAction = log.action === 'DEDUCT_CONDUCT_SCORE' || log.action === 'UPDATE_STUDENT';
                        const hasScoreDecrease = log.diffs && log.diffs.some(d => d.field === 'conductScore' || d.field === 'conductDeductionReason');
                        return isStudentEntity && (isDeductAction || hasScoreDecrease);
                    });
                }

                const chatMessages = ref([
                    {
                        role: 'assistant',
                        text: 'Xin chào! Tôi là Gemini AI Chatbot. Bạn có thể yêu cầu tôi thêm học sinh, cập nhật hoặc tạo lớp học.'
                    }
                ]);

                const toast = ref({ show: false, message: '', type: 'success' });
                function showToast(msg, type = 'success') {
                    toast.value = { show: true, message: msg, type };
                    setTimeout(() => { toast.value.show = false; }, 3500);
                }

                function getTokenHeader() {
                    try {
                        const tok = getAuthToken();
                        return tok ? { 'Authorization': `Bearer ${tok}` } : {};
                    } catch {
                        return {};
                    }
                }

                const userPermission = ref({ canWrite: true, isOwner: true });

                const displayName = computed(() => user.value?.name || 'Tổ chức');
                const modifiedCount = computed(() => students.value.filter(s => s.isModified || s.isNew).length);

                const filteredStudents = computed(() => {
                    if (!searchQuery.value.trim()) return students.value;
                    const q = searchQuery.value.toLowerCase().trim();
                    return students.value.filter(s =>
                        (s.name && s.name.toLowerCase().includes(q)) ||
                        (s.studentCode && s.studentCode.toLowerCase().includes(q)) ||
                        (s.phone && s.phone.includes(q)) ||
                        (s.email && s.email.toLowerCase().includes(q))
                    );
                });

                function getClassIdFromUrl() {
                    const parts = window.location.pathname.split('/');
                    const id = parts[parts.length - 1];
                    return (id && !isNaN(Number(id))) ? Number(id) : 1;
                }

                const classAuditLogs = ref([]);

                async function fetchStudents() {
                    loading.value = true;
                    const classId = getClassIdFromUrl();
                    try {
                        const headers = getTokenHeader();
                        const [dashRes, stdRes, auditRes] = await Promise.all([
                            fetch('/api/organization/dashboard', { headers }),
                            fetch(`/api/organization/classes/${classId}/students`, { headers }),
                            fetch(`/api/organization/audit-logs?classId=${classId}`, { headers })
                        ]);

                        if (dashRes.ok) {
                            const dashData = await dashRes.json();
                            user.value = dashData.user;
                            debugMode.value = Boolean(dashData.debugMode);
                            currentClass.value = (dashData.classes || []).find(c => c.id === classId) || { id: classId, name: `Lớp #${classId}` };
                        }

                        if (stdRes.ok) {
                            const stdData = await stdRes.json();
                            students.value = (stdData.students || []).map(s => ({
                                ...s,
                                isModified: false,
                                isNew: false
                            }));
                            if (stdData.userPermission) {
                                userPermission.value = stdData.userPermission;
                            }
                        }

                        if (auditRes.ok) {
                            const auditData = await auditRes.json();
                            classAuditLogs.value = auditData.auditLogs || [];
                        }
                    } catch (e) {
                        showToast('Lỗi tải bảng tính Excel', 'error');
                    } finally {
                        loading.value = false;
                    }
                }

                function markModified(row) {
                    if (!userPermission.value.canWrite) return;
                    row.isModified = true;
                }

                function addNewRow() {
                    if (!userPermission.value.isOwner) {
                        showToast('Chỉ Người sở hữu Tổ chức mới có quyền thêm học sinh mới!', 'error');
                        return;
                    }

                    students.value.push({
                        tempId: Date.now(),
                        studentCode: `HS${Math.floor(1000 + Math.random() * 9000)}`,
                        name: '',
                        dateOfBirth: '',
                        phone: '',
                        email: '',
                        parentPhone: '',
                        parentEmail: '',
                        conductScore: 100,
                        conductDeductionReason: '',
                        isModified: true,
                        isNew: true
                    });
                }

                async function deleteRow(index, row) {
                    if (!userPermission.value.isOwner) {
                        showToast('Chỉ Người sở hữu Tổ chức mới có quyền xóa học sinh!', 'error');
                        return;
                    }

                    if (row.isNew) {
                        students.value.splice(index, 1);
                        return;
                    }

                    if (!confirm(`Bạn có chắc muốn xóa học sinh "${row.name || row.studentCode}" khỏi bảng tính?`)) return;

                    try {
                        const headers = getTokenHeader();
                        const res = await fetch(`/api/organization/students/${row.id}`, {
                            method: 'DELETE',
                            headers
                        });

                        if (res.ok) {
                            students.value.splice(index, 1);
                            showToast('Đã xóa học sinh khỏi bảng tính');
                        } else {
                            showToast('Không thể xóa học sinh', 'error');
                        }
                    } catch (e) {
                        showToast('Lỗi kết nối máy chủ', 'error');
                    }
                }

                async function saveAllChanges() {
                    if (!userPermission.value.canWrite) {
                        showToast('Tài khoản của bạn không có quyền lưu thay đổi ở lớp này!', 'error');
                        return;
                    }

                    const modifiedRows = students.value.filter(s => s.isModified || s.isNew);
                    if (modifiedRows.length === 0) {
                        showToast('Không có thay đổi nào cần lưu!');
                        return;
                    }

                    const invalidRow = modifiedRows.find(s => !s.name || !s.name.trim());
                    if (invalidRow) {
                        showToast('Vui lòng nhập Họ và Tên cho tất cả học sinh được chỉnh sửa!', 'error');
                        return;
                    }

                    saving.value = true;
                    const classId = getClassIdFromUrl();

                    try {
                        const headers = { ...getTokenHeader(), 'Content-Type': 'application/json' };
                        let successCount = 0;

                        for (const row of modifiedRows) {
                            if (!row.name || !row.name.trim()) continue;

                            if (row.isNew) {
                                // Create new student
                                const res = await fetch('/api/organization/students', {
                                    method: 'POST',
                                    headers,
                                    body: JSON.stringify({
                                        classId,
                                        studentCode: row.studentCode,
                                        name: row.name,
                                        dateOfBirth: row.dateOfBirth,
                                        phone: row.phone,
                                        email: row.email,
                                        parentPhone: row.parentPhone,
                                        parentEmail: row.parentEmail,
                                        conductScore: row.conductScore,
                                        conductDeductionReason: row.conductDeductionReason
                                    })
                                });
                                if (res.ok) successCount++;
                            } else {
                                // Update existing student: If non-owner, send only conductScore & conductDeductionReason to avoid 403
                                const payload = userPermission.value.isOwner
                                    ? row
                                    : { conductScore: row.conductScore, conductDeductionReason: row.conductDeductionReason };

                                const res = await fetch(`/api/organization/students/${row.id}`, {
                                    method: 'PUT',
                                    headers,
                                    body: JSON.stringify(payload)
                                });
                                if (res.ok) successCount++;
                            }
                        }

                        showToast(`Đã lưu thành công ${successCount} học sinh!`);
                        await fetchStudents();
                    } catch (e) {
                        showToast('Lỗi khi lưu dữ liệu lên máy chủ', 'error');
                    } finally {
                        saving.value = false;
                    }
                }

                function exportCsv() {
                    if (students.value.length === 0) {
                        showToast('Không có dữ liệu để xuất CSV!', 'error');
                        return;
                    }

                    let csvContent = "data:text/csv;charset=utf-8,STT,Mã Học Sinh,Họ và Tên,Ngày Sinh,SĐT Học Sinh,Email Học Sinh,SĐT Phụ Huynh,Email Phụ Huynh,Điểm Hạnh Kiểm\n";

                    students.value.forEach((st, idx) => {
                        const row = [
                            idx + 1,
                            st.studentCode || '',
                            `"${st.name || ''}"`,
                            st.dateOfBirth || '',
                            st.phone || '',
                            st.email || '',
                            st.parentPhone || '',
                            st.parentEmail || '',
                            st.conductScore ?? 100
                        ].join(",");
                        csvContent += row + "\n";
                    });

                    const encodedUri = encodeURI(csvContent);
                    const link = document.createElement("a");
                    link.setAttribute("href", encodedUri);
                    link.setAttribute("download", `Danh_Sach_Hoc_Sinh_Lop_${currentClass.value?.name || 'Class'}.csv`);
                    document.body.appendChild(link);
                    link.click();
                    document.body.removeChild(link);
                }

                // Gemini Chatbot Integration
                function onAiFileSelected(event) {
                    const file = event.target.files[0];
                    if (!file) return;
                    if (file.size > 5 * 1024 * 1024) {
                        showToast('Dung lượng file quá lớn (tối đa 5MB)', 'error');
                        event.target.value = '';
                        return;
                    }
                    aiAttachedFile.value = file;
                }

                function removeAiFile() {
                    aiAttachedFile.value = null;
                }

                function readFileAsBase64(file) {
                    return new Promise((resolve, reject) => {
                        const reader = new FileReader();
                        reader.onload = () => resolve(reader.result.split(',')[1]);
                        reader.onerror = error => reject(error);
                        reader.readAsDataURL(file);
                    });
                }

                async function sendChatMessage() {
                    const promptText = aiPrompt.value.trim();
                    if (!promptText && !aiAttachedFile.value) return;

                    let fileData = null;
                    if (aiAttachedFile.value) {
                        const base64Data = await readFileAsBase64(aiAttachedFile.value);
                        fileData = {
                            mimeType: aiAttachedFile.value.type,
                            data: base64Data
                        };
                    }

                    chatMessages.value.push({ 
                        role: 'user', 
                        text: promptText,
                        fileName: aiAttachedFile.value ? aiAttachedFile.value.name : null
                    });

                    aiPrompt.value = '';
                    aiAttachedFile.value = null;
                    parsingAi.value = true;

                    try {
                        const headers = { ...getTokenHeader(), 'Content-Type': 'application/json' };
                        const res = await fetch('/api/ai/parse-intent', {
                            method: 'POST',
                            headers,
                            body: JSON.stringify({ prompt: promptText, classId: getClassIdFromUrl(), fileData })
                        });

                        const data = await res.json();
                        if (res.ok) {
                            if (data.debugMode !== undefined) debugMode.value = Boolean(data.debugMode);
                            isGeminiPowered.value = Boolean(data.isGeminiPowered);
                            const hasCode = Boolean(data.code && data.code.trim());
                            const hasActions = (Array.isArray(data.actions) && data.actions.length > 0) || hasCode;

                            chatMessages.value.push({
                                role: 'assistant',
                                text: data.reply || data.summary || 'Đã phân tích yêu cầu của bạn.',
                                hasActions,
                                actionsCount: (data.actions && data.actions.length) || (hasCode ? 1 : 0),
                                plan: data
                            });

                            if (hasActions) {
                                proposedPlan.value = data;
                                showAiPreviewModal.value = true;
                            }
                        } else {
                            chatMessages.value.push({
                                role: 'assistant',
                                text: data.message || 'Lỗi xử lý câu lệnh AI.'
                            });
                        }
                    } catch (e) {
                        chatMessages.value.push({
                            role: 'assistant',
                            text: 'Lỗi kết nối tới máy chủ Gemini AI.'
                        });
                    } finally {
                        parsingAi.value = false;
                    }
                }

                function openPreviewFromChat(msg) {
                    if (msg.plan) {
                        proposedPlan.value = msg.plan;
                        showAiPreviewModal.value = true;
                    }
                }

                async function confirmExecuteServerPlan() {
                    const hasActions = (proposedPlan.value.actions && proposedPlan.value.actions.length > 0);
                    const hasCode = Boolean(proposedPlan.value.code && proposedPlan.value.code.trim());
                    if (!hasActions && !hasCode) return;

                    executingAi.value = true;
                    try {
                        const headers = { ...getTokenHeader(), 'Content-Type': 'application/json' };
                        const res = await fetch('/api/ai/execute-plan', {
                            method: 'POST',
                            headers,
                            body: JSON.stringify({
                                planActions: proposedPlan.value.actions || [],
                                code: proposedPlan.value.code || null,
                                classId: getClassIdFromUrl()
                            })
                        });

                        const data = await res.json();
                        if (res.ok) {
                            showToast('Server AI đã thực thi kịch bản thành công!');
                            showAiPreviewModal.value = false;
                            await fetchStudents();
                        } else {
                            showToast(data.message || 'Server thực thi kịch bản thất bại', 'error');
                        }
                    } catch (e) {
                        showToast('Lỗi kết nối máy chủ AI', 'error');
                    } finally {
                        executingAi.value = false;
                    }
                }

                onMounted(() => {
                    fetchStudents();
                });

                return {
                    user,
                    userPermission,
                    loading,
                    saving,
                    currentClass,
                    students,
                    searchQuery,
                    filteredStudents,
                    toast,
                    displayName,
                    modifiedCount,
                    debugMode,
                    showAiDrawer,
                    showAiPreviewModal,
                    aiPrompt,
                    aiAttachedFile,
                    parsingAi,
                    executingAi,
                    isGeminiPowered,
                    chatMessages,
                    proposedPlan,
                    sendChatMessage,
                    openPreviewFromChat,
                    confirmExecuteServerPlan,
                    fetchStudents,
                    markModified,
                    addNewRow,
                    deleteRow,
                    saveAllChanges,
                    exportCsv,
                    showAuditLogsModal,
                    auditLogs,
                    loadingAuditLogs,
                    openAuditLogsModal,
                    formatDate,
                    showDeductModal,
                    targetDeductStudent,
                    deductPoints,
                    deductReason,
                    openDeductModal,
                    confirmDeduction,
                    classAuditLogs,
                    getStudentDeductionHistory,
                    onAiFileSelected,
                    removeAiFile
                };
            }
        }).mount('#app');
    </script>
</body>

</html>
