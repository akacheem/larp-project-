                                    <div v-else class="font-semibold text-sm" :class="item.finalScore >= 90 ? 'text-[#15803d]' : item.finalScore >= 80 ? 'text-[#0071e3]' : item.finalScore >= 70 ? 'text-[#d97706]' : 'text-[#b91c1c]'">
