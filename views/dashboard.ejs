                            <i data-lucide="file-text" class="w-3.5 h-3.5 text-[#0071e3]"></i>
                            <span class="text-xs text-[#1d1d1f] truncate">{{ aiAttachedFile.name }}</span>
                            <span class="text-[10px] text-[#86868b]">({{ (aiAttachedFile.size / 1024).toFixed(1) }} KB)</span>
                        </div>
                        <button @click="removeAiFile" type="button" class="text-[#86868b] hover:text-[#ff3b30] transition p-1">
                            <i data-lucide="x" class="w-3.5 h-3.5"></i>
                        </button>
                    </div>

                    <form @submit.prevent="sendChatMessage" class="flex items-center space-x-2">
                        <button type="button" @click="$refs.aiFileInput.click()" :disabled="parsingAi" class="w-9 h-9 rounded-full bg-[#f5f5f7] hover:bg-black/[0.08] text-[#1d1d1f] flex items-center justify-center text-xs transition border border-black/[0.06]" title="Đính kèm file">
                            <i data-lucide="paperclip" class="w-4 h-4"></i>
                        </button>
