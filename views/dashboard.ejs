                                <input v-model="inviteForm.email" type="email" placeholder="nhap.email@example.com" required class="w-full px-5 py-2.5 bg-[#f5f5f7] border border-black/[0.08] rounded-full text-[#1d1d1f] text-xs focus:bg-white focus:border-[#0071e3] focus:ring-2 focus:ring-[#0071e3]/20 transition outline-none">
                            </div>
                            <div>
                                <button type="submit" :disabled="submittingInvite" class="w-full px-5 py-2.5 bg-[#0071e3] hover:bg-[#0077ed] text-white font-medium rounded-full transition text-xs flex items-center justify-center space-x-2 shadow-sm active:scale-[0.98]">
                                    <i v-if="submittingInvite" data-lucide="loader-2" class="w-3.5 h-3.5 animate-spin"></i>
                                    <i v-else data-lucide="send" class="w-3.5 h-3.5"></i>
                                    <span>Gửi lời mời</span>
                                </button>
                            </div>
                        </form>
