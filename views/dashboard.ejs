                        </div>

                        <div v-else class="space-y-3.5">
                            <div v-for="m in members" :key="m.id" class="p-5 bg-white border border-black/[0.06] rounded-3xl shadow-[0_2px_8px_rgba(0,0,0,0.02)] space-y-3.5 transition">
                                <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-2 border-b border-black/[0.05] pb-3">
                                    <div>
                                        <h4 class="font-semibold text-[#1d1d1f] text-sm flex items-center gap-2">
                                            <span>{{ m.userName }}</span>
                                            <span class="text-xs font-normal text-[#86868b]">({{ m.userEmail }})</span>
                                        </h4>
                                        <p class="text-[11px] text-[#86868b] mt-0.5">Tài khoản cá nhân thuộc tổ chức</p>
                                    </div>
                                    <div class="flex items-center space-x-2">
                                        <button @click="removeMember(m.id)" class="px-3.5 py-1.5 text-xs font-medium bg-[#ff3b30]/10 hover:bg-[#ff3b30]/20 text-[#ff3b30] rounded-full transition border border-[#ff3b30]/20 active:scale-[0.98] flex items-center">
                                            <i data-lucide="trash-2" class="w-3 h-3 mr-1 inline"></i>Xóa khỏi tổ chức
                                        </button>
                                    </div>
                                </div>

                                <!-- Class Write Permissions Selection -->
                                <div class="space-y-2">
                                    <label class="block text-xs font-medium text-[#1d1d1f] flex items-center">
                                        <i data-lucide="edit-3" class="w-3.5 h-3.5 text-[#0071e3] mr-1 inline"></i>
