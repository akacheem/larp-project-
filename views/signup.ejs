<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Đăng ký tài khoản - EduManager</title>
    <!-- Tailwind CSS & Icons -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/public/style.css">
</head>

<body class="min-h-screen flex items-center justify-center p-6">
    <div class="glass-card w-full max-w-md rounded-2xl p-8 border border-slate-800 space-y-6 shadow-2xl">
        <!-- Logo & Title -->
        <div class="text-center space-y-2">
            <div class="w-12 h-12 rounded-xl gradient-bg flex items-center justify-center text-white mx-auto shadow-lg shadow-sky-500/20 text-xl font-bold">
                <i class="fa-solid fa-user-plus"></i>
            </div>
            <h2 class="text-2xl font-bold gradient-text">Đăng ký tài khoản</h2>
            <p class="text-xs text-slate-400">Tạo tài khoản mới để trải nghiệm EduManager</p>
        </div>

        <!-- Form -->
        <form class="space-y-4" onsubmit="return false;">
            <div>
                <label for="username" class="block text-xs font-semibold text-slate-300 mb-1.5">Họ và Tên / Tên Tổ chức</label>
                <div class="relative">
                    <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-slate-500 text-sm">
                        <i class="fa-solid fa-user"></i>
                    </span>
                    <input type="text" id="username" name="username" required placeholder="Nguyễn Văn A" class="w-full pl-10 pr-4 py-2.5 bg-slate-900 border border-slate-700 rounded-xl text-slate-200 text-sm focus:outline-none focus:border-sky-500 transition">
                </div>
            </div>

            <div>
                <label for="email" class="block text-xs font-semibold text-slate-300 mb-1.5">Địa chỉ Email</label>
                <div class="relative">
                    <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-slate-500 text-sm">
                        <i class="fa-solid fa-envelope"></i>
                    </span>
                    <input type="email" id="email" name="email" required placeholder="yourname@example.com" class="w-full pl-10 pr-4 py-2.5 bg-slate-900 border border-slate-700 rounded-xl text-slate-200 text-sm focus:outline-none focus:border-sky-500 transition">
                </div>
            </div>

            <div>
                <label for="password" class="block text-xs font-semibold text-slate-300 mb-1.5">Mật khẩu</label>
                <div class="relative">
                    <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-slate-500 text-sm">
                        <i class="fa-solid fa-lock"></i>
                    </span>
                    <input type="password" id="password" name="password" required minlength="8" placeholder="Tối thiểu 8 ký tự" class="w-full pl-10 pr-4 py-2.5 bg-slate-900 border border-slate-700 rounded-xl text-slate-200 text-sm focus:outline-none focus:border-sky-500 transition">
                </div>
            </div>

            <div>
                <label for="confirm-password" class="block text-xs font-semibold text-slate-300 mb-1.5">Xác nhận mật khẩu</label>
                <div class="relative">
                    <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-slate-500 text-sm">
                        <i class="fa-solid fa-shield-check"></i>
                    </span>
                    <input type="password" id="confirm-password" name="confirm_password" required placeholder="Nhập lại mật khẩu" class="w-full pl-10 pr-4 py-2.5 bg-slate-900 border border-slate-700 rounded-xl text-slate-200 text-sm focus:outline-none focus:border-sky-500 transition">
                </div>
            </div>

            <div class="pt-2">
                <label class="flex items-center space-x-3 p-3 bg-slate-900/80 rounded-xl border border-slate-700/80 cursor-pointer hover:border-sky-500/50 transition">
                    <input type="checkbox" id="isOrganization" name="isOrganization" class="w-4 h-4 text-sky-500 rounded bg-slate-800 border-slate-600 focus:ring-sky-500">
                    <div class="text-xs">
                        <span class="font-bold text-slate-200 block">Đăng ký làm Tài khoản Tổ chức</span>
                        <span class="text-slate-400">Cho phép tạo lớp học, đợt niên khóa và mời thành viên</span>
                    </div>
                </label>
            </div>

            <button id="submit-btn" type="submit" class="w-full py-3 gradient-bg hover:opacity-90 text-white font-semibold rounded-xl text-sm transition shadow-lg shadow-sky-600/30 flex items-center justify-center space-x-2 mt-4">
                <span>Tạo tài khoản</span>
                <i class="fa-solid fa-arrow-right"></i>
            </button>
        </form>

        <!-- Footer link -->
        <div class="text-center pt-4 border-t border-slate-800 text-xs text-slate-400">
            Đã có tài khoản?
            <a href="/login" class="text-sky-400 hover:text-sky-300 font-semibold ml-1 transition">Đăng nhập ngay</a>
        </div>
    </div>

    <script src="/public/signup.js" type="module"></script>
</body>

</html>