<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Đăng ký tài khoản — EduManager</title>
    <!-- Tailwind CSS & Lucide Icons -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <script src="/public/lucide-safe.js"></script>
    <link rel="stylesheet" href="/public/style.css">
</head>

<body class="min-h-screen bg-[#f5f5f7] text-[#1d1d1f] flex flex-col items-center justify-center p-6 antialiased selection:bg-[#0071e3] selection:text-white">

    <!-- Top Minimal Navigation -->
    <div class="fixed top-6 left-6">
        <a href="/" class="flex items-center space-x-2 text-xs font-medium text-[#86868b] hover:text-[#1d1d1f] transition px-3.5 py-1.5 rounded-full bg-black/[0.03] hover:bg-black/[0.06] border border-black/[0.04]">
            <i data-lucide="chevron-left" class="w-3.5 h-3.5"></i>
            <span>Trang chủ</span>
        </a>
    </div>

    <div class="w-full max-w-md bg-white rounded-[36px] p-8 sm:p-10 border border-black/[0.06] shadow-[0_12px_40px_rgba(0,0,0,0.04)] space-y-6 my-8">
        <!-- Logo & Title -->
        <div class="text-center space-y-2.5">
            <div class="w-14 h-14 rounded-full bg-[#1d1d1f] text-white flex items-center justify-center mx-auto shadow-sm">
                <i data-lucide="user-plus" class="w-6 h-6 stroke-[1.75]"></i>
            </div>
            <h2 class="text-2xl font-semibold tracking-tight text-[#1d1d1f]">Tạo tài khoản mới</h2>
            <p class="text-xs text-[#86868b]">Trải nghiệm nền tảng quản trị giáo dục chuẩn mực</p>
        </div>

        <!-- Form -->
        <form class="space-y-4" onsubmit="return false;">
            <div class="space-y-1.5">
                <label for="username" class="block text-xs font-medium text-[#86868b] pl-2">Họ và Tên / Tên Tổ chức</label>
                <input type="text" id="username" name="username" required placeholder="Nguyễn Văn A" class="w-full px-5 py-2.5 bg-[#f5f5f7] border border-[#d2d2d7] rounded-full text-[#1d1d1f] text-sm placeholder-[#aeaeb2] focus:outline-none focus:border-[#0071e3] focus:bg-white focus:ring-2 focus:ring-[#0071e3]/20 transition duration-150">
            </div>

            <div class="space-y-1.5">
                <label for="email" class="block text-xs font-medium text-[#86868b] pl-2">Địa chỉ Email</label>
                <input type="email" id="email" name="email" required placeholder="name@example.com" class="w-full px-5 py-2.5 bg-[#f5f5f7] border border-[#d2d2d7] rounded-full text-[#1d1d1f] text-sm placeholder-[#aeaeb2] focus:outline-none focus:border-[#0071e3] focus:bg-white focus:ring-2 focus:ring-[#0071e3]/20 transition duration-150">
            </div>

            <div class="space-y-1.5">
                <label for="password" class="block text-xs font-medium text-[#86868b] pl-2">Mật khẩu</label>
                <input type="password" id="password" name="password" required minlength="8" placeholder="Tối thiểu 8 ký tự" class="w-full px-5 py-2.5 bg-[#f5f5f7] border border-[#d2d2d7] rounded-full text-[#1d1d1f] text-sm placeholder-[#aeaeb2] focus:outline-none focus:border-[#0071e3] focus:bg-white focus:ring-2 focus:ring-[#0071e3]/20 transition duration-150">
            </div>

            <div class="space-y-1.5">
                <label for="confirm-password" class="block text-xs font-medium text-[#86868b] pl-2">Xác nhận mật khẩu</label>
                <input type="password" id="confirm-password" name="confirm_password" required placeholder="Nhập lại mật khẩu" class="w-full px-5 py-2.5 bg-[#f5f5f7] border border-[#d2d2d7] rounded-full text-[#1d1d1f] text-sm placeholder-[#aeaeb2] focus:outline-none focus:border-[#0071e3] focus:bg-white focus:ring-2 focus:ring-[#0071e3]/20 transition duration-150">
            </div>

            <!-- Apple-styled Configurator Radio/Checkbox Card -->
            <div class="pt-1">
                <label class="flex items-start space-x-3 p-4 bg-[#f5f5f7] rounded-2xl border border-[#d2d2d7] cursor-pointer hover:border-[#0071e3] transition duration-150">
                    <input type="checkbox" id="isOrganization" name="isOrganization" class="mt-0.5 w-4 h-4 text-[#0071e3] rounded-full border-[#d2d2d7] focus:ring-[#0071e3]">
                    <div class="text-xs">
                        <span class="font-semibold text-[#1d1d1f] block">Đăng ký làm Tài khoản Tổ chức</span>
                        <span class="text-[#86868b] leading-relaxed">Cho phép tạo lớp học, đợt niên khóa và mời thành viên phân quyền</span>
                    </div>
                </label>
            </div>

            <button id="submit-btn" type="submit" class="w-full py-2.5 px-5 bg-[#0071e3] hover:bg-[#0077ed] active:scale-[0.98] text-white font-medium rounded-full text-sm transition-all duration-150 shadow-sm flex items-center justify-center space-x-2 mt-2">
                <span>Tạo tài khoản</span>
                <i data-lucide="arrow-right" class="w-4 h-4"></i>
            </button>
        </form>

        <!-- Footer link -->
        <div class="text-center pt-4 border-t border-black/[0.06] text-xs text-[#86868b]">
            Đã có tài khoản?
            <a href="/login" class="text-[#0071e3] hover:underline font-medium ml-1">Đăng nhập ngay</a>
        </div>
    </div>

    <script src="/public/signup.js" type="module"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            if (window.lucide) window.lucide.createIcons();
        });
    </script>
</body>

</html>