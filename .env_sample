# Cổng chạy ứng dụng (Render/Railway sẽ tự động cung cấp biến PORT này)
PORT=8000

# KẾT NỐI DATABASE:
# 1. Chạy Local trên máy:
# DATABASE_URL=file:./database.db
#
# 2. Chạy Cloud qua Turso (Cách 2):
# DATABASE_URL=libsql://[your-db-name]-[org-name].turso.io
# TURSO_AUTH_TOKEN=your_turso_auth_token_here
DATABASE_URL=file:./database.db
TURSO_AUTH_TOKEN=

# Khóa bí mật JWT & Cookie (Tạo chuỗi ngẫu nhiên dài, không dùng từ khóa mặc định)
JWT_SECRET=super_secret_jwt_key_random_string_32_chars
COOKIE_SECRET=super_secret_cookie_key_random_string_32_chars

# Khóa Google Gemini AI API
GEMINI_API_KEY=your_gemini_api_key_here

# Chế độ Debug (Đặt false khi deploy cho giáo viên dùng)
DEBUG_MODE=false